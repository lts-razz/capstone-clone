---
import { resolveWoodberryPhotoSrc, woodberryPhotos } from '../../data/woodberryPhotos';

type PackageSpace = {
  id: string;
  name: string;
  description: string | null;
  capacity: number | null;
  image_url: string | null;
};

type PackageCardItem = {
  id?: string | null;
  type: string;
  name: string;
  description?: string | null;
  price: number;
  browsePrice?: number;
  duration: string;
  schedule: string;
  minPax: number;
  maxPax: number;
  inclusions: string[];
  pricingNote?: string;
  spaces?: PackageSpace[];
  venue?: PackageSpace | null;
  venues?: PackageSpace[];
  venueId?: string | null;
  thumbnailUrl?: string | null;
};

const { packageItem, authState = 'guest', authEmail = '' } = Astro.props as {
  packageItem: PackageCardItem;
  authState?: 'guest' | 'unverified' | 'verified' | 'internal';
  authEmail?: string;
};

const packageSlug = packageItem.id || packageItem.type;
const bookingUrl = `/events_and_booking/events/${packageSlug}`;
const packageName = packageItem.name || 'Woodberry package';
const spaces = (packageItem.spaces ?? []).filter((space) => space && space.name);
const includedVenues = (packageItem.venues ?? (packageItem.venue ? [packageItem.venue] : []))
  .filter((venue) => venue && venue.name);
const packageImage = resolveWoodberryPhotoSrc(packageItem.thumbnailUrl, woodberryPhotos.eventCardFallback);
const displayPrice = Number(packageItem.browsePrice ?? packageItem.price) || 0;
const requiresVerification = authState === 'unverified';
const description = packageItem.description?.trim()
  || `A Woodberry package for ${packageItem.minPax}-${packageItem.maxPax} guests, with ${packageItem.duration.toLowerCase()} use and resort spaces prepared for your gathering.`;
const shortDescription = description.length > 158
  ? `${description.slice(0, 155).trimEnd()}...`
  : description;
---

<div class="event-card wb-card wb-card--interactive overflow-hidden w-full h-full flex flex-col">
  <div class="event-card__media">
    <img
      src={packageImage}
      alt={`${packageName} at Woodberry Resorts and Events Place`}
      class="event-card__image"
      loading="lazy"
      decoding="async"
      data-photo-fallback={woodberryPhotos.eventCardFallback}
    />
    <span>Woodberry package</span>
  </div>

  <div class="event-card__body">
    <p class="event-card__eyebrow">Package Details</p>
    <h3 class="event-card__title">{packageName}</h3>

    <div class="event-card__details">
      <span>{packageItem.duration}</span>
      <span>{packageItem.minPax}-{packageItem.maxPax} guests</span>
    </div>

    <p class="event-card__description">{shortDescription}</p>

    <div class="event-card__price" data-card-price hidden={displayPrice <= 0}>
      <p class="event-card__price-label" data-card-price-label>
        {packageItem.browsePrice ? 'Starts from' : 'Base price'}
      </p>
      <p class="event-card__price-value">
        <span class="event-card__price-amount" data-card-price-amount>
          {new Intl.NumberFormat('en-PH', {
            style: 'currency',
            currency: 'PHP',
            maximumFractionDigits: 0,
          }).format(displayPrice)}
        </span>
      </p>
    </div>

    <div class="event-card__schedule">
      <strong>Schedule</strong>
      <span>{packageItem.schedule}</span>
    </div>

    <div class="event-card__spaces">
      <strong>{includedVenues.length === 1 ? 'Included Venue' : 'Included Venues'}</strong>
      {
        includedVenues.length > 0 ? (
          <ul>
            {includedVenues.slice(0, 3).map((venue) => (
              <li>
                <span>{venue.name}</span>
                {venue.capacity && <small>Up to {venue.capacity} guests</small>}
              </li>
            ))}
          </ul>
        ) : spaces.length > 0 ? (
          <ul>
            {spaces.slice(0, 3).map((space) => (
              <li>
                <span>{space.name}</span>
                {space.capacity && <small>Up to {space.capacity} guests</small>}
              </li>
            ))}
          </ul>
        ) : (
          <p>Venue assignment is being finalized.</p>
        )
      }
    </div>

    <div class="event-card__actions">
      <a href={bookingUrl} class="event-card__details-button">
        View Details
      </a>
      {
        authState === 'verified' ? (
          <a href={bookingUrl} class="event-card__book-button">
            Book Package
          </a>
        ) : authState !== 'internal' ? (
          <button
            type="button"
            class="event-card__book-button"
            data-auth-required-trigger
            data-auth-required-reason={requiresVerification ? 'unverified' : 'guest'}
            data-auth-email={authEmail}
            data-booking-name={packageName}
            data-booking-url={bookingUrl}
          >
            {requiresVerification ? 'Verify Email to Book' : 'Book Package'}
          </button>
        ) : null
      }
    </div>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLImageElement>('img[data-photo-fallback]').forEach((image) => {
    image.addEventListener('error', () => {
      const fallback = image.dataset.photoFallback;
      if (!fallback) return;
      const fallbackUrl = new URL(fallback, window.location.href).href;
      if (image.src !== fallbackUrl) image.src = fallback;
    });
  });
</script>

<style>
  .event-card {
    border-radius: var(--wb-radius-lg);
  }

  .event-card__image {
    width: 100%;
    height: 13rem;
    object-fit: cover;
  }

  .event-card__media {
    position: relative;
    overflow: hidden;
    background: var(--wb-green-soft);
  }

  .event-card__media span {
    position: absolute;
    right: 0.85rem;
    bottom: 0.85rem;
    border: 1px solid rgba(255, 255, 255, 0.28);
    border-radius: 999px;
    background: rgba(8, 20, 6, 0.74);
    color: #ffffff;
    font-size: 0.68rem;
    font-weight: 900;
    letter-spacing: 0.04em;
    padding: 0.38rem 0.65rem;
    text-transform: uppercase;
    backdrop-filter: blur(6px);
  }

  .event-card__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: clamp(1.1rem, 3vw, 1.5rem);
  }

  .event-card__eyebrow {
    margin: 0 0 0.35rem;
    color: var(--wb-green);
    font-size: 0.7rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .event-card__title {
    margin: 0;
    color: var(--wb-green-dark);
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1.25rem, 3vw, 1.55rem);
    letter-spacing: 0;
    line-height: 1.2;
  }

  .event-card__description {
    margin: 0.65rem 0 1rem;
    color: var(--wb-muted);
    font-size: 0.94rem;
    line-height: 1.6;
  }

  .event-card__details {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem 0.8rem;
    margin-top: 0.65rem;
    color: var(--wb-green-mid);
    font-size: 0.82rem;
    font-weight: 800;
  }

  .event-card__details span + span::before {
    content: "\2022";
    margin-right: 0.8rem;
    color: var(--wb-warm);
  }

  .event-card__price {
    margin-bottom: 0.75rem;
  }

  .event-card__price-label {
    margin: 0;
    color: var(--wb-muted);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .event-card__price-value {
    margin: 0.15rem 0 0;
    color: var(--wb-earth);
    font-size: 1.7rem;
    font-weight: 900;
    line-height: 1.1;
  }

  .event-card__schedule,
  .event-card__spaces {
    border-top: 1px solid var(--wb-border);
    padding-top: 0.8rem;
  }

  .event-card__schedule {
    display: grid;
    gap: 0.15rem;
    margin-bottom: 0.8rem;
  }

  .event-card__schedule strong,
  .event-card__spaces strong {
    color: var(--wb-green-dark);
    font-size: 0.82rem;
  }

  .event-card__schedule span,
  .event-card__spaces p {
    margin: 0;
    color: var(--wb-muted);
    font-size: 0.82rem;
    line-height: 1.45;
  }

  .event-card__spaces {
    flex: 1;
    margin-bottom: 1rem;
  }

  .event-card__spaces ul {
    display: grid;
    gap: 0.45rem;
    margin: 0.55rem 0 0;
    padding: 0;
    list-style: none;
  }

  .event-card__spaces li {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.35rem 0.75rem;
    border-radius: var(--wb-radius-sm);
    background: var(--wb-surface-soft);
    color: var(--wb-text);
    font-size: 0.82rem;
    padding: 0.55rem 0.65rem;
  }

  .event-card__spaces small {
    color: var(--wb-muted);
    font-size: 0.76rem;
    font-weight: 800;
  }

  .event-card__actions {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.65rem;
    margin-top: auto;
  }

  .event-card__book-button,
  .event-card__details-button {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--wb-green);
    border-radius: var(--wb-radius-sm);
    cursor: pointer;
    font-size: 0.86rem;
    font-weight: 900;
    line-height: 1.25;
    padding: 0.75rem 1rem;
    text-align: center;
    text-decoration: none;
    transition:
      background-color 0.2s ease,
      box-shadow 0.2s ease,
      transform 0.2s ease;
  }

  .event-card__book-button {
    background: var(--wb-action);
    box-shadow: 0 12px 22px rgba(21, 122, 69, 0.16);
    color: var(--wb-on-action);
  }

  .event-card__details-button {
    background: transparent;
    color: var(--wb-link);
  }

  .event-card__book-button:hover {
    background: var(--wb-action-hover);
    box-shadow: var(--wb-shadow-md);
    transform: translateY(-1px);
  }

  .event-card__details-button:hover {
    background: var(--wb-green-soft);
    color: var(--wb-green-dark);
    transform: translateY(-1px);
  }

  :global(html.dark) .event-card__book-button {
    background: var(--wb-action);
    color: var(--wb-on-action);
  }

  :global(html.dark) .event-card__book-button:hover {
    background: var(--wb-action-hover);
    color: var(--wb-on-action);
  }

  :global(html.dark) .event-card__details-button {
    color: var(--wb-link);
  }

  @media (min-width: 961px) {
    .event-card {
      border-radius: var(--wb-radius-md);
    }

    .event-card__image {
      height: 10rem;
    }

    .event-card__media span {
      right: 0.65rem;
      bottom: 0.65rem;
      padding: 0.32rem 0.55rem;
    }

    .event-card__body {
      padding: 1rem;
    }

    .event-card__title {
      font-size: clamp(1.18rem, 1.6vw, 1.38rem);
      line-height: 1.16;
    }

    .event-card__details {
      gap: 0.3rem 0.6rem;
      margin-top: 0.5rem;
    }

    .event-card__details span + span::before {
      margin-right: 0.6rem;
    }

    .event-card__description {
      margin: 0.55rem 0 0.8rem;
      font-size: 0.9rem;
      line-height: 1.55;
    }

    .event-card__price {
      margin-bottom: 0.6rem;
    }

    .event-card__price-value {
      font-size: 1.45rem;
    }

    .event-card__schedule,
    .event-card__spaces {
      padding-top: 0.65rem;
    }

    .event-card__schedule {
      margin-bottom: 0.65rem;
    }

    .event-card__spaces {
      margin-bottom: 0.8rem;
    }

    .event-card__spaces ul {
      gap: 0.35rem;
      margin-top: 0.42rem;
    }

    .event-card__spaces li {
      padding: 0.45rem 0.55rem;
    }

    .event-card__actions {
      gap: 0.5rem;
    }

    .event-card__book-button,
    .event-card__details-button {
      min-height: 2.45rem;
      font-size: 0.8rem;
      padding: 0.6rem 0.7rem;
    }
  }

  @media (max-width: 420px) {
    .event-card__actions {
      grid-template-columns: 1fr;
    }
  }
</style>
