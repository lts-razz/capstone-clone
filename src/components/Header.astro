---
import CalendarPreview from './calendarComps/calendarPreview.astro';
import Theme from './ThemeButton.astro';
import { getDashboardPathForRole, getUserRole } from '../lib/adminGuard';

const pathname = Astro.url.pathname;
const roleInfo = await getUserRole(Astro.cookies);
const user = roleInfo.role === 'none' ? null : roleInfo.user;
const showCustomerBookingActions = roleInfo.role === 'customer' || !roleInfo.user;
const dashboardHref = getDashboardPathForRole(roleInfo.role);
const dashboardLabel = roleInfo.role === 'admin'
  ? 'Admin'
  : roleInfo.role === 'staff'
    ? 'Staff'
    : 'Bookings';
const isSigninPage = pathname === '/signin' || pathname === '/forgot-password' || pathname === '/reset-password';
const isSignupPage = pathname === '/signup';

const primaryNavItems = [
  {
    href: '/',
    label: 'Home',
    active: pathname === '/',
  },
  {
    href: '/about',
    label: 'About',
    active: pathname === '/about',
  },
  {
    href: '/amenities',
    label: 'Amenities',
    active: pathname === '/amenities',
  },
  {
    href: '/accommodations',
    label: 'Accommodations',
    active: pathname === '/accommodations',
  },
  {
    href: '/events',
    label: 'Events',
    active: pathname === '/events',
  },
  {
    href: '/contact-us',
    label: 'Contact',
    active: pathname.startsWith('/contact-us'),
  },
];
---

<header id="navbar" class="site-header">
  <div class="site-header__bar">
    <a
      href="/"
      class="site-header__brand"
      aria-label="Woodberry Resorts and Events Place home"
    >
      <img
        src="/company-logo-clean.png"
        alt=""
        width="1331"
        height="784"
      />
    </a>

    <button
      id="mobileNavToggle"
      class="mobile-nav-toggle"
      type="button"
      aria-controls="siteNavigationPanel"
      aria-expanded="false"
      aria-label="Open navigation"
    >
      <svg class="mobile-nav-toggle__menu" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M4 7h16M4 12h16M4 17h16"></path>
      </svg>
      <svg class="mobile-nav-toggle__close" viewBox="0 0 24 24" aria-hidden="true">
        <path d="m6 6 12 12M18 6 6 18"></path>
      </svg>
    </button>

    <div id="siteNavigationPanel" class="site-header__panel">
      <nav class="site-nav site-nav--primary" aria-label="Primary navigation">
        {
          primaryNavItems.map((item) => (
            <a
              href={item.href}
              class:list={['site-nav__link', { 'is-active': item.active }]}
              aria-current={item.active ? 'page' : undefined}
            >
              {item.label}
            </a>
          ))
        }
        <a
          href="/events_and_booking/events"
          class="book-link"
          aria-current={pathname.startsWith('/events_and_booking') ? 'page' : undefined}
        >
          BOOK
        </a>
      </nav>

      <div class="site-header__actions">
        <div class="header-account-actions">
          {user ? (
            <>
              <a href={dashboardHref} class="header-action-link">
                {dashboardLabel}
              </a>
              <form method="POST" action="/api/auth/signout">
                <button type="submit" class="header-action-link header-action-link--logout">
                  Logout
                </button>
              </form>
            </>
          ) : (
            <>
              <a
                href="/signin"
                class:list={['header-action-link', { 'is-active': isSigninPage }]}
                aria-current={isSigninPage ? 'page' : undefined}
              >
                Login
              </a>
              <a
                href="/signup"
                class:list={['header-action-link', 'header-action-link--signup', { 'is-active': isSignupPage }]}
                aria-current={isSignupPage ? 'page' : undefined}
              >
                Sign Up
              </a>
            </>
          )}
        </div>

        <div class="header-utilities">
          <button
            id="preview"
            class="header-utility-button"
            type="button"
            aria-label="Check availability"
          >
            <svg id="previewIconCal" viewBox="0 0 24 24" aria-hidden="true">
              <rect x="3" y="4" width="18" height="17" rx="2"></rect>
              <path d="M3 10h18M8 2v4M16 2v4"></path>
            </svg>
            <svg
              id="previewIconX"
              viewBox="0 0 24 24"
              aria-hidden="true"
              style="display: none;"
            >
              <path d="m6 6 12 12M18 6 6 18"></path>
            </svg>
            <span id="previewText">Availability</span>
          </button>
          <div class="header-theme"><Theme /></div>
        </div>
      </div>
    </div>
  </div>
</header>

<CalendarPreview showBookingCta={showCustomerBookingActions} />

<script>
  function setupSiteHeader() {
    const header = document.getElementById('navbar');
    const toggle = document.getElementById('mobileNavToggle');
    const panel = document.getElementById('siteNavigationPanel');

    if (!header) return;

    if (!toggle || !panel || header.dataset.navigationReady) return;
    header.dataset.navigationReady = 'true';

    const setOpen = (open: boolean) => {
      header.classList.toggle('is-mobile-open', open);
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'Close navigation' : 'Open navigation');
      document.body.classList.toggle('mobile-navigation-open', open);
    };

    toggle.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });

    panel.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        setOpen(false);
      });
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        setOpen(false);
      }
    });

    window.addEventListener('resize', () => {
      if (window.innerWidth > 1120) {
        setOpen(false);
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupSiteHeader);
  } else {
    setupSiteHeader();
  }

  document.addEventListener('astro:page-load', setupSiteHeader);
</script>

<style>
  .site-header {
    position: relative;
    z-index: 100;
    width: 100%;
    max-width: 100vw;
    height: var(--site-header-height);
    border-bottom: 1px solid color-mix(in srgb, var(--wb-border) 78%, transparent);
    background: rgba(250, 247, 239, 0.95);
    box-shadow: 0 5px 24px rgba(18, 60, 36, 0.08);
    backdrop-filter: blur(18px);
  }

  .site-header__bar {
    display: grid;
    width: min(100% - 2rem, 90rem);
    height: 100%;
    align-items: center;
    gap: clamp(1rem, 2.4vw, 2.5rem);
    grid-template-columns: auto minmax(0, 1fr) auto;
    margin: 0 auto;
  }

  .site-header__brand {
    --header-logo-top-scale: 1.7;
    --header-logo-hover-scale: 1.78;
    --header-logo-base-height: 68px;
    --header-logo-visual-width: 197px;
    --header-logo-side-space: clamp(0.95rem, 1.8vw, 1.8rem);
    --header-logo-bleed: max(1rem, calc((100vw - 90rem) / 2));

    position: relative;
    display: flex;
    width: calc(var(--header-logo-visual-width) + var(--header-logo-side-space));
    height: 100%;
    align-items: center;
    justify-content: flex-start;
    grid-column: 1;
    grid-row: 1;
    isolation: isolate;
    text-decoration: none;
  }

  .site-header__brand::before {
    position: absolute;
    z-index: -1;
    top: 0.35rem;
    bottom: -1.6rem;
    left: calc(var(--header-logo-bleed) * -1);
    width: calc(
      var(--header-logo-bleed) + var(--header-logo-visual-width) + var(--header-logo-side-space) + clamp(0.9rem, 1.2vw, 1.4rem)
    );
    border: 1px solid color-mix(in srgb, var(--wb-border) 76%, var(--wb-warm));
    border-top-color: color-mix(in srgb, var(--wb-warm-soft) 85%, transparent);
    border-left-color: color-mix(in srgb, var(--wb-warm-soft) 80%, transparent);
    border-radius: 0 0 clamp(1.4rem, 2.6vw, 2.35rem) 0;
    background:
      linear-gradient(105deg, rgba(250, 247, 239, 0.98), rgba(238, 229, 215, 0.94) 72%),
      var(--wb-warm-soft);
    box-shadow:
      0 15px 30px rgba(18, 60, 36, 0.13),
      inset -1px -1px 0 color-mix(in srgb, var(--wb-green-pale) 42%, transparent);
    content: '';
    pointer-events: none;
    transition:
      box-shadow 260ms ease,
      filter 260ms ease,
      transform 260ms ease;
  }

  .site-header__brand img {
    position: relative;
    display: block;
    width: auto;
    height: var(--header-logo-base-height);
    margin-left: calc(var(--header-logo-side-space) / 2);
    max-width: none;
    object-fit: contain;
    background: transparent !important;
    transform: scale(var(--header-logo-top-scale));
    transform-origin: left center;
    transition:
      filter 260ms ease,
      transform 260ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .site-header__brand:is(:hover, :focus-visible)::before {
    box-shadow:
      0 18px 38px rgba(18, 60, 36, 0.18),
      0 0 28px color-mix(in srgb, var(--wb-warm) 28%, transparent),
      inset -1px -1px 0 color-mix(in srgb, var(--wb-green-pale) 48%, transparent);
    filter: saturate(1.04);
  }

  .site-header__brand:is(:hover, :focus-visible) img {
    filter:
      drop-shadow(0 9px 18px rgba(18, 60, 36, 0.24))
      drop-shadow(0 0 14px color-mix(in srgb, var(--wb-warm) 32%, transparent));
    transform: scale(var(--header-logo-hover-scale));
  }

  .site-header__brand:focus-visible,
  .site-nav__link:focus-visible,
  .book-link:focus-visible,
  .header-action-link:focus-visible,
  .header-utility-button:focus-visible,
  .mobile-nav-toggle:focus-visible {
    outline: 3px solid var(--wb-focus-ring);
    outline-offset: 3px;
  }

  .site-header__panel {
    display: contents;
  }

  .site-nav {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: clamp(0.1rem, 0.5vw, 0.45rem);
  }

  .site-nav--primary {
    justify-self: start;
    grid-column: 2;
    grid-row: 1;
  }

  .site-nav__link {
    position: relative;
    display: inline-flex;
    min-height: 2.65rem;
    align-items: center;
    border-radius: 999px;
    color: var(--wb-text);
    font-size: clamp(0.76rem, 0.85vw, 0.86rem);
    font-weight: 750;
    padding: 0.55rem clamp(0.55rem, 0.85vw, 0.82rem);
    text-decoration: none;
    white-space: nowrap;
    transition:
      background-color 0.2s ease,
      color 0.2s ease;
  }

  .site-nav__link:hover,
  .site-nav__link.is-active {
    background: var(--wb-green-soft);
    color: var(--wb-link);
  }

  .site-nav__link.is-active::after {
    position: absolute;
    right: 0.8rem;
    bottom: 0.24rem;
    left: 0.8rem;
    height: 2px;
    border-radius: 999px;
    background: var(--wb-warm);
    content: '';
  }

  .site-header__actions {
    display: flex;
    min-width: 0;
    align-items: center;
    justify-self: end;
    gap: clamp(0.35rem, 0.6vw, 0.6rem);
    grid-column: 3;
    grid-row: 1;
  }

  .book-link {
    display: inline-flex;
    min-height: 2.65rem;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--wb-action);
    border-radius: 999px;
    background: var(--wb-action);
    box-shadow: 0 7px 16px rgba(31, 107, 67, 0.16);
    color: var(--wb-on-action);
    font-size: 0.8rem;
    font-weight: 800;
    padding: 0.6rem 0.95rem;
    text-decoration: none;
    white-space: nowrap;
    transition:
      background-color 0.2s ease,
      box-shadow 0.2s ease,
      transform 0.2s ease;
  }

  .book-link:hover {
    background: var(--wb-action-hover);
    box-shadow: 0 9px 20px rgba(31, 107, 67, 0.2);
    transform: translateY(-1px);
  }

  .header-account-actions,
  .header-utilities {
    display: flex;
    align-items: center;
    gap: 0.3rem;
  }

  .header-account-actions form {
    display: flex;
    margin: 0;
  }

  .header-action-link,
  .header-utility-button {
    display: inline-flex;
    min-height: 2.5rem;
    align-items: center;
    justify-content: center;
    border: 1px solid transparent;
    border-radius: 999px;
    background: transparent;
    color: var(--wb-link);
    cursor: pointer;
    font: inherit;
    font-size: 0.74rem;
    font-weight: 800;
    padding: 0.5rem 0.62rem;
    text-decoration: none;
    text-transform: none;
    white-space: nowrap;
    transition:
      border-color 0.2s ease,
      background-color 0.2s ease,
      color 0.2s ease;
  }

  .header-action-link:hover,
  .header-utility-button:hover,
  .header-action-link.is-active {
    border-color: var(--wb-border);
    background: var(--wb-green-soft);
    color: var(--wb-link-hover);
  }

  .header-action-link--signup {
    border-color: color-mix(in srgb, var(--wb-warm) 52%, var(--wb-border));
    background: var(--wb-warm-soft);
    color: var(--wb-earth);
  }

  .header-action-link--logout {
    color: #8f2f20;
  }

  .header-utility-button {
    width: 2.55rem;
    height: 2.55rem;
    flex: 0 0 auto;
    border-color: var(--wb-border);
    padding: 0;
  }

  .header-utility-button span {
    display: none;
  }

  .book-link svg,
  .header-utility-button svg,
  .mobile-nav-toggle svg {
    width: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 2;
    transition: transform 0.2s ease;
  }

  .header-theme {
    display: flex;
    width: 3.2rem;
    min-height: 2.55rem;
    align-items: center;
    justify-content: center;
  }

  .header-theme :global(#themeButton) {
    gap: 0;
  }

  .header-theme :global(#themeButton > span) {
    display: none;
  }

  .mobile-nav-toggle {
    display: none;
    width: 2.7rem;
    height: 2.7rem;
    place-items: center;
    border: 1px solid var(--wb-border);
    border-radius: 999px;
    background: var(--wb-surface-raised);
    color: var(--wb-link);
    cursor: pointer;
  }

  .mobile-nav-toggle__close {
    display: none;
  }

  :global(html.dark) .site-header {
    border-bottom-color: var(--wb-border);
    background: rgba(15, 20, 15, 0.95);
  }

  :global(html.dark) .site-header__brand::before {
    border-color: color-mix(in srgb, var(--wb-warm) 42%, var(--wb-border));
    border-top-color: color-mix(in srgb, var(--wb-warm-soft) 62%, transparent);
    border-left-color: color-mix(in srgb, var(--wb-warm-soft) 58%, transparent);
    background:
      linear-gradient(105deg, rgba(23, 29, 22, 0.98), rgba(32, 39, 29, 0.96) 74%),
      var(--wb-surface-raised);
    box-shadow:
      0 16px 32px rgba(0, 0, 0, 0.34),
      inset -1px -1px 0 rgba(197, 164, 112, 0.14);
  }

  :global(html.dark) .site-header__brand img {
    filter: brightness(1.45) saturate(0.9);
  }

  :global(html.dark) .site-header__brand:is(:hover, :focus-visible)::before {
    box-shadow:
      0 18px 38px rgba(0, 0, 0, 0.42),
      0 0 24px rgba(197, 164, 112, 0.18),
      inset -1px -1px 0 rgba(197, 164, 112, 0.2);
  }

  :global(html.dark) .site-header__brand:is(:hover, :focus-visible) img {
    filter:
      brightness(1.5)
      saturate(0.92)
      drop-shadow(0 10px 20px rgba(0, 0, 0, 0.38))
      drop-shadow(0 0 14px rgba(197, 164, 112, 0.22));
  }

  :global(html.dark) .site-nav__link,
  :global(html.dark) .header-action-link,
  :global(html.dark) .header-utility-button {
    color: var(--wb-text);
  }

  :global(html.dark) .header-action-link--signup {
    border-color: var(--wb-border);
    background: var(--wb-warm-soft);
    color: var(--wb-warm);
  }

  :global(html.dark) .header-action-link--logout {
    color: #efb0a2;
  }

  :global(html.dark) .book-link {
    background: var(--wb-action);
    color: var(--wb-on-action) !important;
  }

  @media (max-width: 1240px) and (min-width: 1121px) {
    .site-header__bar {
      width: min(100% - 1.25rem, 90rem);
      gap: 0.7rem;
    }

    .site-nav__link,
    .header-action-link {
      padding-inline: 0.5rem;
    }

    .header-theme {
      display: none;
    }

    .site-header__brand {
      --header-logo-top-scale: 1.42;
      --header-logo-hover-scale: 1.49;
      --header-logo-visual-width: 165px;
      --header-logo-bleed: 0.625rem;
    }
  }

  @media (max-width: 1120px) {
    .site-header__bar {
      width: min(calc(100vw - 1.5rem), 52rem);
      gap: 0;
    }

    .site-header__brand {
      --header-logo-top-scale: 1.45;
      --header-logo-hover-scale: 1.52;
      --header-logo-base-height: 54px;
      --header-logo-visual-width: 134px;
      --header-logo-side-space: 1rem;
      --header-logo-bleed: 0.75rem;
      width: calc(var(--header-logo-visual-width) + var(--header-logo-side-space));
    }

    .site-header__brand::before {
      bottom: -0.8rem;
      width: calc(var(--header-logo-bleed) + var(--header-logo-visual-width) + var(--header-logo-side-space) + 0.65rem);
      border-radius: 0 0 1.25rem 0;
    }

    .mobile-nav-toggle {
      display: grid;
      justify-self: end;
      grid-column: 3;
      grid-row: 1;
    }

    .site-header.is-mobile-open .mobile-nav-toggle__menu {
      display: none;
    }

    .site-header.is-mobile-open .mobile-nav-toggle__close {
      display: block;
    }

    .site-header__panel {
      position: fixed;
      top: var(--site-header-height);
      right: 0;
      left: 0;
      display: none;
      max-height: calc(100dvh - var(--site-header-height));
      border-top: 1px solid var(--wb-border);
      background: var(--wb-surface-raised);
      box-shadow: var(--wb-shadow-lg);
      overflow-y: auto;
      padding: 1rem max(1rem, calc((100% - 52rem) / 2));
    }

    .site-header.is-mobile-open .site-header__panel {
      display: block;
    }

    .site-nav {
      display: grid;
      gap: 0.25rem;
    }

    .site-nav__link,
    .book-link {
      width: 100%;
      min-height: 3rem;
      justify-content: flex-start;
      border-radius: var(--wb-radius-sm);
      font-size: 0.9rem;
      padding: 0.7rem 0.85rem;
    }

    .site-nav__link.is-active::after {
      top: 50%;
      right: 0.9rem;
      bottom: auto;
      left: auto;
      width: 0.4rem;
      height: 0.4rem;
      transform: translateY(-50%);
    }

    .book-link {
      justify-content: center;
    }

    .site-header__actions {
      display: grid;
      gap: 0.75rem;
      margin-top: 0.75rem;
    }

    .header-account-actions,
    .header-utilities {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.75rem;
    }

    .header-account-actions form {
      display: block;
    }

    .header-action-link,
    .header-action-link--logout,
    .header-utility-button {
      width: 100%;
      min-height: 3rem;
      border: 1px solid var(--wb-border);
      border-radius: var(--wb-radius-sm);
      font-size: 0.88rem;
    }

    .header-utility-button {
      gap: 0.5rem;
      padding-inline: 0.75rem;
    }

    .header-utility-button span {
      display: inline;
    }

    .header-theme {
      display: flex;
      width: 100%;
      min-height: 3rem;
      border: 1px solid var(--wb-border);
      border-radius: var(--wb-radius-sm);
      padding: 0.45rem;
    }

    .header-theme :global(#themeButton) {
      gap: 0.5rem;
    }

    .header-theme :global(#themeButton > span) {
      display: inline-flex;
    }

    :global(html.dark) .site-header__panel {
      background: var(--wb-surface-raised);
    }

    :global(body.mobile-navigation-open) {
      overflow: hidden;
    }
  }

  @media (max-width: 420px) {
    .site-header__bar {
      width: calc(100vw - 1rem);
    }

    .site-header__panel {
      padding-inline: 0.75rem;
    }

    .site-header__brand {
      --header-logo-top-scale: 1.3;
      --header-logo-hover-scale: 1.36;
      --header-logo-base-height: 50px;
      --header-logo-visual-width: 111px;
      --header-logo-side-space: 0.65rem;
      --header-logo-bleed: 0.5rem;
      width: calc(var(--header-logo-visual-width) + var(--header-logo-side-space));
    }

    .site-header__brand::before {
      bottom: -0.45rem;
      width: calc(var(--header-logo-bleed) + var(--header-logo-visual-width) + var(--header-logo-side-space) + 0.45rem);
      box-shadow: 0 10px 20px rgba(18, 60, 36, 0.1);
    }

    .header-account-actions,
    .header-utilities {
      gap: 0.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header__brand,
    .site-header__brand::before,
    .site-header__brand img {
      transition: none;
    }
  }
</style>
