---
import { isExpiredReservationCancellation } from '../../../lib/bookingStatus';

const {
  isStaff,
  isAdmin,
  bookingsError,
  customerMapError,
  bookingPaymentsError,
  enrichedBookings,
  reservationState,
  statusLabels,
  customQuotationIsFinalized,
  canTransitionBookingTo,
} = Astro.props;

function formatDate(value: string | null | undefined, options: Intl.DateTimeFormatOptions = { month: 'short', day: 'numeric', year: 'numeric' }) {
  return value ? new Date(value).toLocaleDateString('en-PH', options) : '-';
}

function formatDateTime(value: string | null | undefined) {
  return value ? new Date(value).toLocaleString('en-PH', { dateStyle: 'medium', timeStyle: 'short' }) : '-';
}

function bookingTypeLabel(booking: any) {
  return booking.package_type === 'custom-booking' ? 'Custom booking' : 'Preset package';
}

function bookingTypeFilterValue(booking: any) {
  return booking.package_type === 'custom-booking' ? 'custom' : 'preset';
}

function paymentLabel(payment: any) {
  const status = payment?.payment_status ?? 'unpaid';
  return status ? status[0].toUpperCase() + status.slice(1) : 'Unpaid';
}

function parseBookingEndMs(booking: any) {
  if (booking.end_datetime) {
    const parsed = Date.parse(booking.end_datetime);
    if (Number.isFinite(parsed)) return parsed;
  }
  if (!booking.end_date) return null;
  const parsed = Date.parse(`${booking.end_date}T23:59:59+08:00`);
  return Number.isFinite(parsed) ? parsed : null;
}

function bookingHasEnded(booking: any) {
  const endMs = parseBookingEndMs(booking);
  return endMs !== null && Date.now() >= endMs;
}

function getBookingNextAction(booking: any) {
  if (booking.pendingRescheduleRequest) return 'Review Reschedule';
  if (booking.status === 'pending' && booking.package_type === 'custom-booking' && !customQuotationIsFinalized(booking)) return 'Finalize Quotation';
  if (booking.status === 'pending') return 'Await Payment';
  if ((booking.status === 'booked' || booking.status === 'rescheduled') && bookingHasEnded(booking)) return 'Complete Event';
  if (booking.status === 'cancelled' && booking.payment?.refund_status === 'pending') return 'Process Refund';
  if (booking.status === 'booked' || booking.status === 'rescheduled') return 'Monitor Event';
  if (booking.status === 'completed') return 'Completed';
  if (booking.status === 'cancelled') return 'Cancelled';
  return 'Review Booking';
}
---

<!-- TAB: BOOKINGS -->
<section id="tab-bookings" class={`tab-section ${isStaff ? '' : 'hidden'}`}>

  <!-- Filters + Search bar -->
  <div class="admin-toolbar bg-white rounded-2xl shadow-sm border border-gray-100 px-5 py-4 mb-5 flex flex-wrap gap-3 items-center justify-between">
    <div class="admin-toolbar__filters flex gap-2 flex-wrap items-center">
      <span class="admin-toolbar__label text-xs font-bold text-gray-400 uppercase tracking-wider mr-1">Show</span>
      {[
        { v:'all',         label:'All',          color:'#7c6246' },
        { v:'pending',     label:'Pending',      color:'#aa8f66' },
        { v:'booked',   label:'Booked',  color:'#157a45' },
        { v:'cancelled',   label:'Cancelled',  color:'#9a4a36' },
        { v:'rescheduled', label:'Rescheduled',color:'#aa8f66' },
        { v:'completed', label:'Completed', color:'#5e5c60' },
      ].map(s => (
        <button data-filter={s.v}
          class="filter-btn px-4 py-1.5 rounded-full text-xs font-bold border-2 transition-all"
          style="border-color:#e5e7eb;color:#6b7280;">
          {s.label}
        </button>
      ))}
    </div>
    <div class="admin-toolbar__controls flex flex-wrap gap-3 items-center">
      <select id="bookingTypeFilter" class="px-3 py-2 rounded-xl border border-gray-200 text-sm focus:outline-none" aria-label="Filter bookings by type">
        <option value="all">All types</option>
        <option value="preset">Preset packages</option>
        <option value="custom">Custom bookings</option>
      </select>
      <input id="bookingDateFrom" type="date" class="px-3 py-2 rounded-xl border border-gray-200 text-sm focus:outline-none" aria-label="Filter bookings from date" />
      <input id="bookingDateTo" type="date" class="px-3 py-2 rounded-xl border border-gray-200 text-sm focus:outline-none" aria-label="Filter bookings to date" />
      <select id="bookingSort" class="px-3 py-2 rounded-xl border border-gray-200 text-sm focus:outline-none">
        <option value="newest">Newest first</option>
        <option value="oldest">Oldest first</option>
        <option value="event_asc">Event date ascending</option>
        <option value="event_desc">Event date descending</option>
        <option value="status">Status</option>
      </select>
      <div class="relative">
        <svg class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-300" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
        <input id="bookingSearch" type="text" placeholder="Search customer, venue, email, phone..."
          class="pl-9 pr-4 py-2 rounded-xl border border-gray-200 text-sm focus:outline-none focus:ring-2 w-64"
          style="focus-ring-color:var(--butterscotch-primary);" />
      </div>
    </div>
  </div>

  {bookingsError && (
    <div class="admin-notice admin-notice--danger mb-3 rounded-xl border border-red-100 bg-red-50 px-4 py-3 text-sm font-semibold text-red-700">Bookings could not be loaded. Please refresh or check the admin connection.</div>
  )}
  {customerMapError && (
    <div class="admin-notice admin-notice--warning mb-3 rounded-xl border border-amber-100 bg-amber-50 px-4 py-3 text-sm font-semibold text-amber-700">Customer contact details could not be loaded.</div>
  )}
  {bookingPaymentsError && (
    <div class="admin-notice admin-notice--warning mb-3 rounded-xl border border-amber-100 bg-amber-50 px-4 py-3 text-sm font-semibold text-amber-700">Payment records could not be loaded. Apply the booking payments migration.</div>
  )}

  <div class="admin-panel bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
    <div class="admin-table-wrap overflow-x-auto">
      <table class="admin-table admin-bookings-table w-full text-sm">
        <thead>
          <tr style="background:#f8f9fa;border-bottom:2px solid #f3f4f6;">
            <th class="px-4 py-3 text-left text-xs font-bold text-gray-400 uppercase tracking-wider">Guest</th>
            <th class="px-4 py-3 text-left text-xs font-bold text-gray-400 uppercase tracking-wider">Venue</th>
            <th class="px-4 py-3 text-left text-xs font-bold text-gray-400 uppercase tracking-wider">Package</th>
            <th class="px-4 py-3 text-left text-xs font-bold text-gray-400 uppercase tracking-wider">Event Date</th>
            <th class="px-4 py-3 text-left text-xs font-bold text-gray-400 uppercase tracking-wider">Hold Period</th>
            <th class="px-4 py-3 text-left text-xs font-bold text-gray-400 uppercase tracking-wider">Pax</th>
            <th class="px-4 py-3 text-left text-xs font-bold text-gray-400 uppercase tracking-wider">Total</th>
            <th class="px-4 py-3 text-left text-xs font-bold text-gray-400 uppercase tracking-wider">Reservation</th>
            <th class="px-4 py-3 text-left text-xs font-bold text-gray-400 uppercase tracking-wider">Payment</th>
            <th class="px-4 py-3 text-left text-xs font-bold text-gray-400 uppercase tracking-wider">Status</th>
            <th class="px-4 py-3 text-left text-xs font-bold text-gray-400 uppercase tracking-wider">Next Action</th>
            <th class="px-4 py-3 text-left text-xs font-bold text-gray-400 uppercase tracking-wider">Booked On</th>
            <th class="px-4 py-3 text-left text-xs font-bold text-gray-400 uppercase tracking-wider">Actions</th>
          </tr>
        </thead>
        <tbody id="bookingsTableBody">
          {enrichedBookings.map((b) => {
              const reservation = reservationState(b);
              const assignedVenues = Array.isArray(b.assignedVenueNames) && b.assignedVenueNames.length > 0
                ? b.assignedVenueNames
                : [b.venueName ?? '-'];
              const nextAction = getBookingNextAction(b);
              const hasRefundPending = b.payment?.refund_status === 'pending' && Number(b.payment?.refund_amount ?? 0) > 0;
              const canComplete = canTransitionBookingTo(b.status, 'completed') && bookingHasEnded(b);
              const statusColors = {
                pending:'wb-badge--earth',
                booked:'wb-badge--success',
                completed:'wb-badge--neutral',
                cancelled:'wb-badge--danger',
                rescheduled:'wb-badge--earth',
              };
              return (
                <tr
                  data-status={b.status}
                  data-booking-type={bookingTypeFilterValue(b)}
                  data-created={b.created_at}
                  data-event-date={b.event_date ?? b.start_date}
                  data-status-label={statusLabels[b.status] ?? b.status}
                  data-customer={`${b.full_name??''} ${b.customerEmail??''} ${b.customerPhone??b.phone??''}`}
                  data-search={`${b.full_name??''} ${assignedVenues.join(' ')} ${b.customerEmail??''} ${b.customerPhone??b.phone??''} ${b.event_type??''} ${b.eventTypeName??''} ${b.packageName??''} ${paymentLabel(b.payment)} ${nextAction}`}
                  class={`booking-row border-t border-gray-50 hover:bg-amber-50 transition-colors ${b.status==='cancelled'?'booking-row--cancelled':''}`}
                >
                  {/* Guest */}
                  <td class="px-4 py-3">
                    <p class="admin-table-primary">{b.full_name??'—'}</p>
                    <p class="admin-table-meta mt-0.5">{b.customerEmail ?? 'No email saved'}</p>
                    <p class="admin-table-meta mt-0.5">{b.customerPhone ?? 'No phone saved'}</p>
                  </td>

                  {/* Venue */}
                  <td class="px-4 py-3">
                    <span class="admin-table-strong">{assignedVenues.join(', ')}</span>
                  </td>

                  {/* Package */}
                  <td class="px-4 py-3 admin-table-muted">
                    <span class="admin-table-strong">{b.packageName??b.event_type??'-'}</span>
                    <p class="admin-table-meta mt-0.5">{bookingTypeLabel(b)}</p>
                  </td>

                  {/* Event date */}
                  <td class="px-4 py-3 admin-table-strong">
                    {formatDate(b.event_date)}
                  </td>

                  {/* Hold period */}
                  <td class="px-4 py-3">
                    <div class="admin-table-meta whitespace-nowrap">
                      {new Date(b.start_date).toLocaleDateString('en-PH',{month:'short',day:'numeric'})}
                      <span class="text-gray-300 mx-1">to</span>
                      {new Date(b.end_date).toLocaleDateString('en-PH',{month:'short',day:'numeric'})}
                    </div>
                    {b.pendingRescheduleRequest && (
                      <div class="admin-table-meta mt-1 font-semibold" style="color:var(--wb-link);">
                        Reschedule requested
                      </div>
                    )}
                  </td>

                  {/* Pax */}
                  <td class="px-4 py-3 admin-table-strong text-center">{b.pax??'-'}</td>

                  {/* Total */}
                  <td class="px-4 py-3 font-bold" style="color:var(--butterscotch-primary);">
                    {b.package_type === 'custom-booking' && !customQuotationIsFinalized(b) ? 'To be confirmed' : b.total_price ? `PHP ${Number(b.total_price).toLocaleString()}` : '-'}
                  </td>

                  <td class={`px-4 py-3 min-w-[190px] ${reservation.warning ? 'reservation-warning-cell' : ''}`}>
                    <span class={`reservation-badge ${reservation.className}`}>{reservation.label}</span>
                    <div class="admin-table-meta mt-1.5">
                      Deadline {b.reservation_expires_at
                        ? formatDateTime(b.reservation_expires_at)
                        : '-'}
                    </div>
                    <div
                      class={`reservation-countdown mt-1 text-xs font-bold ${reservation.warning ? 'text-amber-700' : 'text-gray-500'}`}
                      data-reservation-expires={b.reservation_expires_at ?? ''}
                      data-reservation-state={reservation.kind}
                    ></div>
                  </td>

                  <td class="px-4 py-3 whitespace-nowrap">
                    <span class={`payment-badge ${b.payment.payment_status === 'paid' ? 'payment-badge--paid' : b.payment.payment_status === 'partial' ? 'payment-badge--partial' : b.payment.payment_status === 'refunded' ? 'payment-badge--refunded' : 'payment-badge--unpaid'}`}>
                      {paymentLabel(b.payment)}
                    </span>
                    <div class="admin-table-meta mt-1">Paid PHP {Number(b.payment.amount_paid).toLocaleString()}</div>
                    {hasRefundPending && (
                      <div class="admin-table-meta mt-1 font-semibold text-amber-700">
                        Refund pending: PHP {Number(b.payment.refund_amount).toLocaleString()}
                      </div>
                    )}
                  </td>

                  {/* Status */}
                  <td class="px-4 py-3">
                    <span class={`wb-badge ${statusColors[b.status]??'wb-badge--neutral'}`}>
                      {b.status === 'pending' && b.package_type === 'custom-booking' && !customQuotationIsFinalized(b) ? 'Waiting for Quotation' : statusLabels[b.status] ?? b.status}
                    </span>
                    {b.status === 'cancelled' && (
                      <div class="mt-2 max-w-48 rounded-lg border border-red-200 bg-red-50 px-2.5 py-2 text-xs font-semibold text-red-800">
                        {isExpiredReservationCancellation(b)
                          ? 'Expired unpaid reservation. Reopening requires an admin override.'
                          : 'Cancelled reservation. Normal status actions are locked.'}
                      </div>
                    )}
                  </td>

                  <td class="px-4 py-3">
                    <span class="admin-table-strong">{nextAction}</span>
                    {b.quotation_status === 'finalized' && (
                      <p class="admin-table-meta mt-0.5">Quote finalized {formatDateTime(b.quotation_finalized_at)}</p>
                    )}
                  </td>

                  {/* Booked on */}
                  <td class="px-4 py-3 admin-table-meta whitespace-nowrap">
                    {formatDate(b.created_at)}
                    <div class="text-gray-300">{new Date(b.created_at).toLocaleTimeString('en-PH',{hour:'2-digit',minute:'2-digit'})}</div>
                  </td>

                  {/* Actions */}
                  <td class="px-4 py-3">
                    <div class="admin-action-group flex gap-1.5 flex-wrap">
                      <button onclick={`openPaymentModal(${JSON.stringify(JSON.stringify(b))})`}
                        class="admin-action-btn admin-action-btn--primary px-2.5 py-1.5 rounded-lg text-xs font-bold text-white transition hover:opacity-80"
                        style="background:#1f6b43;">{b.package_type === 'custom-booking' && !customQuotationIsFinalized(b) ? 'Finalize Quote' : 'Payment'}</button>
                      {b.status !== 'pending' && canTransitionBookingTo(b.status, 'booked')&&(
                        <button onclick={`confirmBooking('${b.id}')`}
                          class="admin-action-btn admin-action-btn--success px-2.5 py-1.5 rounded-lg text-xs font-bold text-white transition hover:opacity-80 hover:-translate-y-0.5"
                          style="background:#157a45;">Book</button>
                      )}
                      {canTransitionBookingTo(b.status, 'rescheduled')&&(
                        <button onclick={`openReschedule('${b.id}')`}
                          class="admin-action-btn admin-action-btn--warm px-2.5 py-1.5 rounded-lg text-xs font-bold text-white transition hover:opacity-80"
                          style="background:#aa8f66;">Reschedule</button>
                      )}
                      {b.pendingRescheduleRequest && (
                        <>
                          <button onclick={`approveRescheduleRequest('${b.id}')`}
                            class="admin-action-btn admin-action-btn--success px-2.5 py-1.5 rounded-lg text-xs font-bold text-white transition hover:opacity-80"
                            style="background:#157a45;">Approve Request</button>
                          <button onclick={`rejectRescheduleRequest('${b.id}')`}
                            class="admin-action-btn admin-action-btn--danger px-2.5 py-1.5 rounded-lg text-xs font-bold text-white transition hover:opacity-80"
                            style="background:#9a4a36;">Reject Request</button>
                        </>
                      )}
                      {canTransitionBookingTo(b.status, 'cancelled')&&(
                        <button onclick={`cancelBooking('${b.id}')`}
                          class="admin-action-btn admin-action-btn--danger px-2.5 py-1.5 rounded-lg text-xs font-bold text-white transition hover:opacity-80"
                          style="background:#9a4a36;">Cancel</button>
                      )}
                      {canComplete&&(
                        <button onclick={`setBookingCompleted('${b.id}')`}
                          class="admin-action-btn admin-action-btn--neutral px-2.5 py-1.5 rounded-lg text-xs font-bold text-white transition hover:opacity-80"
                          style="background:#5e5c60;">Complete</button>
                      )}
                      {isAdmin && b.status === 'cancelled' && (
                        <div class="mt-1 w-full border-t border-red-200 pt-2">
                          <div class="mb-1 text-[10px] font-bold uppercase tracking-wider text-red-700">Manual override</div>
                          <button onclick={`manuallyReopenCancelledBooking('${b.id}', ${isExpiredReservationCancellation(b) ? 'true' : 'false'})`}
                            class="admin-action-btn admin-action-btn--danger px-2.5 py-1.5 rounded-lg text-xs font-bold text-white transition hover:opacity-80"
                            style="background:#9a4a36;">Reopen as booked</button>
                        </div>
                      )}
                      <button onclick={`openBookingDetail(${JSON.stringify(JSON.stringify(b))})`}
                        class="admin-action-btn admin-action-btn--outline px-2.5 py-1.5 rounded-lg text-xs font-bold border-2 transition hover:bg-gray-50"
                        style="border-color:#ddd2c1;color:#5e5c60;">View</button>
                    </div>
                  </td>
                </tr>
              );
          })}
        </tbody>
      </table>
    </div>
    <p id="bookingsEmptyState" class="admin-empty-state hidden px-5 py-8 text-center text-sm text-gray-400">No bookings match the current filters.</p>
  </div>
</section>
