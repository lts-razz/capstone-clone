---
---

<!-- TAB: REPORTS -->
<section id="tab-reports" class="tab-section hidden">
  <div class="reports-intro mb-6">
    <p class="reports-eyebrow">Operational summary</p>
    <h2>Reports Management</h2>
    <p>Review bookings and authoritative booking-payment records for a selected week or month.</p>
  </div>

  <div class="flex flex-wrap gap-3 items-center mb-6">
    <div class="flex rounded-xl overflow-hidden border-2 border-gray-200">
      <button id="rpt-btn-weekly" type="button" class="rpt-mode-btn px-5 py-2 text-sm font-semibold transition-all">Weekly</button>
      <button id="rpt-btn-monthly" type="button" class="rpt-mode-btn px-5 py-2 text-sm font-semibold transition-all">Monthly</button>
    </div>

    <div id="rpt-week-picker" class="flex items-center gap-2">
      <label for="rpt-week-input" class="text-sm font-semibold text-gray-500">Week containing:</label>
      <input type="date" id="rpt-week-input" class="px-3 py-1.5 rounded-lg border border-gray-200 text-sm focus:outline-none" />
    </div>

    <div id="rpt-month-picker" class="hidden flex items-center gap-2">
      <label for="rpt-month-input" class="text-sm font-semibold text-gray-500">Month:</label>
      <input type="month" id="rpt-month-input" class="px-3 py-1.5 rounded-lg border border-gray-200 text-sm focus:outline-none" />
    </div>

    <button id="generate-report-button" type="button" class="px-5 py-2 rounded-xl text-white text-sm font-bold transition hover:opacity-90" style="background:var(--butterscotch-primary);">Generate Report</button>
    <button id="print-report-button" type="button" class="px-5 py-2 rounded-xl text-sm font-bold border-2 transition hover:bg-gray-50" style="border-color:var(--butterscotch-primary);color:var(--butterscotch-primary);">Print / Save PDF</button>
  </div>

  <div id="report-output" class="bg-white rounded-xl shadow-sm border border-gray-100 p-8 hidden">
    <div class="flex justify-between items-start mb-6 pb-5 border-b border-gray-100">
      <div>
        <h2 id="rpt-title" class="text-2xl font-black" style="color:var(--jet-primary);"></h2>
        <p id="rpt-period" class="text-sm text-gray-400 mt-0.5"></p>
        <p class="report-period-note mt-2">Figures include bookings created during the selected period. Payment values come from booking payment records when available.</p>
      </div>
      <p class="text-xs text-gray-400">Generated: <span id="rpt-generated"></span></p>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-3 xl:grid-cols-6 gap-4 mb-8">
      {[
        { id: 'rpt-total', label: 'Total bookings' },
        { id: 'rpt-pending', label: 'Pending payment' },
        { id: 'rpt-booked', label: 'Booked' },
        { id: 'rpt-rescheduled', label: 'Rescheduled' },
        { id: 'rpt-completed', label: 'Completed' },
        { id: 'rpt-cancelled', label: 'Cancelled' },
      ].map((card) => (
        <div class="rounded-xl p-4 border border-gray-100 bg-gray-50">
          <p class="text-xs uppercase tracking-wide text-gray-400 font-semibold mb-1">{card.label}</p>
          <p id={card.id} class="text-2xl font-black" style="color:var(--jet-primary);">-</p>
        </div>
      ))}
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-5 mb-8">
      <section class="border border-gray-100 rounded-xl p-5 bg-gray-50">
        <h3 class="text-sm font-bold uppercase tracking-wide text-gray-400 mb-4">Booking Mix</h3>
        <dl class="space-y-3 text-sm">
          <div class="flex justify-between gap-4"><dt class="text-gray-500">Package bookings</dt><dd id="rpt-package-bookings" class="font-bold">-</dd></div>
          <div class="flex justify-between gap-4"><dt class="text-gray-500">Custom bookings</dt><dd id="rpt-custom-bookings" class="font-bold">-</dd></div>
          <div class="flex justify-between gap-4"><dt class="text-gray-500">Upcoming active events</dt><dd id="rpt-upcoming" class="font-bold">-</dd></div>
        </dl>
      </section>

      <section class="border border-gray-100 rounded-xl p-5 bg-gray-50">
        <h3 class="text-sm font-bold uppercase tracking-wide text-gray-400 mb-4">Payment Summary</h3>
        <dl class="space-y-3 text-sm">
          <div class="flex justify-between gap-4"><dt class="text-gray-500">Payable booking value</dt><dd id="rpt-gross" class="font-bold">-</dd></div>
          <div class="flex justify-between gap-4"><dt class="text-gray-500">Amount paid</dt><dd id="rpt-paid" class="font-bold">-</dd></div>
          <div class="flex justify-between gap-4"><dt class="text-gray-500">Outstanding balance</dt><dd id="rpt-unpaid" class="font-bold">-</dd></div>
        </dl>
      </section>

      <section class="border border-gray-100 rounded-xl p-5 bg-gray-50">
        <h3 class="text-sm font-bold uppercase tracking-wide text-gray-400 mb-4">Payment Statuses</h3>
        <dl class="space-y-3 text-sm">
          <div class="flex justify-between gap-4"><dt class="text-gray-500">Unpaid</dt><dd id="rpt-pay-unpaid" class="font-bold">-</dd></div>
          <div class="flex justify-between gap-4"><dt class="text-gray-500">Partial</dt><dd id="rpt-pay-partial" class="font-bold">-</dd></div>
          <div class="flex justify-between gap-4"><dt class="text-gray-500">Paid</dt><dd id="rpt-pay-paid" class="font-bold">-</dd></div>
          <div class="flex justify-between gap-4"><dt class="text-gray-500">Refunded</dt><dd id="rpt-pay-refunded" class="font-bold">-</dd></div>
        </dl>
      </section>
    </div>

    <section class="border border-gray-100 rounded-xl p-5 bg-gray-50 mb-8">
      <div class="flex flex-wrap items-start justify-between gap-3 mb-4">
        <div>
          <h3 class="text-sm font-bold uppercase tracking-wide text-gray-400">Predictive Forecast</h3>
          <p id="rpt-forecast-period" class="text-lg font-black mt-1" style="color:var(--jet-primary);">-</p>
        </div>
        <p id="rpt-forecast-trend" class="px-3 py-1 rounded-full text-xs font-bold bg-white border border-gray-100 text-gray-600">-</p>
      </div>
      <p id="rpt-forecast-unavailable" class="text-sm text-gray-500 hidden">-</p>
      <div id="rpt-forecast-results" class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-4">
        <div class="rounded-lg border border-gray-100 bg-white p-4">
          <p class="text-xs uppercase tracking-wide text-gray-400 font-semibold mb-1">Expected bookings</p>
          <p id="rpt-forecast-bookings" class="text-2xl font-black" style="color:var(--jet-primary);">-</p>
          <p class="text-xs text-gray-400 mt-1">Includes low/high range</p>
        </div>
        <div class="rounded-lg border border-gray-100 bg-white p-4">
          <p class="text-xs uppercase tracking-wide text-gray-400 font-semibold mb-1">Expected booking value</p>
          <p id="rpt-forecast-revenue" class="text-2xl font-black" style="color:var(--jet-primary);">-</p>
          <p class="text-xs text-gray-400 mt-1">Includes low/high range</p>
        </div>
        <div class="rounded-lg border border-gray-100 bg-white p-4">
          <p class="text-xs uppercase tracking-wide text-gray-400 font-semibold mb-1">Confidence</p>
          <p id="rpt-forecast-confidence" class="text-2xl font-black" style="color:var(--jet-primary);">-</p>
        </div>
        <div class="rounded-lg border border-gray-100 bg-white p-4">
          <p class="text-xs uppercase tracking-wide text-gray-400 font-semibold mb-1">Cancellation estimate</p>
          <p id="rpt-forecast-cancellation" class="text-2xl font-black" style="color:var(--jet-primary);">-</p>
        </div>
        <div class="rounded-lg border border-gray-100 bg-white p-4">
          <p class="text-xs uppercase tracking-wide text-gray-400 font-semibold mb-1">Package vs custom demand</p>
          <p id="rpt-forecast-mix" class="text-2xl font-black" style="color:var(--jet-primary);">-</p>
        </div>
        <div class="rounded-lg border border-gray-100 bg-white p-4">
          <p class="text-xs uppercase tracking-wide text-gray-400 font-semibold mb-1">Average booking value</p>
          <p id="rpt-forecast-average-value" class="text-2xl font-black" style="color:var(--jet-primary);">-</p>
        </div>
        <div class="rounded-lg border border-gray-100 bg-white p-4">
          <p class="text-xs uppercase tracking-wide text-gray-400 font-semibold mb-1">Likely top package</p>
          <p id="rpt-forecast-top-package" class="text-2xl font-black" style="color:var(--jet-primary);">-</p>
        </div>
        <div class="rounded-lg border border-gray-100 bg-white p-4">
          <p class="text-xs uppercase tracking-wide text-gray-400 font-semibold mb-1">Likely busiest venue</p>
          <p id="rpt-forecast-busiest-venue" class="text-2xl font-black" style="color:var(--jet-primary);">-</p>
        </div>
      </div>
      <div id="rpt-forecast-visualization" class="mt-5 border-t border-gray-100 pt-5 hidden">
        <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
          <h4 class="text-sm font-bold uppercase tracking-wide text-gray-400">Historical vs Forecast</h4>
          <div class="flex flex-wrap gap-3 text-xs text-gray-500">
            <span class="inline-flex items-center gap-1"><span class="w-3 h-3 rounded-sm" style="background:var(--butterscotch-primary);"></span>Historical actual</span>
            <span class="inline-flex items-center gap-1"><span class="w-3 h-3 rounded-sm" style="background:var(--wb-action);"></span>Forecast</span>
            <span class="inline-flex items-center gap-1"><span class="w-3 h-3 rounded-sm bg-gray-200 border border-dashed border-gray-400"></span>Low/high range</span>
          </div>
        </div>
        <div id="rpt-forecast-chart" class="grid grid-cols-1 lg:grid-cols-2 gap-4"></div>
      </div>
      <ul id="rpt-forecast-insights" class="mt-4 space-y-2 text-sm text-gray-600"></ul>
      <p id="rpt-forecast-backtest" class="report-period-note mt-4 hidden"></p>
      <p id="rpt-forecast-method" class="report-period-note mt-4 hidden"></p>
    </section>

    <div class="grid grid-cols-1 xl:grid-cols-2 gap-8 mb-8">
      <section>
        <h3 class="text-sm font-bold uppercase tracking-wide text-gray-400 mb-3">Package Usage</h3>
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="bg-gray-50 text-gray-500 text-xs uppercase tracking-wide">
                <th class="px-4 py-2 text-left">Package</th>
                <th class="px-4 py-2 text-left">Bookings</th>
                <th class="px-4 py-2 text-left">Recognized value</th>
              </tr>
            </thead>
            <tbody id="rpt-breakdown-body"></tbody>
          </table>
        </div>
      </section>

      <section>
        <h3 class="text-sm font-bold uppercase tracking-wide text-gray-400 mb-3">Venue Usage</h3>
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="bg-gray-50 text-gray-500 text-xs uppercase tracking-wide">
                <th class="px-4 py-2 text-left">Venue</th>
                <th class="px-4 py-2 text-left">Bookings</th>
              </tr>
            </thead>
            <tbody id="rpt-venue-body"></tbody>
          </table>
        </div>
      </section>
    </div>

    <div class="mb-8">
      <h3 class="text-sm font-bold uppercase tracking-wide text-gray-400 mb-3">Active Event Dates</h3>
      <div id="rpt-distribution" class="space-y-2 text-sm"></div>
    </div>

    <div>
      <h3 class="text-sm font-bold uppercase tracking-wide text-gray-400 mb-3">Bookings in Period</h3>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="bg-gray-50 text-gray-500 text-xs uppercase tracking-wide">
              <th class="px-3 py-2 text-left">Guest</th>
              <th class="px-3 py-2 text-left">Venue</th>
              <th class="px-3 py-2 text-left">Package</th>
              <th class="px-3 py-2 text-left">Event Date</th>
              <th class="px-3 py-2 text-left">Pax</th>
              <th class="px-3 py-2 text-left">Payment</th>
              <th class="px-3 py-2 text-left">Status</th>
            </tr>
          </thead>
          <tbody id="rpt-bookings-body"></tbody>
        </table>
      </div>
    </div>
  </div>

  <div id="report-empty" class="text-center py-16 text-gray-400">
    <p class="font-semibold">Select a period and generate a report.</p>
    <p class="text-sm mt-1">No report data is shown until a week or month is selected.</p>
  </div>
</section>
