---
interface Props {
  compact?: boolean;
  horizontal?: boolean;
}

const { compact = false, horizontal = false } = Astro.props;
const directionsUrl = 'https://maps.app.goo.gl/aZuzcuWewPJ5DibJ7';
const mapEmbedUrl =
  'https://www.google.com/maps?output=embed&q=Woodberry%20Resort%20%26%20Events&ll=14.9731206,120.9131219&z=15';
---

<section
  class:list={[
    'location-map',
    compact && 'location-map--compact',
    horizontal && 'location-map--horizontal',
  ]}
  aria-labelledby="location-map-title"
>
  <div class="location-map__card">
    <div class="location-map__copy">
      <p class="location-map__eyebrow">Location</p>
      <h2 id="location-map-title">Visit Woodberry Resorts and Events Place</h2>
      <p>
        Use the map to plan your route for venue viewings, event preparations,
        or a Woodberry staycation visit.
      </p>
      <div class="location-map__address">
        <span class="location-map__address-label">Address</span>
        <address>B3 DRT HIGHWAY, ULINGAO, SAN RAFAEL, BULACAN</address>
      </div>
      <a
        class="location-map__button"
        href={directionsUrl}
        target="_blank"
        rel="noopener noreferrer"
      >
        Get Directions
      </a>
    </div>

    <div class="location-map__frame" aria-label="Woodberry location on Google Maps">
      <iframe
        src={mapEmbedUrl}
        title="Google Map showing Woodberry Resort and Events location"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        allowfullscreen
      ></iframe>
    </div>
  </div>
</section>

<style>
  .location-map {
    background:
      radial-gradient(circle at 88% 12%, rgba(231, 239, 232, 0.92), transparent 26rem),
      var(--wb-surface);
    color: var(--wb-text);
    padding: clamp(4rem, 8vw, 6rem) clamp(1rem, 6vw, 5.5rem);
  }

  .location-map__card {
    display: grid;
    width: min(100%, 76rem);
    align-items: center;
    gap: clamp(1.25rem, 4vw, 2rem);
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    overflow: hidden;
    border: 1px solid var(--wb-border);
    border-radius: var(--wb-radius-lg);
    background: var(--wb-surface-raised);
    box-shadow: var(--wb-shadow-md);
    margin-inline: auto;
    padding: clamp(1rem, 3vw, 1.5rem);
  }

  .location-map__copy {
    display: grid;
    gap: 1rem;
    min-width: 0;
    padding: clamp(0.5rem, 2vw, 1rem);
  }

  .location-map__eyebrow {
    margin: 0;
    color: var(--wb-green);
    font-size: 0.74rem;
    font-weight: 800;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .location-map h2 {
    margin: 0;
    color: var(--wb-green-dark);
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(1.8rem, 4vw, 3rem);
    letter-spacing: 0;
    line-height: 1.08;
    text-wrap: balance;
  }

  .location-map__copy > p:not(.location-map__eyebrow) {
    max-width: 34rem;
    margin: 0;
    color: var(--wb-muted);
    font-size: 1.02rem;
    line-height: 1.65;
  }

  .location-map__address {
    display: grid;
    max-width: 34rem;
    gap: 0.25rem;
    border-left: 3px solid var(--wb-green);
    background: var(--wb-surface);
    border-radius: 0 var(--wb-radius-sm) var(--wb-radius-sm) 0;
    padding: 0.75rem 0.9rem;
  }

  .location-map__address-label {
    color: var(--wb-earth);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .location-map__address address {
    color: var(--wb-text);
    font-size: 0.96rem;
    font-style: normal;
    font-weight: 700;
    line-height: 1.5;
  }

  .location-map__button {
    display: inline-flex;
    width: fit-content;
    min-height: 3rem;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--wb-action);
    border-radius: 999px;
    background: var(--wb-action);
    box-shadow: 0 10px 22px rgba(18, 60, 36, 0.16);
    color: var(--wb-on-action);
    font-size: 0.84rem;
    font-weight: 800;
    letter-spacing: 0.035em;
    padding: 0.78rem 1.25rem;
    text-decoration: none;
    text-transform: uppercase;
    transition:
      background-color 0.2s ease,
      box-shadow 0.2s ease,
      transform 0.2s ease;
  }

  .location-map__button:hover {
    background: var(--wb-action-hover);
    box-shadow: var(--wb-shadow-md);
    color: var(--wb-on-action);
    transform: translateY(-1px);
  }

  .location-map__button:focus-visible {
    outline: 3px solid var(--wb-focus-ring);
    outline-offset: 3px;
  }

  .location-map__frame {
    aspect-ratio: 16 / 9;
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--wb-border);
    border-radius: var(--wb-radius-md);
    background: var(--wb-surface);
  }

  .location-map__frame iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .location-map--compact {
    background: transparent;
    padding: 0;
  }

  .location-map--compact .location-map__card {
    width: 100%;
    grid-template-columns: 1fr;
    border-radius: var(--wb-radius-md);
    box-shadow: var(--wb-shadow-sm);
    padding: clamp(1.25rem, 3vw, 2rem);
  }

  .location-map--compact .location-map__copy {
    padding: 0;
  }

  .location-map--compact h2 {
    font-size: clamp(1.45rem, 3vw, 2rem);
  }

  .location-map--compact .location-map__button {
    width: 100%;
  }

  .location-map--horizontal .location-map__card {
    grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
  }

  .location-map--horizontal .location-map__button {
    width: fit-content;
  }

  :global(html.dark) .location-map {
    background:
      radial-gradient(circle at 88% 12%, rgba(37, 56, 35, 0.72), transparent 26rem),
      var(--wb-surface);
  }

  :global(html.dark) .location-map--compact {
    background: transparent;
  }

  :global(html.dark) .location-map__button {
    background: var(--wb-action);
    border-color: var(--wb-action);
    color: var(--wb-on-action);
  }

  :global(html.dark) .location-map__button:hover {
    background: var(--wb-action-hover);
    color: var(--wb-on-action);
  }

  @media (max-width: 820px) {
    .location-map__card {
      grid-template-columns: 1fr;
    }

    .location-map--horizontal .location-map__card {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 520px) {
    .location-map {
      padding-inline: 1rem;
    }

    .location-map__card {
      border-radius: var(--wb-radius-md);
    }

    .location-map__button {
      width: 100%;
    }

    .location-map--horizontal .location-map__button {
      width: 100%;
    }
  }

  @media (min-width: 901px) {
    .location-map {
      padding: clamp(2.75rem, 5vw, 4.35rem) clamp(1.5rem, 4vw, 4rem);
    }

    .location-map__card {
      width: min(100%, 88rem);
      gap: clamp(1rem, 2vw, 1.5rem);
      grid-template-columns: minmax(20rem, 0.85fr) minmax(0, 1.15fr);
      padding: 1rem;
    }

    .location-map__copy {
      gap: 0.8rem;
      padding: 0.5rem 0.75rem;
    }

    .location-map h2 {
      font-size: clamp(1.7rem, 2.6vw, 2.45rem);
    }

    .location-map__copy > p:not(.location-map__eyebrow) {
      line-height: 1.55;
    }

    .location-map--horizontal .location-map__card {
      grid-template-columns: minmax(20rem, 0.85fr) minmax(0, 1.15fr);
    }

    .location-map__address {
      padding: 0.65rem 0.8rem;
    }

    .location-map--compact .location-map__card {
      padding: 1rem;
    }

    .location-map--compact h2 {
      font-size: clamp(1.35rem, 2vw, 1.75rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .location-map__button {
      transition: none;
    }
  }
</style>
