  .booking-option-card--locked:hover {
    transform: none;
  }

  .booking-option-card--unavailable:hover {
    border-color: var(--wb-border);
    transform: none;
  }

  .booking-option-card .booking-option-card__package-lock {
    color: var(--wb-green-dark);
    font-weight: 800;
  }

  .booking-field-package-lock {
    margin: 0.4rem 0 0;
    color: var(--wb-green-dark);
    font-size: 0.76rem;
    font-weight: 800;
  }

  @media (max-width: 640px) {
    #bookingForm > .booking-step {
      border-radius: var(--wb-radius-md);
      padding: 1rem;
    }

    .booking-stepper {
      padding: 0.85rem;
    }

    .booking-stepper ol {
      gap: 0.2rem;
    }

    .booking-step-trigger {
      flex-direction: column;
      gap: 0.3rem;
      padding: 0.4rem 0.2rem;
      text-align: center;
    }

    .booking-step-trigger__label {
      font-size: 0.66rem;
    }

    .booking-stepper__status {
      text-align: left;
    }

    .booking-step-actions {
      align-items: stretch;
      flex-direction: column-reverse;
    }

    .booking-step-actions__spacer {
      display: none;
    }

    .booking-step-button,
    .booking-submit {
      width: 100%;
    }

    .notification-preference__options {
      grid-template-columns: 1fr;
    }

    .notification-preference__body {
      min-height: 4.25rem;
      text-align: left;
    }

    .booking-payment-card > div,
    #bookingConfirmModal .flex.justify-between {
      flex-direction: column;
      gap: 0.35rem;
    }

    .booking-payment-card span:last-child {
      text-align: left;
      white-space: normal;
    }

    #termsModal > div,
    #bookingConfirmModal > div {
      max-height: 94vh;
    }

    #termsModal > div > div:last-child,
    #bookingConfirmModal > div > div:last-child {
      flex-direction: column;
    }

    #bookingConfirmModal .grid.grid-cols-2 {
      grid-template-columns: 1fr;
    }

    #bookingConfirmModal .col-span-2 {
      grid-column: auto;
    }

    .booking-confirmation__header,
    .confirmation-venue-card,
    .confirmation-payment-card__top,
    .booking-confirmation__footer {
      flex-direction: column;
    }

    .booking-confirmation__mark {
      display: none;
    }

    .confirmation-detail-grid,
    .confirmation-detail-grid--contact,
    .confirmation-payment-card__breakdown,
    .booking-success-card__payment {
      grid-template-columns: 1fr;
    }

    .confirmation-detail--wide,
    .confirmation-detail-grid--contact .confirmation-detail:nth-child(n + 3) {
      grid-column: auto;
    }

    .confirmation-payment-card__total {
      text-align: left;
      white-space: normal;
    }

    .confirmation-button {
      width: 100%;
    }

    #termsModal,
    #bookingConfirmModal,
    #bookingSuccessScreen {
      padding: 0.65rem;
    }

    .booking-success-card {
      max-height: calc(100vh - 1.3rem);
      overflow-y: auto;
    }
  }

  @media (max-width: 480px) {
    .booking-option-section__heading {
      align-items: flex-start;
      flex-direction: column;
    }

    .booking-room-details-link {
      width: 100%;
    }

    .woodberry-package-card__top {
      flex-direction: column;
      gap: 0.25rem;
    }

    .woodberry-package-card em {
      white-space: normal;
    }

    .booking-option-card {
      grid-template-columns: 1fr;
    }

    .booking-option-card__media,
    .booking-option-card__media img {
      min-height: 9rem;
      max-height: 10rem;
    }

    .booking-option-card__content {
      padding: 0.45rem 0.35rem 0.35rem;
    }

    .booking-option-card__hours,
    .booking-option-card__hours--wide {
      max-width: none;
    }
  }

