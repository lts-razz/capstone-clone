  }

  .booking-option-card__media img {
    display: block;
    width: 100%;
    height: 100%;
    min-height: 7.5rem;
    object-fit: cover;
  }

  .booking-option-card__content {
    display: grid;
    min-width: 0;
    align-content: start;
    gap: 0.35rem;
    padding: 0.35rem 0.25rem 0.35rem 0.15rem;
  }

