  function setPackageLockedState(input, locked) {
    if (!input) return;
    input.disabled = !!locked;
    input.dataset.packageLocked = locked ? "true" : "false";
    var card = input.closest(".booking-option-card");
    card?.classList.toggle("booking-option-card--locked", !!locked);
    var note = card?.querySelector("[data-package-lock-note]");
    if (note && locked) note.textContent = "Set by this package";
    note?.classList.toggle("hidden", !locked);
  }

  function setPackageUnavailableState(input, unavailable, message) {
    if (!input) return;
    input.dataset.packageUnavailable = unavailable ? "true" : "false";
    var card = input.closest(".booking-option-card");
    card?.classList.toggle("booking-option-card--unavailable", !!unavailable);
    var note = card?.querySelector("[data-package-lock-note]");
    if (unavailable) {
      input.checked = false;
      input.disabled = true;
      if (note) note.textContent = message || "Not available with selected package";
      note?.classList.remove("hidden");
    } else if (!card?.classList.contains("booking-option-card--locked")) {
      note?.classList.add("hidden");
    }
  }

  function setPackageIncludedState(input, included) {
    if (!input) return;
    input.dataset.packageIncluded = included ? "true" : "false";
    var card = input.closest(".booking-option-card");
    var price = card?.querySelector(".booking-option-card__price");
    if (price && !input.dataset.originalPriceText) input.dataset.originalPriceText = price.textContent || "";
    if (price) price.textContent = included ? "Included in selected package" : input.dataset.originalPriceText || price.textContent;
  }

  function applyOptionGroupDefaults(groupName, defaults, usesQuantity) {
    document.querySelectorAll('[data-option-group="' + groupName + '"]').forEach(function (input) {
      input.checked = false;
      setPackageLockedState(input, false);
      setPackageUnavailableState(input, false);
      setPackageIncludedState(input, false);
      if (usesQuantity) {
        var quantityInput = document.querySelector('[data-option-hours="' + groupName + '"][data-key="' + input.value + '"]');
        if (quantityInput) {
          quantityInput.value = "0";
          quantityInput.disabled = false;
          quantityInput.dataset.packageIncluded = "false";
          quantityInput.dataset.packageIncludedQuantity = "";
        }
      }
    });

    (Array.isArray(defaults) ? defaults : []).forEach(function (item) {
      var input = document.querySelector('[data-option-group="' + groupName + '"][value="' + item.key + '"]');
      if (!input) return;
      input.checked = true;
      setPackageLockedState(input, item.locked === true);
      setPackageIncludedState(input, item.included === true);
      if (usesQuantity) {
        var quantityInput = document.querySelector('[data-option-hours="' + groupName + '"][data-key="' + item.key + '"]');
        if (quantityInput) {
          quantityInput.value = String(Math.max(1, Number(item.quantity) || 1));
          quantityInput.disabled = item.locked === true;
          quantityInput.dataset.packageIncluded = item.included === true ? "true" : "false";
          quantityInput.dataset.packageIncludedQuantity = item.included === true && item.quantity
            ? String(Math.max(1, Number(item.quantity) || 1))
            : "";
        }
      }
    });
  }

  function getPackageLockouts(defaults) {
    return defaults && typeof defaults.lockouts === "object" && defaults.lockouts
      ? defaults.lockouts
      : {};
  }

  function isPackageSectionLocked(lockouts, sectionKey) {
    return Array.isArray(lockouts.sections) && lockouts.sections.includes(sectionKey);
  }

  function lockoutSet(values) {
    return new Set(Array.isArray(values) ? values : []);
  }

  function setBookingSectionLockout(sectionKey, locked) {
    var section = document.querySelector('[data-booking-lockout-section="' + sectionKey + '"]');
    section?.classList.toggle("booking-option-section--locked-out", !!locked);
    section?.querySelector("[data-section-lockout-note]")?.classList.toggle("hidden", !locked);
  }

  function applyOptionGroupLockouts(groupName, lockouts, sectionKey, optionKey, usesQuantity) {
    var sectionLocked = isPackageSectionLocked(lockouts, sectionKey);
    var unavailableKeys = lockoutSet(lockouts[optionKey]);
    setBookingSectionLockout(sectionKey, sectionLocked);
    document.querySelectorAll('[data-option-group="' + groupName + '"]').forEach(function (input) {
      var unavailable = sectionLocked || unavailableKeys.has(input.value);
      setPackageUnavailableState(
        input,
        unavailable,
        sectionLocked ? "This section is not available with selected package" : "Not available with selected package",
      );
      if (unavailable) setPackageIncludedState(input, false);
      if (usesQuantity) {
        var quantityInput = document.querySelector('[data-option-hours="' + groupName + '"][data-key="' + input.value + '"]');
        if (quantityInput && unavailable) {
          quantityInput.value = "0";
          quantityInput.disabled = true;
          quantityInput.dataset.packageIncluded = "false";
          quantityInput.dataset.packageIncludedQuantity = "";
        }
      }
    });
  }

  function syncPackageEventTypeOptions(selectedPackage) {
    if (!eventTypeInput) return;
    var allowed = Array.isArray(selectedPackage?.eventTypes) && selectedPackage.eventTypes.length
      ? new Set(selectedPackage.eventTypes)
      : null;
    var unavailableCount = 0;
    Array.from(eventTypeInput.options).forEach(function (option) {
      if (!option.value) return;
      var isAllowed = !allowed || allowed.has(option.value);
      option.hidden = !isAllowed;
      option.disabled = !isAllowed;
      if (!isAllowed) unavailableCount++;
    });
    if (eventTypeInput.value && allowed && !allowed.has(eventTypeInput.value)) {
      eventTypeInput.value = "";
    }
    document.getElementById("eventTypePackageLock")?.classList.toggle("hidden", unavailableCount === 0);
  }

  function applyPackageBookingDefaults(selectedPackage) {
    var defaults = selectedPackage?.bookingOptions || {};
    var lockouts = getPackageLockouts(defaults);

    if (isMultiDayInput) {
      isMultiDayInput.checked = defaults.isMultiDay?.selected === true;
      isMultiDayInput.disabled = defaults.isMultiDay?.locked === true;
      document.getElementById("multiDayPackageLock")?.classList.toggle("hidden", defaults.isMultiDay?.locked !== true);
    }
    if (eventTypeInput) {
      syncPackageEventTypeOptions(selectedPackage);
      eventTypeInput.disabled = false;
    }
    if (customEventTypeInput) {
      customEventTypeInput.dataset.packageLocked = "false";
    }

    applyOptionGroupDefaults("rooms", defaults.rooms, false);
    applyOptionGroupDefaults("add-ons", defaults.addOns, false);
    applyOptionGroupDefaults("extensions", defaults.extensions, true);
    applyOptionGroupDefaults("corkage", defaults.corkage, false);
    applyOptionGroupLockouts("rooms", lockouts, "rooms", "rooms", false);
    applyOptionGroupLockouts("add-ons", lockouts, "addOns", "addOns", false);
    applyOptionGroupLockouts("extensions", lockouts, "extensions", "extensions", true);
    applyOptionGroupLockouts("corkage", lockouts, "corkage", "corkage", false);

    if (roomExtensionHoursInput) {
      roomExtensionHoursInput.value = defaults.roomExtensionHours?.value
        ? String(defaults.roomExtensionHours.value)
        : "0";
      roomExtensionHoursInput.disabled = defaults.roomExtensionHours?.locked === true;
      roomExtensionHoursInput.dataset.packageIncluded = defaults.roomExtensionHours?.included === true ? "true" : "false";
      roomExtensionHoursInput.dataset.packageIncludedQuantity = defaults.roomExtensionHours?.included === true && defaults.roomExtensionHours?.value
        ? String(defaults.roomExtensionHours.value)
        : "";
      var roomExtensionUnavailable = isPackageSectionLocked(lockouts, "rooms") || lockouts.roomExtensionHours === true;
      roomExtensionHoursInput.dataset.packageUnavailable = roomExtensionUnavailable ? "true" : "false";
      if (roomExtensionUnavailable) {
        roomExtensionHoursInput.value = "0";
        roomExtensionHoursInput.disabled = true;
        roomExtensionHoursInput.dataset.packageIncluded = "false";
        roomExtensionHoursInput.dataset.packageIncludedQuantity = "";
      }
      var roomExtensionLockNote = document.getElementById("roomExtensionPackageLock");
      if (roomExtensionLockNote) {
        roomExtensionLockNote.textContent = roomExtensionUnavailable
          ? "These hours are not available with the selected package."
          : "These hours are locked by the selected package.";
        roomExtensionLockNote.classList.toggle("hidden", !roomExtensionUnavailable && defaults.roomExtensionHours?.locked !== true);
      }
      roomExtensionHoursInput.closest(".booking-option-card")?.classList.toggle("booking-option-card--unavailable", roomExtensionUnavailable);
    }

    syncDateTimeMode();
    syncCustomEventType();
  }

  function collectSelectedOptions(groupName, options, usesHours) {
    return options
      .map(function (item) {
        var checkbox = document.querySelector('[data-option-group="' + groupName + '"][value="' + item.key + '"]');
        if (!checkbox || checkbox.dataset.packageUnavailable === "true" || !checkbox.checked) return null;
        var hours = 1;
        var includedQuantity = 0;
        if (usesHours) {
          var hoursInput = document.querySelector('[data-option-hours="' + groupName + '"][data-key="' + item.key + '"]');
          hours = Math.max(0, Number(hoursInput?.value) || 0);
          if (hours <= 0) return null;
          includedQuantity = checkbox.dataset.packageIncluded === "true"
            ? Math.min(hours, Math.max(0, Number(hoursInput?.dataset.packageIncludedQuantity) || hours))
            : 0;
        }
        var included = checkbox.dataset.packageIncluded === "true";
        var amount = included && !usesHours ? 0 : item.price * Math.max(0, hours - includedQuantity);
        return {
          key: item.key,
          label: item.label,
          price: item.price,
          quantity: usesHours ? undefined : 1,
          hours: usesHours ? hours : undefined,
          unit: usesHours ? item.unit : undefined,
          included: included,
          includedQuantity: usesHours && included ? includedQuantity : undefined,
          amount: amount,
        };
      })
      .filter(Boolean);
  }

  function getSelectedRooms() {
    var rooms = collectSelectedOptions("rooms", roomRates, false);
    if (roomExtensionHoursInput?.dataset.packageUnavailable === "true") return rooms;
    var extensionHours = Math.max(0, Number(roomExtensionHoursInput?.value) || 0);
    if (extensionHours > 0) {
      var extensionIncluded = roomExtensionHoursInput?.dataset.packageIncluded === "true";
      var includedQuantity = extensionIncluded
        ? Math.min(extensionHours, Math.max(0, Number(roomExtensionHoursInput?.dataset.packageIncludedQuantity) || extensionHours))
        : 0;
      rooms.push({
        key: roomExtensionOption.key,
        label: roomExtensionOption.label,
        price: roomExtensionOption.price,
        hours: extensionHours,
        included: extensionIncluded,
        includedQuantity: extensionIncluded ? includedQuantity : undefined,
        amount: roomExtensionOption.price * Math.max(0, extensionHours - includedQuantity),
      });
    }
    return rooms;
  }

  function sumAmounts(items) {
    return items.reduce(function (sum, item) {
      return sum + Number(item.amount ?? item.price ?? 0);
    }, 0);
  }

  function fmtDate(str) {
    if (!str) return "N/A";
    var d = new Date(str + "T00:00:00");
    return d.toLocaleDateString("en-PH", {
      year: "numeric",
      month: "long",
      day: "numeric",
    });
  }

  function fmtDateTime(str) {
    if (!str) return "Not specified";
    return new Date(str).toLocaleString("en-PH", {
      year: "numeric",
      month: "short",
      day: "numeric",
      hour: "numeric",
      minute: "2-digit",
    });
  }

  function parseDateOnly(str) {
    if (!str) return null;
    var parts = str.split("-").map(Number);
    return new Date(parts[0], parts[1] - 1, parts[2]);
  }

  function parseDateTimeLocal(str) {
    if (!str) return null;
    var date = new Date(str);
    return Number.isNaN(date.getTime()) ? null : date;
  }

  function formatDateOnly(date) {
    var year = date.getFullYear();
    var month = String(date.getMonth() + 1).padStart(2, "0");
    var day = String(date.getDate()).padStart(2, "0");
    return year + "-" + month + "-" + day;
  }

  var minimumBookingDate = parseDateOnly(initialMinimumBookingDateValue);
  var minimumBookingDateValue = initialMinimumBookingDateValue;
  var unavailableDateMessage = "Selected dates are unavailable. Please choose another date.";
  var availabilityCheckMessage = "We could not verify availability for the selected venue. Please try again.";
  var availabilityCache = {};
  var dateAvailabilityValidationRun = 0;

  function syncDateInputMinimums() {
    var minimumDateTime = minimumBookingDateValue + "T00:00";
    if (startDateTimeInput) startDateTimeInput.min = minimumDateTime;
    if (endDateTimeInput) {
      endDateTimeInput.min = startDateTimeInput?.value || minimumDateTime;
      endDateTimeInput.max = !isMultiDayInput?.checked && getStartDateValue()
        ? getStartDateValue() + "T23:59"
        : "";
    }
  }

  function applyMinimumBookingDateValue(nextMinimumBookingDateValue) {
    var nextMinimumBookingDate = parseDateOnly(nextMinimumBookingDateValue);
    if (!nextMinimumBookingDate || Number.isNaN(nextMinimumBookingDate.getTime())) return;

    minimumBookingDate = nextMinimumBookingDate;
    minimumBookingDateValue = nextMinimumBookingDateValue;
    syncDateInputMinimums();
  }

  applyMinimumBookingDateValue(minimumBookingDateValue);

  function showNotice(msg, type) {
    if (!noticeEl) return;
    noticeEl.className =
      "mb-4 px-4 py-3 rounded-lg text-sm font-semibold flex items-center gap-2 " +
      (type === "success"
        ? "bg-green-100 text-green-800"
        : "bg-red-100 text-red-800");
    noticeEl.textContent = msg;
    noticeEl.classList.remove("hidden");
    noticeEl.scrollIntoView({ behavior: "smooth", block: "nearest" });
  }

  var friendlyRequiredMessages = {
    fullName: "Please enter the primary contact's full name.",
    email: "Please enter the email address where you want to receive booking updates.",
    phone: "Please enter a mobile number where Woodberry can contact you.",
    address: "Please enter your complete home or billing address.",
    startDateTime: "Please choose the event or stay start date and time.",
    endDateTime: "Please choose the stay end date and time.",
    guests: "Please enter the expected number of guests.",
    eventType: "Please choose the type of celebration or event.",
    customEventType: "Please specify the celebration or event type.",
    packageType: "Please choose a booking package.",
    customVenueId: "Please choose an available venue for your custom booking.",
  };

  function getFriendlyFieldMessage(input) {
    if (input.validity.typeMismatch && input.type === "email") {
      return "Please enter a complete email address, such as name@example.com.";
    }
    if (input.validity.tooShort) {
      if (input.id === "phone") return "Please enter a valid mobile number with at least 7 characters.";
      if (input.id === "address") return "Please enter a more complete address, including your city or municipality.";
      return "Please provide a complete value for this field.";
    }
    if (input.validity.rangeUnderflow && input.id === "guests") {
      return "The expected number of guests must be at least 1.";
    }
    if (input.validity.badInput && input.id === "guests") {
      return "Please enter the expected number of guests as a whole number.";
    }
    return friendlyRequiredMessages[input.name] || "Please review this field and enter a valid value.";
  }

  function attachFriendlyValidation() {
    form.querySelectorAll("input, select, textarea").forEach(function (input) {
      input.addEventListener("invalid", function () {
        if (input.hasAttribute("data-availability-invalid")) return;
        input.setCustomValidity(getFriendlyFieldMessage(input));
      });
      ["input", "change"].forEach(function (eventName) {
        input.addEventListener(eventName, function () {
          if (!input.hasAttribute("data-availability-invalid")) input.setCustomValidity("");
        });
      });
    });
  }

  function hideAvailabilityNoticeIfCurrent(message) {
    if (!noticeEl || !noticeEl.textContent.includes(message)) return;
    noticeEl.classList.add("hidden");
  }

  function setDateAvailabilityValidity(message) {
    [startDateTimeInput, endDateTimeInput].filter(Boolean).forEach(function (input) {
      input.setCustomValidity(message || "");
      input.toggleAttribute("data-availability-invalid", !!message);
      input.setAttribute("aria-invalid", message ? "true" : "false");
    });
  }

  function availabilityMonthKey(year, monthIndex) {
    return String(getSelectedPackageId() || getSelectedVenueId() || "all") + "-" + year + "-" + monthIndex;
  }

  function addDateRangeToSet(set, startISO, endISO) {
    var start = parseDateOnly(String(startISO || "").slice(0, 10));
    var end = parseDateOnly(String(endISO || startISO || "").slice(0, 10));
    if (!start || !end || Number.isNaN(start.getTime()) || Number.isNaN(end.getTime())) return;
    for (var day = new Date(start); day <= end; day.setDate(day.getDate() + 1)) {
      set.add(formatDateOnly(day));
    }
  }

  function addBlockedDatesToSet(set, blockedDates) {
    (blockedDates || []).forEach(function (blockedDate) {
      if (typeof blockedDate === "string") {
        set.add(blockedDate.slice(0, 10));
        return;
      }
      var start =
        blockedDate.date ||
        blockedDate.blocked_date ||
        blockedDate.start_date ||
        blockedDate.startDate;
      var end = blockedDate.end_date || blockedDate.endDate || start;
      if (start) addDateRangeToSet(set, start, end);
    });
  }

  async function fetchAvailabilityMonth(year, monthIndex, forceRefresh) {
    var key = availabilityMonthKey(year, monthIndex);
    if (!forceRefresh && availabilityCache[key]) return availabilityCache[key];

    var params = new URLSearchParams({
      year: String(year),
      month: String(monthIndex + 1),
    });
    if (isCustomBooking) {
      if (getSelectedVenueId()) params.set("venueId", getSelectedVenueId());
    } else if (getSelectedPackageId()) {
      params.set("packageId", getSelectedPackageId());
    }

    var response = await fetch("/api/bookings/availability?" + params.toString());
    var payload = await response.json().catch(function () {
      return {};
    });
    if (!response.ok) throw new Error(payload.error || payload.message || availabilityCheckMessage);
    if (payload.minimumBookingDate) applyMinimumBookingDateValue(payload.minimumBookingDate);

    var unavailableDates = new Set();
    (payload.bookings || []).forEach(function (booking) {
      addDateRangeToSet(unavailableDates, booking.start_date, booking.end_date);
      if (booking.event_date) unavailableDates.add(String(booking.event_date).slice(0, 10));
    });
    addBlockedDatesToSet(unavailableDates, payload.blockedDates);

    availabilityCache[key] = unavailableDates;
    return unavailableDates;
  }

  function selectedMonthKeys(startDate, endDate, eventDate) {
    var keys = [];
    var seen = new Set();

    function addMonth(date) {
      var key = date.getFullYear() + "-" + date.getMonth();
      if (seen.has(key)) return;
      seen.add(key);
      keys.push({ year: date.getFullYear(), monthIndex: date.getMonth() });
    }

    var cursor = new Date(startDate.getFullYear(), startDate.getMonth(), 1);
    var last = new Date(endDate.getFullYear(), endDate.getMonth(), 1);
    while (cursor <= last) {
      addMonth(cursor);
      cursor.setMonth(cursor.getMonth() + 1);
    }
    if (eventDate) addMonth(eventDate);

    return keys;
  }

  async function getUnavailableDatesForSelection(startDate, endDate, eventDate, forceRefresh) {
    var unavailableDates = new Set();
    var months = selectedMonthKeys(startDate, endDate, eventDate);
    for (var i = 0; i < months.length; i++) {
      var monthDates = await fetchAvailabilityMonth(
        months[i].year,
        months[i].monthIndex,
        forceRefresh,
      );
      monthDates.forEach(function (date) {
        unavailableDates.add(date);
      });
    }
    return unavailableDates;
  }

  function selectionOverlapsUnavailableDates(startDate, endDate, eventDate, unavailableDates) {
    for (var day = new Date(startDate); day <= endDate; day.setDate(day.getDate() + 1)) {
      if (day < minimumBookingDate || unavailableDates.has(formatDateOnly(day))) return true;
    }
    return !!eventDate && (eventDate < minimumBookingDate || unavailableDates.has(formatDateOnly(eventDate)));
  }

  async function validateSelectedAvailability(showMessage, forceRefresh) {
    var run = ++dateAvailabilityValidationRun;
    setDateAvailabilityValidity("");

    if (isCustomBooking && !getSelectedVenueId()) return true;

    var selectedStartDate = parseDateOnly(getStartDateValue());
    var selectedEndDate = parseDateOnly(getEndDateValue());
    var selectedEventDate = selectedStartDate;
    if (!selectedStartDate || !selectedEndDate || !selectedEventDate) return true;
    if (selectedEndDate < selectedStartDate) return true;

    try {
      var unavailableDates = await getUnavailableDatesForSelection(
        selectedStartDate,
        selectedEndDate,
        selectedEventDate,
        forceRefresh,
      );
      if (run !== dateAvailabilityValidationRun) return true;

      if (
        selectionOverlapsUnavailableDates(
          selectedStartDate,
          selectedEndDate,
          selectedEventDate,
          unavailableDates,
        )
      ) {
        setDateAvailabilityValidity(unavailableDateMessage);
        if (showMessage) showNotice(unavailableDateMessage, "error");
        return false;
      }

      hideAvailabilityNoticeIfCurrent(unavailableDateMessage);
      hideAvailabilityNoticeIfCurrent(availabilityCheckMessage);
      return true;
    } catch (availabilityError) {
      if (run !== dateAvailabilityValidationRun) return true;
      setDateAvailabilityValidity(availabilityCheckMessage);
      if (showMessage) showNotice(availabilityCheckMessage, "error");
      return false;
    }
  }

  function calculateNights() {
    var nights = 0;
    if (getStartDateValue() && getEndDateValue()) {
      var checkIn = parseDateOnly(getStartDateValue());
      var checkOut = parseDateOnly(getEndDateValue());
      if (checkIn && checkOut && checkOut > checkIn) {
        nights = Math.ceil((checkOut - checkIn) / 86400000);
      }
    }

    var selectedPackage = getSelectedPackage();
    var packageBase = selectedPackage ? selectedPackage.price : 0;
    var selectedRooms = getSelectedRooms();
    var selectedAddOns = collectSelectedOptions("add-ons", addOnOptions, false);
    var selectedExtensions = collectSelectedOptions("extensions", extensionOptions, true);
    var selectedCorkage = collectSelectedOptions("corkage", corkageOptions, false);
    var customItems = collectCustomServiceSelections();
    var selectedOptionItems = selectedRooms.concat(selectedAddOns, selectedExtensions, selectedCorkage, customItems);
    var roomsTotal = sumAmounts(selectedRooms);
    var addOnsTotal = sumAmounts(selectedAddOns);
    var extensionsTotal = sumAmounts(selectedExtensions);
    var corkageTotal = sumAmounts(selectedCorkage);
    var roughAdditionsTotal = roomsTotal + addOnsTotal + extensionsTotal + corkageTotal;
    var total = packageBase + roughAdditionsTotal;
    var minimumPayment = total * 0.5;
    var remainingBalance = total - minimumPayment;

    if (isCustomBooking) {
      optionalExtrasDisplay.textContent = formatCurrency(roughAdditionsTotal);
      if (packageBaseDisplay) packageBaseDisplay.textContent = "Determined after request review";
      totalPriceEl.textContent = "Subject to admin review";
      minimumPaymentEl.textContent = "Determined after admin review";
      remainingBalanceEl.textContent = "Subject to admin review";
    } else {
      optionalExtrasDisplay.textContent = formatCurrency(roomsTotal + addOnsTotal + extensionsTotal + corkageTotal);
      if (packageBaseDisplay) packageBaseDisplay.textContent = selectedPackage ? formatCurrency(packageBase) : "Select a package";
      totalPriceEl.textContent = formatCurrency(total);
      minimumPaymentEl.textContent = formatCurrency(minimumPayment);
      remainingBalanceEl.textContent = formatCurrency(remainingBalance);
    }

    return {
      nights: nights,
      total: isCustomBooking ? 0 : total,
      packageBase: isCustomBooking ? 0 : packageBase,
      roomsTotal: roomsTotal,
      addOnsTotal: addOnsTotal,
      extensionsTotal: extensionsTotal,
      corkageTotal: corkageTotal,
      roughAdditionsTotal: roughAdditionsTotal,
      minimumPayment: isCustomBooking ? 0 : minimumPayment,
      remainingBalance: isCustomBooking ? 0 : remainingBalance,
      selectedRooms: selectedRooms,
      selectedAddOns: selectedAddOns,
      selectedExtensions: selectedExtensions,
      selectedCorkage: selectedCorkage,
      customItems: customItems,
      selectedOptionItems: selectedOptionItems,
    };
  }

  function applySelectedPackage() {
    applyPackageBookingDefaults(getSelectedPackage());
    validatePackagePax(false);
  }

  function validatePackagePax(showMessage) {
    var selectedPackage = getSelectedPackage();
    var guestsInput = document.getElementById("guests");
    var pax = Number(guestsInput?.value) || 0;
    if (isCustomBooking) {
      var selectedVenue = getCustomVenueById(getSelectedVenueId());
      if (!selectedVenue) {
        if (showMessage) showNotice("Please choose an available venue for your custom booking.", "error");
        return false;
      }
      var capacity = Number(selectedVenue.capacity) || 0;
      var customValid = !capacity || !pax || pax <= capacity;
      if (packageLimitNotice) {
        packageLimitNotice.classList.toggle("hidden", customValid || !capacity || !pax);
        if (!customValid) {
          packageLimitNotice.textContent =
            selectedVenue.name +
            " can accommodate up to " +
            capacity +
            " guests. Please adjust the guest count or choose another venue.";
        }
      }
      if (!customValid && showMessage) {
        showNotice(
          selectedVenue.name +
            " can accommodate up to " +
            capacity +
            " guests. Please adjust the guest count or choose another venue.",
          "error",
        );
      }
      return customValid;
    }
    var valid = !!selectedPackage && pax >= selectedPackage.minPax && pax <= selectedPackage.maxPax;
    if (packageLimitNotice) {
      packageLimitNotice.classList.toggle("hidden", valid || !selectedPackage || !pax);
      if (selectedPackage && pax) {
        packageLimitNotice.textContent =
          selectedPackage.name +
          " allows " +
          selectedPackage.minPax +
          "-" +
          selectedPackage.maxPax +
          " guests. Please adjust the guest count or choose another package.";
      }
    }
    if (!valid && showMessage) {
      if (!selectedPackage) {
        showNotice("Please choose a Woodberry package.", "error");
      } else {
        showNotice(
          selectedPackage.name +
            " allows " +
            selectedPackage.minPax +
            "-" +
            selectedPackage.maxPax +
            " guests. Please adjust the guest count or choose another package.",
          "error",
        );
      }
    }
    return valid;
  }

  function syncCaterer() {
    if (!catererInput || !useWoodberryCatererInput) return;
    if (useWoodberryCatererInput.checked) {
      catererInput.value = woodberryCatererName;
      catererInput.disabled = true;
    } else {
      catererInput.disabled = false;
      if (catererInput.value === woodberryCatererName) catererInput.value = "";
    }
  }

  function getEventTypeLabel() {
    var eventType = document.getElementById("eventType");
    if (!eventType || !eventType.value) return "N/A";
    if (eventType.value === "other") {
      return customEventTypeInput?.value.trim() || "Other";
    }
    return eventType.options[eventType.selectedIndex].textContent || eventType.value;
  }

  function getNotificationPreference() {
    var selected = document.querySelector('input[name="notificationPreference"]:checked');
    return selected ? selected.value : "both";
  }

  function getNotificationPreferenceLabel() {
    var preference = getNotificationPreference();
    if (preference === "email") return "Email only";
    if (preference === "sms") return "SMS only";
    return "Both email and SMS";
  }

  function getSuccessNotificationMessage(preference) {
    if (preference === "email") {
      return "You chose email only. We will send confirmations, schedules, reminders, and important booking updates to your email address.";
    }
    if (preference === "sms") {
      return "You chose SMS only. We will send confirmations, schedules, reminders, and important booking updates to your mobile number.";
    }
    return "You chose both email and SMS. We will send confirmations, schedules, reminders, and important booking updates by email and SMS.";
  }

  function validatePackageSchedule(showMessage) {
    var selectedPackage = getSelectedPackage();
    var timeOptions = selectedPackage?.timeOptions;
    if (
      isCustomBooking ||
      !timeOptions ||
      typeof timeOptions !== "object" ||
      !["fixed_range", "duration", "range_duration"].includes(timeOptions.mode)
    ) {
      return true;
    }

    var selectedStart = parseDateTimeLocal(startDateTimeInput?.value || "");
    var selectedEnd = parseDateTimeLocal(endDateTimeInput?.value || "");
    if (!selectedStart || !selectedEnd || selectedEnd <= selectedStart) return true;

    if (timeOptions.mode === "fixed_range" || timeOptions.mode === "range_duration") {
      var fromMinutes = timeToMinutes(timeOptions.from_time);
      var toMinutes = timeToMinutes(timeOptions.to_time);
      if (fromMinutes === null || toMinutes === null || fromMinutes === toMinutes) return true;
      var rangeMinutes = toMinutes > fromMinutes
        ? toMinutes - fromMinutes
        : 24 * 60 - fromMinutes + toMinutes;
      var selectedStartMinutes = selectedStart.getTime() / 60000;
      var selectedEndMinutes = selectedEnd.getTime() / 60000;
      var startOfSelectedDay = new Date(
        selectedStart.getFullYear(),
        selectedStart.getMonth(),
        selectedStart.getDate(),
      ).getTime() / 60000;
      var fitsRange = [startOfSelectedDay, startOfSelectedDay - 24 * 60].some(function (dayStart) {
        var windowStart = dayStart + fromMinutes;
        var windowEnd = windowStart + rangeMinutes;
        return selectedStartMinutes >= windowStart && selectedEndMinutes <= windowEnd;
      });
      if (!fitsRange) {
        if (showMessage) {
          showNotice(
            "The selected start and end must fit within the package time range (" +
              timeOptions.from_time + "-" + timeOptions.to_time + ").",
            "error",
          );
        }
        return false;
      }
    }

    if (timeOptions.mode === "duration" || timeOptions.mode === "range_duration") {
      var requiredMinutes = Math.round(Number(timeOptions.hours) * 60);
      if (!Number.isFinite(requiredMinutes) || requiredMinutes <= 0) return true;
      var actualMinutes = Math.round((selectedEnd.getTime() - selectedStart.getTime()) / 60000);
      if (actualMinutes !== requiredMinutes) {
        if (showMessage) {
          showNotice(
            "This package requires a booking duration of exactly " + formatDurationHours(timeOptions.hours) + ".",
            "error",
          );
        }
        return false;
      }
    }
    return true;
  }

  function timeToMinutes(value) {
    if (typeof value !== "string" || !/^([01]\d|2[0-3]):[0-5]\d$/.test(value)) return null;
    var parts = value.split(":").map(Number);
    return parts[0] * 60 + parts[1];
  }

  function formatDurationHours(value) {
    var hours = Number(value);
    return hours + " " + (hours === 1 ? "hour" : "hours");
  }

  function populateOptionSummary(items) {
    var wrap = document.getElementById("conf-additionals");
    if (!wrap) return;
    wrap.innerHTML = "";

    if (!items.length) {
      var empty = document.createElement("div");
      empty.className = "booking-summary-card booking-summary-card--empty";
      empty.textContent = "No optional rooms, add-ons, extensions, or corkage selected.";
      wrap.appendChild(empty);
      return;
    }

    items.forEach(function (item) {
      var card = document.createElement("div");
      card.className = "booking-summary-card";
      var title = document.createElement("p");
      title.className = "font-semibold";
      title.textContent = (item.category ? item.category + ": " : "") + item.label;
      card.appendChild(title);
      var meta = document.createElement("p");
      meta.className = "booking-summary-card__meta";
      var requestedUnits = item.hours
        ? item.hours + (item.unit === "block" ? " guest-capacity block" : " extra hour") + (item.hours === 1 ? "" : "s") + " - "
        : "";
      var includedUnits = item.includedQuantity
        ? item.includedQuantity + (item.unit === "block" ? " included block" : " included hour") + (item.includedQuantity === 1 ? "" : "s") + " - "
        : "";
      meta.textContent = isCustomBooking
        ? requestedUnits + "Rough estimate: " + formatCurrency(item.amount ?? item.price)
        : item.included
          ? includedUnits + (Number(item.amount) > 0 ? formatCurrency(item.amount) + " extra" : "Included in selected package")
          : requestedUnits + formatCurrency(item.amount ?? item.price);
      card.appendChild(meta);
      wrap.appendChild(card);
    });
  }

  startDateTimeInput.addEventListener("change", async function () {
    syncDateInputMinimums();
    calculateNights();
    if (isCustomBooking) await refreshCustomVenueAvailability(true);
    await validateSelectedAvailability(true, false);
  });
  endDateTimeInput.addEventListener("change", async function () {
    calculateNights();
    if (isCustomBooking) await refreshCustomVenueAvailability(true);
    await validateSelectedAvailability(true, false);
  });
  isMultiDayInput.addEventListener("change", async function () {
    syncDateTimeMode();
    calculateNights();
    if (isCustomBooking) await refreshCustomVenueAvailability(true);
    await validateSelectedAvailability(true, false);
  });
  eventTypeInput.addEventListener("change", syncCustomEventType);
  useAccountDetailsInput.addEventListener("change", fillAccountDetails);
  document.getElementById("guests").addEventListener("input", function () {
    validatePackagePax(false);
    calculateNights();
  });
  useWoodberryCatererInput.addEventListener("change", syncCaterer);
  customVenueSelect?.addEventListener("change", async function () {
    renderCustomVenueDetails();
    validatePackagePax(false);
    await validateSelectedAvailability(true, true);
  });
  customOtherRequestInput?.addEventListener("input", calculateNights);

  async function validateMainForm(forceAvailabilityRefresh) {
    setDateAvailabilityValidity("");
    if (noticeEl) noticeEl.classList.add("hidden");

    form.querySelectorAll("input, select, textarea").forEach(function (input) {
      if (!input.hasAttribute("data-availability-invalid")) input.setCustomValidity("");
    });

    if (!form.checkValidity()) {
      var firstInvalidField = form.querySelector(":invalid");
      var invalidStep = firstInvalidField?.closest("[data-booking-step]");
      if (invalidStep) goToBookingStep(Number(invalidStep.dataset.bookingStep), false);
      showNotice(
        firstInvalidField?.validationMessage || "Please complete all required booking details.",
        "error",
      );
      form.reportValidity();
      firstInvalidField?.focus();
      return false;
    }

    var selectedStartDate = parseDateOnly(getStartDateValue());
    var selectedEndDate = parseDateOnly(getEndDateValue());
    var selectedEventDate = selectedStartDate;

    if (
      !selectedStartDate ||
      !selectedEndDate ||
      !selectedEventDate ||
      selectedStartDate < minimumBookingDate ||
      selectedEndDate < minimumBookingDate
    ) {
      goToBookingStep(1, false);
      showNotice("Bookings must be made at least 1 week in advance.", "error");
      return false;
    }

    if (isMultiDayInput.checked) {
      if (selectedEndDate <= selectedStartDate) {
        goToBookingStep(1, false);
        showNotice("A multi-day stay must end on a later calendar date.", "error");
        return false;
      }
      var selectedStartDateTime = parseDateTimeLocal(startDateTimeInput.value);
      var selectedEndDateTime = parseDateTimeLocal(endDateTimeInput.value);
      if (!selectedStartDateTime || !selectedEndDateTime || selectedEndDateTime <= selectedStartDateTime) {
        goToBookingStep(1, false);
        showNotice("Stay end date and time must be after the start date and time.", "error");
        return false;
      }
    }
    if (!isMultiDayInput.checked && selectedEndDate.getTime() !== selectedStartDate.getTime()) {
      goToBookingStep(1, false);
      showNotice("A single-day booking must start and end on the same calendar date.", "error");
      endDateTimeInput.focus();
      return false;
    }
    var selectedStartDateTime = parseDateTimeLocal(startDateTimeInput.value);
    var selectedEndDateTime = parseDateTimeLocal(endDateTimeInput.value);
    if (!selectedStartDateTime || !selectedEndDateTime || selectedEndDateTime <= selectedStartDateTime) {
      goToBookingStep(1, false);
      showNotice("Booking end date and time must be after the start date and time.", "error");
      endDateTimeInput.focus();
      return false;
    }

    if (isCustomBooking && !(await refreshCustomVenueAvailability(true))) {
      goToBookingStep(1, false);
      return false;
    }
    if (!validatePackagePax(true)) {
      goToBookingStep(1, false);
      return false;
    }
    if (!validatePackageSchedule(true)) {
      goToBookingStep(1, false);
      startDateTimeInput.focus();
      return false;
    }
    if (!(await validateSelectedAvailability(true, !!forceAvailabilityRefresh))) {
      goToBookingStep(1, false);
      return false;
    }

    return true;
  }

  function validateCurrentStepControls(stepIndex) {
    var step = bookingSteps[stepIndex];
    if (!step) return true;
    var controls = Array.from(step.querySelectorAll("input, select, textarea"));
    var firstInvalidField = controls.find(function (input) {
      return !input.disabled && !input.checkValidity();
    });
    if (!firstInvalidField) return true;

    showNotice(firstInvalidField.validationMessage || "Please complete this step before continuing.", "error");
    firstInvalidField.reportValidity();
    firstInvalidField.focus();
    return false;
  }

  async function validateBookingStep(stepIndex) {
    if (noticeEl) noticeEl.classList.add("hidden");
    if (stepIndex === 1) setDateAvailabilityValidity("");
    if (!validateCurrentStepControls(stepIndex)) return false;
    if (stepIndex !== 1) return true;

    var selectedStartDate = parseDateOnly(getStartDateValue());
    var selectedEndDate = parseDateOnly(getEndDateValue());
    if (!selectedStartDate || !selectedEndDate || selectedStartDate < minimumBookingDate) {
      showNotice("Bookings must be made at least 1 week in advance.", "error");
      startDateTimeInput.focus();
      return false;
    }
    if (isMultiDayInput.checked && selectedEndDate <= selectedStartDate) {
      showNotice("A multi-day stay must end on a later calendar date.", "error");
      endDateTimeInput.focus();
      return false;
    }
    if (isMultiDayInput.checked) {
      var selectedStartDateTime = parseDateTimeLocal(startDateTimeInput.value);
      var selectedEndDateTime = parseDateTimeLocal(endDateTimeInput.value);
      if (!selectedStartDateTime || !selectedEndDateTime || selectedEndDateTime <= selectedStartDateTime) {
        showNotice("Stay end date and time must be after the start date and time.", "error");
        endDateTimeInput.focus();
        return false;
      }
    }
    if (!isMultiDayInput.checked && selectedEndDate.getTime() !== selectedStartDate.getTime()) {
      showNotice("A single-day booking must start and end on the same calendar date.", "error");
      endDateTimeInput.focus();
      return false;
    }
    var selectedStartDateTime = parseDateTimeLocal(startDateTimeInput.value);
    var selectedEndDateTime = parseDateTimeLocal(endDateTimeInput.value);
    if (!selectedStartDateTime || !selectedEndDateTime || selectedEndDateTime <= selectedStartDateTime) {
      showNotice("Booking end date and time must be after the start date and time.", "error");
      endDateTimeInput.focus();
      return false;
    }
    if (isCustomBooking && !(await refreshCustomVenueAvailability(true))) return false;
    if (!validatePackagePax(true)) return false;
    if (!validatePackageSchedule(true)) {
      startDateTimeInput.focus();
      return false;
    }
    return validateSelectedAvailability(true, false);
  }

  bookingBackBtn?.addEventListener("click", function () {
    goToBookingStep(currentBookingStep - 1, true);
  });

  bookingNextBtn?.addEventListener("click", async function () {
    if (bookingNextBtn.disabled) return;
    bookingNextBtn.disabled = true;
    bookingNextBtn.textContent = "Checking this step...";
    try {
      if (!(await validateBookingStep(currentBookingStep))) return;
      maximumVisitedStep = Math.max(maximumVisitedStep, currentBookingStep + 1);
      goToBookingStep(currentBookingStep + 1, true);
    } finally {
      bookingNextBtn.disabled = false;
      if (!bookingNextBtn.hidden) {
        bookingNextBtn.textContent = "Next: " + bookingStepLabels[currentBookingStep + 1];
      }
    }
  });

  bookingStepTriggers.forEach(function (trigger) {
    trigger.addEventListener("click", async function () {
      var targetStep = Number(trigger.dataset.stepTarget);
      if (targetStep > maximumVisitedStep || targetStep === currentBookingStep) return;
      if (targetStep > currentBookingStep && !(await validateBookingStep(currentBookingStep))) return;
      goToBookingStep(targetStep, true);
    });
  });

  function openConfirmationModal() {
    var totals = calculateNights();
    var catererValue = catererInput.value.trim() || "N/A";
    var selectedPackage = getSelectedPackage();
    var selectedVenue = isCustomBooking ? getCustomVenueById(getSelectedVenueId()) : null;

    document.getElementById("conf-venue").textContent = isCustomBooking
      ? (selectedVenue?.name || "Selected venue")
      : selectedPackage?.name || venueName || "Woodberry package";
    document.getElementById("conf-name").textContent =
      document.getElementById("fullName").value || "N/A";
    document.getElementById("conf-phone").textContent =
      document.getElementById("phone").value || "N/A";
    document.getElementById("conf-email").textContent =
      document.getElementById("email").value || "N/A";
    document.getElementById("conf-address").textContent = addressInput.value || "N/A";
    document.getElementById("conf-notifications").textContent =
      getNotificationPreferenceLabel();
    document.getElementById("conf-checkin").textContent = fmtDateTime(startDateTimeInput.value);
    document.getElementById("conf-checkout").textContent = fmtDateTime(endDateTimeInput.value);
    document.getElementById("conf-eventdate").textContent = fmtDate(getStartDateValue());
    document.getElementById("conf-guests").textContent =
      document.getElementById("guests").value + " guests";
    document.getElementById("conf-eventtype").textContent = getEventTypeLabel();
    document.getElementById("conf-nights").textContent = isMultiDayInput.checked
      ? totals.nights + " night" + (totals.nights !== 1 ? "s" : "")
      : "Single event";
    document.getElementById("conf-caterer").textContent = catererValue;
    document.getElementById("conf-package-name").textContent =
      isCustomBooking ? CUSTOM_BOOKING_NAME : selectedPackage?.name || "Woodberry package";
    document.getElementById("conf-package-price").textContent = isCustomBooking
      ? "No fixed preset package price"
      : formatCurrency(selectedPackage?.price || 0);
    document.getElementById("conf-package-duration").textContent =
      selectedPackage?.duration || "N/A";
    document.getElementById("conf-package-schedule").textContent =
      selectedPackage?.schedule || "N/A";
    document.getElementById("conf-package-capacity").textContent = selectedPackage
      ? isCustomBooking && selectedVenue?.capacity
        ? "Up to " + selectedVenue.capacity + " guests"
        : selectedPackage.minPax + "-" + selectedPackage.maxPax + " guests"
      : "N/A";
    document.getElementById("conf-package-included").textContent =
      isCustomBooking
        ? "Optional selections are listed below; final pricing will be reviewed by Woodberry staff."
        : selectedPackage?.inclusions.join(", ") || "N/A";
    document.getElementById("conf-total").textContent = isCustomBooking
      ? formatCurrency(totals.roughAdditionsTotal)
      : formatCurrency(totals.total);
    document.getElementById("conf-minimum-payment").textContent = isCustomBooking
      ? "Determined after admin review"
      : formatCurrency(totals.minimumPayment);
    document.getElementById("conf-remaining-balance").textContent = isCustomBooking
      ? "Subject to admin review"
      : formatCurrency(totals.remainingBalance);
    populateOptionSummary(
      isCustomBooking
        ? totals.selectedRooms.map(function (item) { return Object.assign({}, item, { category: "Room" }); })
          .concat(totals.selectedAddOns.map(function (item) { return Object.assign({}, item, { category: "Add-on" }); }))
          .concat(totals.selectedExtensions.map(function (item) { return Object.assign({}, item, { category: "Extension" }); }))
          .concat(totals.selectedCorkage.map(function (item) { return Object.assign({}, item, { category: "Corkage" }); }))
          .concat(totals.customItems.map(function (item) { return Object.assign({}, item, { category: item.group || "Custom" }); }))
        : totals.selectedRooms.map(function (item) { return Object.assign({}, item, { category: "Room" }); })
          .concat(totals.selectedAddOns.map(function (item) { return Object.assign({}, item, { category: "Add-on" }); }))
          .concat(totals.selectedExtensions.map(function (item) { return Object.assign({}, item, { category: "Extension" }); }))
          .concat(totals.selectedCorkage.map(function (item) { return Object.assign({}, item, { category: "Corkage" }); })),
    );

    var requests = [
      document.getElementById("specialRequests").value,
      isCustomBooking && customOtherRequestInput?.value.trim()
        ? "Other custom request: " + customOtherRequestInput.value.trim()
        : "",
    ].filter(Boolean).join("\n\n");
    var reqWrap = document.getElementById("conf-requests-wrap");
    if (requests) {
      document.getElementById("conf-requests").textContent = requests;
      reqWrap.classList.remove("hidden");
    } else {
      reqWrap.classList.add("hidden");
    }

    confirmModal.classList.remove("hidden");
  }

  form.addEventListener("submit", async function (e) {
    e.preventDefault();
    if (isSubmitting || submitBtn.disabled) return;
    submitBtn.disabled = true;
    submitBtn.textContent = "Checking booking details...";
    try {
      if (!(await validateMainForm(false))) return;
      termsModal.classList.remove("hidden");
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = "Review Terms and Conditions";
    }
  });

  termsBackBtn.addEventListener("click", function () {
    termsModal.classList.add("hidden");
  });

  termsModal.addEventListener("click", function (e) {
    if (e.target === termsModal) termsModal.classList.add("hidden");
  });

  termsContinueBtn.addEventListener("click", async function () {
    if (isSubmitting || termsContinueBtn.disabled) return;
    if (noticeEl) noticeEl.classList.add("hidden");

    if (!termsAcceptedInput.checked) {
      showNotice(
        "Please check the box to confirm that you have read and agree to the Terms and Conditions.",
        "error",
      );
      termsAcceptedInput.focus();
      return;
    }

    termsContinueBtn.disabled = true;
    termsContinueBtn.textContent = "Preparing summary...";
    try {
      if (!(await validateMainForm(false))) return;
      termsModal.classList.add("hidden");
      openConfirmationModal();
    } finally {
      termsContinueBtn.disabled = false;
      termsContinueBtn.textContent = "Continue to Review Booking";
    }
  });

  confBackBtn.addEventListener("click", function () {
    confirmModal.classList.add("hidden");
  });

  confirmModal.addEventListener("click", function (e) {
    if (e.target === confirmModal) confirmModal.classList.add("hidden");
  });

  confSubmitBtn.addEventListener("click", async function () {
    if (isSubmitting) return;
    if (confirmationError) confirmationError.classList.add("hidden");
    if (!termsAcceptedInput.checked) {
      showNotice(
        "Please check the box to confirm that you have read and agree to the Terms and Conditions.",
        "error",
      );
      confirmModal.classList.add("hidden");
      termsModal.classList.remove("hidden");
      termsAcceptedInput.focus();
      return;
    }

    isSubmitting = true;
    confSubmitBtn.disabled = true;
    confBackBtn.disabled = true;
    confSubmitBtn.textContent = isCustomBooking ? "Submitting custom request..." : "Creating reservation...";

    if (!(await validateMainForm(true))) {
      isSubmitting = false;
      confSubmitBtn.disabled = false;
      confBackBtn.disabled = false;
      confSubmitBtn.textContent = isCustomBooking ? "Submit Custom Request" : "Create Reservation";
      confirmModal.classList.add("hidden");
      return;
    }

    var totals = calculateNights();
    var catererValue = catererInput.value.trim();
    var selectedPackage = getSelectedPackage();

    var formData = {
      venueId: getSelectedVenueId(),
      isMultiDay: isMultiDayInput.checked,
      startDateTime: startDateTimeInput.value,
      endDateTime: endDateTimeInput.value,
      fullName: document.getElementById("fullName").value,
      email: document.getElementById("email").value,
      phone: document.getElementById("phone").value,
      pax: parseInt(document.getElementById("guests").value) || null,
      eventType: document.getElementById("eventType").value || null,
      customEventType: customEventTypeInput.value.trim() || null,
      packageType: isCustomBooking ? CUSTOM_BOOKING_TYPE : selectedPackage?.type,
      packageId: isCustomBooking ? null : selectedPackage?.id || packageId || null,
      packagePrice: totals.packageBase,
      specialRequests: document.getElementById("specialRequests").value || null,
      notificationPreference: getNotificationPreference(),
      address: addressInput.value || null,
      caterer: useWoodberryCatererInput.checked ? woodberryCatererName : catererValue || null,
      useWoodberryCaterer: useWoodberryCatererInput.checked,
      selectedRooms: totals.selectedRooms,
      addOns: totals.selectedAddOns,
      extensionSelections: totals.selectedExtensions,
      corkageSelections: totals.selectedCorkage,
      customItems: totals.customItems,
      customOtherRequest: isCustomBooking ? customOtherRequestInput?.value.trim() || null : null,
      estimateSummary: {
        packageBase: totals.packageBase,
        rooms: totals.roomsTotal,
        addOns: totals.addOnsTotal,
        extensions: totals.extensionsTotal,
        corkage: totals.corkageTotal,
        total: totals.total,
        minimumPayment: totals.minimumPayment,
        remainingBalance: totals.remainingBalance,
        roughAdditionsTotal: totals.roughAdditionsTotal,
      },
      minimumPaymentAmount: totals.minimumPayment,
      remainingBalanceAmount: totals.remainingBalance,
      termsAccepted: termsAcceptedInput.checked,
    };

    var submissionSucceeded = false;
    try {
      var response = await fetch("/api/bookings/CreateBookings", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(formData),
      });

      var result = await response.json().catch(function () {
        return {};
      });

      if (response.ok) {
        submissionSucceeded = true;
        confirmModal.classList.add("hidden");
        var submittedPreference = formData.notificationPreference;
        var refId = result.bookingId
          ? result.bookingId.substring(0, 8).toUpperCase()
          : "N/A";
        document.getElementById("success-ref").textContent = "REF-" + refId;
        document.getElementById("success-venue").textContent = isCustomBooking
          ? getCustomVenueById(getSelectedVenueId())?.name || "Custom Booking"
          : selectedPackage?.name || venueName || "";
        document.getElementById("success-dates").textContent =
          fmtDateTime(startDateTimeInput.value) + " to " + fmtDateTime(endDateTimeInput.value);
        var deadlineHelper = reservationDeadlineHelpers();
        var expirationDeadline = result.reservationExpiresAt
          ? deadlineHelper.formatDeadline(result.reservationExpiresAt)
          : "";
        var serverTotalAmount = Number(result.totalPrice ?? 0);
        var serverDownPaymentAmount = Number(result.minimumPaymentAmount ?? 0);
        var paymentSummary = document.getElementById("success-payment-summary");
        var expirationDeadlineEl = document.getElementById("success-expiration-deadline");
        var expirationCountdownEl = document.getElementById("success-expiration-countdown");
        var totalAmountEl = document.getElementById("success-total-amount");
        var downPaymentEl = document.getElementById("success-down-payment");
        var successReservationExpired = false;
        var canPayNow = !isCustomBooking
          && result.paymentAvailable === true
          && Boolean(result.bookingId)
          && Boolean(result.reservationExpiresAt)
          && Number(deadlineHelper.remainingMs(result.reservationExpiresAt)) > 0
          && Number.isFinite(serverTotalAmount)
          && serverTotalAmount > 0
          && Number.isFinite(serverDownPaymentAmount)
          && serverDownPaymentAmount > 0;
        if (paymentSummary) paymentSummary.classList.toggle("hidden", !canPayNow);
        if (expirationDeadlineEl) expirationDeadlineEl.textContent = expirationDeadline || "Deadline unavailable";
        if (expirationCountdownEl) {
          expirationCountdownEl.textContent = canPayNow
            ? deadlineHelper.formatCountdown(deadlineHelper.remainingMs(result.reservationExpiresAt))
            : "";
        }
        if (totalAmountEl) totalAmountEl.textContent = formatCurrency(serverTotalAmount);
        if (downPaymentEl) downPaymentEl.textContent = formatCurrency(serverDownPaymentAmount);
        document.getElementById("success-reservation-expiration").textContent =
          canPayNow && expirationDeadline
            ? "Your reservation is temporarily held until " + expirationDeadline + ". Pay " + formatCurrency(serverDownPaymentAmount) + " to secure your booking."
            : "";
        document.getElementById("success-notification-message").textContent =
          getSuccessNotificationMessage(submittedPreference);
        var successPayNow = document.getElementById("success-pay-now");
        successPaymentProcessing = false;
        if (successPayNow) {
          successPayNow.classList.toggle("hidden", !canPayNow);
          successPayNow.disabled = false;
          successPayNow.textContent = "Pay Now";
          successPayNow.onclick = async function () {
            if (!canPayNow || successReservationExpired || !result.bookingId || successPaymentProcessing) return;
            successPaymentProcessing = true;
            successPayNow.disabled = true;
            successPayNow.textContent = "Opening PayMongo...";
            try {
              var checkoutResponse = await fetch("/api/payments/create-checkout", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ bookingId: result.bookingId }),
              });
              var checkout = await checkoutResponse.json().catch(function () {
                return {};
              });
              if (!checkoutResponse.ok || !checkout.checkoutUrl) {
                throw new Error(checkout.error || checkout.message || "Could not start payment");
              }
              window.location.href = checkout.checkoutUrl;
            } catch (checkoutError) {
              showNotice(
                checkoutError instanceof Error
                  ? checkoutError.message
                  : "Could not start payment. You can still pay from My Bookings.",
                "error",
              );
              successPayNow.disabled = false;
              successPayNow.textContent = "Pay Now";
              successPaymentProcessing = false;
            }
          };
        }
        if (successCountdownTimer) {
          window.clearInterval(successCountdownTimer);
          successCountdownTimer = null;
        }
        if (canPayNow && result.reservationExpiresAt) {
          var updateSuccessCountdown = function () {
            var remainingMs = deadlineHelper.remainingMs(result.reservationExpiresAt);
            if (expirationCountdownEl) expirationCountdownEl.textContent = deadlineHelper.formatCountdown(remainingMs);
            if (remainingMs !== null && remainingMs <= 0) {
              successReservationExpired = true;
              canPayNow = false;
              if (successPayNow) {
                successPayNow.disabled = true;
                successPayNow.classList.add("hidden");
              }
              if (paymentSummary) paymentSummary.classList.add("hidden");
              document.getElementById("success-reservation-expiration").textContent =
                "This payment deadline has passed. Online payment is no longer available for this hold.";
              if (successCountdownTimer) {
                window.clearInterval(successCountdownTimer);
                successCountdownTimer = null;
              }
            }
          };
          updateSuccessCountdown();
          successCountdownTimer = window.setInterval(updateSuccessCountdown, 1000);
        }
        successScreen.classList.remove("hidden");
        form.reset();
        if (notificationPreferenceInputs.length) {
          notificationPreferenceInputs.forEach(function (input) {
            input.checked = input.value === "both";
          });
        }
        syncCaterer();
        selectedPackageType = initialPackageType || "";
        maximumVisitedStep = 0;
        goToBookingStep(0, false);
        if (packageLimitNotice) packageLimitNotice.classList.add("hidden");
        applySelectedPackage();
        calculateNights();
      } else {
        var fallbackMessage = "Please try again.";
        var apiMessage = result.error ?? result.message ?? fallbackMessage;
        if (confirmationError) {
          confirmationError.textContent = apiMessage;
          confirmationError.classList.remove("hidden");
        }
      }
    } catch (err) {
      if (confirmationError) {
        confirmationError.textContent = "We could not submit your request. Please check your connection and try again; your summary is still available.";
        confirmationError.classList.remove("hidden");
      }
    } finally {
      if (!submissionSucceeded) {
        isSubmitting = false;
        confSubmitBtn.disabled = false;
        confBackBtn.disabled = false;
        confSubmitBtn.textContent = isCustomBooking ? "Submit Custom Request" : "Create Reservation";
      }
    }
  });

  renderPackageOptions();
  renderRateOptions();
  if (isCustomBooking) setCustomVenueOptions([], "Choose a booking date to see available venues");
  applySelectedPackage();
  attachFriendlyValidation();
  syncCaterer();
  syncDateTimeMode();
  syncCustomEventType();
  calculateNights();
  goToBookingStep(0, false);
</script>

