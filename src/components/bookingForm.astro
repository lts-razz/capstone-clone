    box-shadow: 0 6px 18px rgba(26, 46, 16, 0.04);
    padding: 1rem;
  }

  .booking-note-field label {
    color: var(--wb-green-dark) !important;
    font-weight: 900 !important;
  }

  .booking-note-field textarea {
    border-color: color-mix(in srgb, var(--wb-earth) 32%, var(--wb-border)) !important;
    background: rgba(255, 255, 255, 0.86) !important;
  }

  .woodberry-package-card,
  .booking-option-card {
    display: flex;
    min-width: 0;
    align-items: flex-start;
    gap: 0.75rem;
    border: 1px solid var(--wb-border);
    border-radius: var(--wb-radius-md);
    background: rgba(255, 255, 255, 0.76);
    cursor: pointer;
    padding: 0.9rem;
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease,
      box-shadow 0.2s ease,
      transform 0.2s ease;
  }

  .booking-option-card {
    display: grid;
    grid-template-columns: 7.25rem minmax(0, 1fr);
    align-items: stretch;
    padding: 0.55rem;
  }

  .booking-option-card__media {
    display: block;
    min-height: 7.5rem;
    overflow: hidden;
    border-radius: calc(var(--wb-radius-md) - 0.25rem);
