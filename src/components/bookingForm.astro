---
import { getMinimumBookingDateValue } from "../lib/bookingDateRules";
import { WOODBERRY_PACKAGES, type WoodberryPackage } from "../lib/woodberryPackages";
import {
  ADD_ON_OPTIONS,
  BOOKING_EVENT_TYPES,
  CORKAGE_OPTIONS,
  EXTENSION_OPTIONS,
  ROOM_EXTENSION_OPTION,
  ROOM_RATE_OPTIONS,
} from "../lib/bookingOptions";

type Props = {
  venueId: string;
  venueName: string;
  packageOptions?: WoodberryPackage[];
  initialPackageType?: string;
  packageId?: string;
  customBooking?: boolean;
  venueOptions?: {
    id: string;
    name: string;
    description: string | null;
    location?: string | null;
    capacity: number | null;
    image_url: string | null;
  }[];
  accountDetails?: {
    fullName?: string;
    email?: string;
    phone?: string;
    address?: string;
  };
};

const {
  venueId,
  venueName,
  packageOptions = WOODBERRY_PACKAGES,
  initialPackageType = "",
  packageId = "",
  customBooking = false,
  venueOptions = [],
  accountDetails = {},
} = Astro.props as Props;
const availablePackageOptions = Array.isArray(packageOptions) ? packageOptions : WOODBERRY_PACKAGES;
const initialMinimumBookingDateValue = getMinimumBookingDateValue();
---

<div
  id="booking-form"
  class="booking-shell"
  data-minimum-booking-date={initialMinimumBookingDateValue}
  data-package-options={JSON.stringify(availablePackageOptions)}
  data-custom-booking={String(customBooking)}
  data-venue-options={JSON.stringify(venueOptions)}
  data-account-details={JSON.stringify(accountDetails)}
>
  <div class="booking-form__header">
    <p class="booking-form__eyebrow">{customBooking ? "Custom Booking" : "Booking Request"}</p>
    <h2>{customBooking ? "Build Your Own Woodberry Request" : "Plan Your Woodberry Booking"}</h2>
    <p>
      {customBooking
        ? "Choose your preferred schedule, available venue, and custom items or services. Final pricing will be reviewed by Woodberry staff."
        : "Share the details for your celebration, choose a package and any optional extras, then review everything before submitting your request."}
    </p>
  </div>

  {customBooking && (
    <div class="booking-guidance-card" role="note">
      <strong>Rough pricing notice</strong>
      <span>Prices shown for additional selections are rough estimates only. Final additional charges and required payment will be reviewed and determined by the Woodberry admin team after your request is submitted.</span>
    </div>
  )}

  <!-- Notification banner -->
  <div
    id="bookingNotice"
    class="hidden mb-4 px-4 py-3 rounded-lg text-sm font-semibold flex items-center gap-2"
  >
  </div>

  <nav class="booking-stepper" aria-label="Booking form progress">
    <div class="booking-stepper__track" aria-hidden="true">
      <span id="bookingStepProgress"></span>
    </div>
    <ol>
      <li>
        <button type="button" class="booking-step-trigger is-current" data-step-target="0" aria-current="step">
          <span class="booking-step-trigger__number">1</span>
          <span class="booking-step-trigger__label">Client Details</span>
        </button>
      </li>
      <li>
        <button type="button" class="booking-step-trigger" data-step-target="1" disabled>
          <span class="booking-step-trigger__number">2</span>
          <span class="booking-step-trigger__label">Date &amp; Venue</span>
        </button>
      </li>
      <li>
        <button type="button" class="booking-step-trigger" data-step-target="2" disabled>
          <span class="booking-step-trigger__number">3</span>
          <span class="booking-step-trigger__label">Celebration Details</span>
        </button>
      </li>
      <li>
        <button type="button" class="booking-step-trigger" data-step-target="3" disabled>
          <span class="booking-step-trigger__number">4</span>
          <span class="booking-step-trigger__label">Optionals</span>
        </button>
      </li>
      <li>
        <button type="button" class="booking-step-trigger" data-step-target="4" disabled>
          <span class="booking-step-trigger__number">5</span>
          <span class="booking-step-trigger__label">Review &amp; Submit</span>
        </button>
      </li>
    </ol>
    <p id="bookingStepStatus" class="booking-stepper__status" aria-live="polite">
      Step 1 of 5 — Client Details
    </p>
  </nav>

  <form id="bookingForm" class="booking-flow">
    <!-- Guest Information -->
    <section class="booking-step space-y-4" data-booking-step="0" aria-labelledby="booking-step-client-title">
      <h3 id="booking-step-client-title" tabindex="-1" class="text-lg font-semibold" style="color: var(--lion-primary);">
        Client Details
      </h3>
      <p class="booking-step__intro">{customBooking ? "Tell us who to contact about this custom booking request and where to send updates." : "Tell us who to contact about this reservation and where to send updates."}</p>
      <label class="account-details-option" for="useAccountDetails">
        <input
          type="checkbox"
          id="useAccountDetails"
          class="h-4 w-4 rounded border-gray-300 text-amber-500 focus:ring-amber-400"
        />
        <span>
          <strong>Use my account details</strong>
          <small>Fill available contact details from your signed-in account. You can review and edit them before submitting.</small>
        </span>
      </label>
      <div>
        <label
          for="fullName"
          class="block text-sm font-medium mb-2"
          style="color: var(--jet-primary);">Primary Contact's Full Name *</label
        >
        <input
          type="text"
          id="fullName"
          name="fullName"
          required
          autocomplete="name"
          placeholder="First and last name"
          minlength="2"
          maxlength="200"
          class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-amber-400 transition-all"
        />
      </div>
      <div>
        <label
          for="email"
          class="block text-sm font-medium mb-2"
          style="color: var(--jet-primary);">Email Address for Booking Updates *</label
        >
        <input
          type="email"
          id="email"
          name="email"
          required
          autocomplete="email"
          placeholder="you@example.com"
          maxlength="254"
          class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-amber-400 transition-all"
        />
      </div>
      <div>
        <label
          for="phone"
          class="block text-sm font-medium mb-2"
          style="color: var(--jet-primary);">Mobile Number for Booking Updates *</label
        >
        <input
          type="tel"
          id="phone"
          name="phone"
          required
          autocomplete="tel"
          placeholder="e.g. 0917 123 4567"
          minlength="7"
          maxlength="30"
          class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-amber-400 transition-all"
        />
      </div>
      <div>
        <label
          for="address"
          class="block text-sm font-medium mb-2"
          style="color: var(--jet-primary);">Home or Billing Address *</label
        >
        <input
          type="text"
          id="address"
          name="address"
          required
          autocomplete="street-address"
          placeholder="House number, street, barangay, city, and province"
          minlength="5"
          maxlength="500"
          class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-amber-400 transition-all"
        />
      </div>
      <fieldset class="notification-preference">
        <legend>Notification preference</legend>
        <p>Choose where we should send confirmations, schedules, reminders, and important booking updates.</p>
        <div class="notification-preference__options" role="radiogroup" aria-label="Notification preference">
          <label class="notification-preference__option">
            <input
              type="radio"
              name="notificationPreference"
              value="email"
              class="notification-preference__input"
            />
            <span class="notification-preference__body">
              <strong>Email only</strong>
              <span>Send booking updates to your email address only.</span>
            </span>
          </label>
          <label class="notification-preference__option">
            <input
              type="radio"
              name="notificationPreference"
              value="sms"
              class="notification-preference__input"
            />
            <span class="notification-preference__body">
              <strong>SMS only</strong>
              <span>Send booking updates to your mobile number only.</span>
            </span>
          </label>
          <label class="notification-preference__option">
            <input
              type="radio"
              name="notificationPreference"
              value="both"
              class="notification-preference__input"
              checked
            />
            <span class="notification-preference__body">
              <strong>Both email and SMS</strong>
              <span>Send every booking update by email and SMS.</span>
            </span>
          </label>
        </div>
      </fieldset>
    </section>

    <!-- Date and venue details -->
    <section class="booking-step space-y-4" data-booking-step="1" aria-labelledby="booking-step-date-title" hidden>
      <h3 id="booking-step-date-title" tabindex="-1" class="text-lg font-semibold" style="color: var(--lion-primary);">
        Date &amp; Venue
      </h3>
      <p class="booking-step__intro">{customBooking ? "Choose the schedule, guest count, and available Woodberry venue for your request." : "Choose the schedule, guest count, and Woodberry package for your event."}</p>
      <p class="text-sm text-gray-600">
        Bookings must be made at least 1 week in advance. Availability is reserved by calendar date: a booking blocks its venue for every full day in the selected date range, regardless of the times entered.
      </p>
      <label class="date-mode-option" for="isMultiDay">
        <input
          type="checkbox"
          id="isMultiDay"
          name="isMultiDay"
          class="h-4 w-4 rounded border-gray-300 text-amber-500 focus:ring-amber-400"
        />
        <span>
          <strong>Staying for multiple days?</strong>
          <small>Choose this for an overnight or multi-day stay.</small>
          <small id="multiDayPackageLock" class="booking-field-package-lock hidden">This setting is locked by the selected package.</small>
        </span>
      </label>
      <div id="bookingDateTimeFields" class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label
            for="startDateTime"
            id="startDateTimeLabel"
            class="block text-sm font-medium mb-2"
            style="color: var(--jet-primary);">Event Start Date and Time *</label
          >
          <input
            type="datetime-local"
            id="startDateTime"
            name="startDateTime"
            required
            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-amber-400 transition-all"
          />
        </div>
        <div id="endDateTimeField">
          <label
            for="endDateTime"
            id="endDateTimeLabel"
            class="block text-sm font-medium mb-2"
            style="color: var(--jet-primary);">Event End Date and Time *</label
          >
          <input
            type="datetime-local"
            id="endDateTime"
            name="endDateTime"
            required
            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-amber-400 transition-all"
          />
        </div>
      </div>
      <div>
        <label
          for="guests"
          class="block text-sm font-medium mb-2"
          style="color: var(--jet-primary);">Expected Number of Guests *</label
        >
        <input
          type="number"
          id="guests"
          name="guests"
          min="1"
          required
          inputmode="numeric"
          placeholder="Enter the expected total"
          class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-amber-400 transition-all"
        />
      </div>
      <div id="customVenueSection" class={customBooking ? "space-y-4 pt-4 border-t border-gray-100" : "hidden"}>
        <div>
          <h4 class="text-base font-semibold" style="color: var(--lion-primary);">
            Available Venue *
          </h4>
          <p class="text-sm text-gray-600">
            Choose your date first. The list below only shows active venues that are available for the selected booking date or date range.
          </p>
        </div>
        <label for="customVenueSelect" class="block text-sm font-medium" style="color: var(--jet-primary);">
          Woodberry venue
        </label>
        <select
          id="customVenueSelect"
          name="customVenueId"
          required={customBooking}
          disabled={!customBooking}
          class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-amber-400 transition-all"
        >
          <option value="">Choose a booking date to see available venues</option>
        </select>
        <p id="customVenueNotice" class="booking-field-package-lock">Venue availability updates after you choose a date.</p>
        <article id="customVenueDetails" class="custom-venue-details hidden" aria-live="polite"></article>
      </div>
      <div class={customBooking ? "hidden" : "space-y-4 pt-4 border-t border-gray-100"}>
        <h4 class="text-base font-semibold" style="color: var(--lion-primary);">
          Booking Package *
        </h4>
        <p class="text-sm text-gray-600">
          Choose one package that fits your group. Each card shows its base
          price, duration, guest limit, schedule, and included facilities.
        </p>
        <div id="packageOptions" class="woodberry-package-grid"></div>
        <p id="packageLimitNotice" class="hidden rounded-lg border border-red-100 bg-red-50 px-4 py-3 text-sm font-semibold text-red-700"></p>
      </div>
    </section>

    <!-- Celebration details -->
    <section class="booking-step space-y-4" data-booking-step="2" aria-labelledby="booking-step-celebration-title" hidden>
      <h3 id="booking-step-celebration-title" tabindex="-1" class="text-lg font-semibold" style="color: var(--lion-primary);">
        Celebration Details
      </h3>
      <p class="booking-step__intro">Share the event type, catering preference, and any notes for the Woodberry team.</p>
      <div>
        <label
          for="eventType"
          class="block text-sm font-medium mb-2"
          style="color: var(--jet-primary);">Type of Celebration or Event *</label
        >
        <select
          id="eventType"
          name="eventType"
          required
          class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-amber-400 transition-all"
        >
          <option value="">Select event type</option>
          {BOOKING_EVENT_TYPES.map((eventType) => (
            <option value={eventType.key}>{eventType.label}</option>
          ))}
        </select>
        <p id="eventTypePackageLock" class="booking-field-package-lock hidden">Some event types are unavailable for the selected package.</p>
      </div>
      <div id="customEventTypeField" class="hidden">
        <label
          for="customEventType"
          class="block text-sm font-medium mb-2"
          style="color: var(--jet-primary);">Please specify the celebration type *</label
        >
        <input
          type="text"
          id="customEventType"
          name="customEventType"
          maxlength="100"
          placeholder="Enter the celebration or event type"
          class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-amber-400 transition-all"
        />
      </div>
      <div class="space-y-3">
        <label
          for="caterer"
          class="block text-sm font-medium mb-2"
          style="color: var(--jet-primary);"
          >Outside Caterer <span class="text-gray-400 font-normal">(optional)</span
          ></label
        >
        <input
          type="text"
          id="caterer"
          name="caterer"
          maxlength="200"
          placeholder="Enter caterer name, if applicable"
          class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-amber-400 transition-all disabled:bg-gray-100 disabled:text-gray-500"
        />
        <label
          for="useWoodberryCaterer"
          class="flex items-center gap-3 rounded-lg border border-gray-200 p-3 text-sm font-medium"
          style="color: var(--jet-primary);"
        >
          <input
            type="checkbox"
            id="useWoodberryCaterer"
            name="useWoodberryCaterer"
            class="h-4 w-4 rounded border-gray-300 text-amber-500 focus:ring-amber-400"
          />
          <span>I would like to use Woodberry's caterer</span>
        </label>
      </div>
      <div class="booking-note-field">
        <label
          for="specialRequests"
          class="block text-sm font-medium mb-2"
          style="color: var(--jet-primary);"
          >Notes or Special Requests <span class="text-gray-400 font-normal"
            >(optional)</span
          ></label
        >
        <textarea
          id="specialRequests"
          name="specialRequests"
          rows="4"
          maxlength="1000"
          placeholder="Tell us about accessibility needs, setup requests, or other important details"
          class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-amber-400 transition-all resize-none"
        ></textarea>
      </div>
    </section>

    <!-- Optional extras -->
    <section class="booking-step space-y-4" data-booking-step="3" aria-labelledby="booking-step-options-title" hidden>
      <h3 id="booking-step-options-title" tabindex="-1" class="text-lg font-semibold" style="color: var(--lion-primary);">
        Optionals
      </h3>
      <p class="booking-step__intro">{customBooking ? "Choose optional rooms, equipment, extra time, or corkage items for staff review. Final pricing is confirmed by Woodberry." : "Add only what your group needs. Every selection updates the estimate without changing current rates."}</p>
      <div class="space-y-5">
        {customBooking && (
          <div class="booking-guidance-card">
            <strong>Quote request only</strong>
            <span>Selections below help the team prepare your quotation. Online payment opens only after staff confirms final pricing.</span>
          </div>
        )}
        <section class="booking-option-section" data-booking-lockout-section="rooms" aria-labelledby="booking-rooms-title">
          <div class="booking-option-section__heading">
            <h4 id="booking-rooms-title">Rooms</h4>
            <a href="/amenities#rooms" class="booking-room-details-link">View room details</a>
          </div>
          <p class="booking-section-lockout-note hidden" data-section-lockout-note>Rooms are not available with the selected package.</p>
          <p>{customBooking ? "Select any rooms you would like included in the request. Each displayed 12-hour room rate is a rough estimate; extra room time is estimated at ₱200 per hour." : "Select any rooms needed in addition to those included in your package. Each listed room rate covers 12 hours. Room-only accommodation does not include pool use, and extra room time costs ₱200 per hour."}</p>
          <div id="roomRateOptions" class="booking-option-grid"></div>
          <div class="booking-option-card booking-option-card--manual">
            <span class="booking-option-card__media" aria-hidden="true">
              <img src={ROOM_EXTENSION_OPTION.image} alt="" loading="lazy" />
            </span>
            <span class="booking-option-card__content">
              <strong>{ROOM_EXTENSION_OPTION.label}</strong>
              <small class="booking-option-card__description">{ROOM_EXTENSION_OPTION.description}</small>
              <small class="booking-option-card__price">&#8369;{ROOM_EXTENSION_OPTION.price.toLocaleString("en-PH")} per extra hour</small>
              <label for="roomExtensionHours" class="booking-option-card__quantity-label">Extra room hours requested</label>
              <input id="roomExtensionHours" type="number" min="0" step="1" value="0" class="booking-option-card__hours booking-option-card__hours--wide" />
              <small id="roomExtensionPackageLock" class="booking-field-package-lock hidden">These hours are locked by the selected package.</small>
            </span>
          </div>
        </section>
        <section class="booking-option-section" data-booking-lockout-section="addOns" aria-labelledby="booking-addons-title">
          <h4 id="booking-addons-title">Equipment and Entertainment Add-ons</h4>
          <p class="booking-section-lockout-note hidden" data-section-lockout-note>Add-ons are not available with the selected package.</p>
          <p>{customBooking ? "Select any Woodberry equipment or entertainment you would like quoted. Each displayed one-time rate is a rough estimate." : "Select any Woodberry equipment or entertainment you want added to your package estimate. Each displayed rate is charged once."}</p>
          <div id="addOnOptions" class="booking-option-grid"></div>
        </section>
        <section class="booking-option-section" data-booking-lockout-section="extensions" aria-labelledby="booking-extensions-title">
          <h4 id="booking-extensions-title">Extra Time and Guest Capacity</h4>
          <p class="booking-section-lockout-note hidden" data-section-lockout-note>Extra time and capacity additions are not available with the selected package.</p>
          <p>Choose an item, then enter the number of extra hours or 50-guest capacity blocks you need. The estimate updates using the displayed per-unit rate.</p>
          <div id="extensionOptions" class="booking-option-grid"></div>
        </section>
        <section class="booking-option-section" data-booking-lockout-section="corkage" aria-labelledby="booking-corkage-title">
          <h4 id="booking-corkage-title">Outside Equipment Corkage Charges</h4>
          <p class="booking-section-lockout-note hidden" data-section-lockout-note>Corkage options are not available with the selected package.</p>
          <p>Select each type of outside equipment you plan to bring. The displayed corkage charge is added once per selected item. There is no corkage fee for food or drinks.</p>
          <div id="corkageOptions" class="booking-option-grid"></div>
        </section>
        <div class="booking-guidance-card booking-guidance-card--warm">
          <strong>Preparation note</strong>
          <span>Caterers and stylists receive 4 hours of preparation time. Extra preparation time costs &#8369;500. Parking and event safety staffing are coordinated during the event.</span>
        </div>
        {customBooking && (
          <div class="booking-note-field">
          <label
            for="customOtherRequest"
            class="block text-sm font-medium mb-2"
            style="color: var(--jet-primary);"
            >Other Request <span class="text-gray-400 font-normal">(optional)</span></label
          >
          <textarea
            id="customOtherRequest"
            name="customOtherRequest"
            rows="3"
            maxlength="1000"
            placeholder="Add any other preferred services, setup details, or quotation notes"
            class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-amber-400 transition-all resize-none"
          ></textarea>
          </div>
        )}
      </div>
    </section>

    <!-- Price Breakdown -->
    <section class="booking-step space-y-4" data-booking-step="4" aria-labelledby="booking-step-review-title" hidden>
      <h3 id="booking-step-review-title" tabindex="-1" class="text-lg font-semibold" style="color: var(--lion-primary);">
        Review &amp; Submit
      </h3>
      <p class="booking-step__intro">{customBooking ? "Review your quote-only request, then read the Terms and Conditions before submitting." : "Review the estimate, then read the Terms and Conditions to open your complete booking summary before submitting."}</p>
      <div class="booking-payment-card" aria-labelledby="booking-estimate-title">
        <div>
          <p class="booking-payment-card__eyebrow">{customBooking ? "Rough price guide" : "Price estimate"}</p>
          <h3 id="booking-estimate-title">{customBooking ? "Review your estimated additions" : "Review your estimated cost"}</h3>
          <p class="booking-payment-card__intro">{customBooking ? "The estimate covers only the priced additions selected below. It is not a package price, final total, or payment request." : "The amount shown is calculated from the selected package and optionals. Woodberry verifies current rates when the temporary reservation is created."}</p>
        </div>
        {customBooking ? (
          <>
            <div class="flex justify-between text-sm">
              <span class="text-gray-600">Rough estimated additions total</span>
              <span id="optionalExtrasDisplay" style="color: var(--butterscotch-primary);">&#8369;0.00</span>
            </div>
            <div class="booking-payment-card__admin-notice">
              <span>Admin-determined payment</span>
              <strong id="packageBaseDisplay">Determined after request review</strong>
              <p>Woodberry admin will review the venue, schedule, selections, and any other requests before setting the required payment.</p>
            </div>
            <div class="flex justify-between font-bold pt-2 border-t border-gray-200" style="color: var(--jet-primary);">
              <span>Final payment / total</span>
              <span id="totalPrice">Subject to admin review</span>
            </div>
            <span id="minimumPayment" class="hidden"></span>
            <span id="remainingBalance" class="hidden"></span>
            <p class="booking-payment-card__authority">The rough additions estimate does not force this request into preset package pricing. Final additional charges and the required payment are determined by Woodberry admin after submission.</p>
          </>
        ) : (
          <>
            <div class="flex justify-between text-sm">
              <span class="text-gray-600">Selected package base</span>
              <span style="color: var(--butterscotch-primary);" id="packageBaseDisplay"></span>
            </div>
            <div class="flex justify-between text-sm">
              <span class="text-gray-600">Optionals</span>
