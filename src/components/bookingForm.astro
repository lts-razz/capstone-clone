<script is:inline define:vars={{
  venueId,
  venueName,
  initialPackageType,
  packageId,
  roomRateCatalog: ROOM_RATE_OPTIONS,
  roomExtensionCatalog: ROOM_EXTENSION_OPTION,
  addOnCatalog: ADD_ON_OPTIONS,
  extensionCatalog: EXTENSION_OPTIONS,
  corkageCatalog: CORKAGE_OPTIONS,
  customBooking,
}}>
  var initialMinimumBookingDateValue =
    document.getElementById("booking-form")?.getAttribute("data-minimum-booking-date") || "";
  var form = document.getElementById("bookingForm");
  var isMultiDayInput = document.getElementById("isMultiDay");
  var startDateTimeInput = document.getElementById("startDateTime");
  var endDateTimeInput = document.getElementById("endDateTime");
  var endDateTimeField = document.getElementById("endDateTimeField");
  var startDateTimeLabel = document.getElementById("startDateTimeLabel");
  var endDateTimeLabel = document.getElementById("endDateTimeLabel");
  var eventTypeInput = document.getElementById("eventType");
  var customEventTypeInput = document.getElementById("customEventType");
  var customEventTypeField = document.getElementById("customEventTypeField");
  var useAccountDetailsInput = document.getElementById("useAccountDetails");
  var termsAcceptedInput = document.getElementById("termsAccepted");
  var addressInput = document.getElementById("address");
  var catererInput = document.getElementById("caterer");
  var useWoodberryCatererInput = document.getElementById("useWoodberryCaterer");
  var optionalExtrasDisplay = document.getElementById("optionalExtrasDisplay");
  var totalPriceEl = document.getElementById("totalPrice");
  var minimumPaymentEl = document.getElementById("minimumPayment");
  var remainingBalanceEl = document.getElementById("remainingBalance");
  var noticeEl = document.getElementById("bookingNotice");
  var notificationPreferenceInputs = document.querySelectorAll(
    'input[name="notificationPreference"]',
  );
  var termsModal = document.getElementById("termsModal");
  var confirmModal = document.getElementById("bookingConfirmModal");
  var successScreen = document.getElementById("bookingSuccessScreen");
  var termsBackBtn = document.getElementById("terms-back-btn");
  var termsContinueBtn = document.getElementById("terms-continue-btn");
  var confBackBtn = document.getElementById("conf-back-btn");
  var confSubmitBtn = document.getElementById("conf-submit-btn");
  var submitBtn = document.getElementById("submitBtn");
  var confirmationError = document.getElementById("confirmationError");
  var isSubmitting = false;
  var successPaymentProcessing = false;
  var successCountdownTimer = null;
  var woodberryCatererName = "Woodberry's Caterer";
  var packageOptionsWrap = document.getElementById("packageOptions");
  var packageLimitNotice = document.getElementById("packageLimitNotice");
  var customVenueSelect = document.getElementById("customVenueSelect");
  var customVenueNotice = document.getElementById("customVenueNotice");
  var customVenueDetails = document.getElementById("customVenueDetails");
  var customOtherRequestInput = document.getElementById("customOtherRequest");
  var roomRateOptionsWrap = document.getElementById("roomRateOptions");
  var addOnOptionsWrap = document.getElementById("addOnOptions");
  var extensionOptionsWrap = document.getElementById("extensionOptions");
  var corkageOptionsWrap = document.getElementById("corkageOptions");
  var roomExtensionHoursInput = document.getElementById("roomExtensionHours");
  var selectedPackageType = initialPackageType || "";
  var bookingShell = document.getElementById("booking-form");
  var isCustomBooking = customBooking === true || bookingShell?.dataset.customBooking === "true";
  var woodberryPackages = [];
  try {
    woodberryPackages = JSON.parse(bookingShell?.dataset.packageOptions || "[]");
  } catch {
    woodberryPackages = [];
  }
  var accountDetails = {};
  try {
    accountDetails = JSON.parse(bookingShell?.dataset.accountDetails || "{}");
  } catch {
    accountDetails = {};
  }
  var roomRates = roomRateCatalog;
  var roomExtensionOption = roomExtensionCatalog;
  var addOnOptions = addOnCatalog;
  var extensionOptions = extensionCatalog;
  var corkageOptions = corkageCatalog;
  var bookingSteps = Array.from(document.querySelectorAll("[data-booking-step]"));
  var bookingStepTriggers = Array.from(document.querySelectorAll("[data-step-target]"));
  var bookingStepLabels = [
    "Client Details",
    "Date & Venue",
    "Celebration Details",
    "Optionals",
    "Review & Submit",
  ];
  var bookingBackBtn = document.getElementById("bookingBackBtn");
  var bookingNextBtn = document.getElementById("bookingNextBtn");
  var bookingStepStatus = document.getElementById("bookingStepStatus");
  var bookingStepProgress = document.getElementById("bookingStepProgress");
  var currentBookingStep = 0;
  var maximumVisitedStep = 0;
  var CUSTOM_BOOKING_TYPE = "custom-booking";
  var CUSTOM_BOOKING_NAME = "Custom Booking";
  var customPackage = {
    type: CUSTOM_BOOKING_TYPE,
    name: CUSTOM_BOOKING_NAME,
    price: 0,
    duration: "Custom schedule",
    schedule: "Preferred date/time reviewed by staff",
    minPax: 1,
    maxPax: 999,
    inclusions: ["Available venue", "Selected custom items/services", "Staff quotation review"],
    eventTypes: [],
  };
  var customVenueOptions = [];
  try {
    customVenueOptions = JSON.parse(bookingShell?.dataset.venueOptions || "[]");
  } catch {
    customVenueOptions = [];
  }

  var packageBaseDisplay = document.getElementById("packageBaseDisplay");
  if (packageBaseDisplay) packageBaseDisplay.textContent = isCustomBooking ? "To be confirmed" : "Select a package";

  function formatCurrency(amount) {
    return new Intl.NumberFormat("en-PH", {
      style: "currency",
      currency: "PHP",
      minimumFractionDigits: 2,
    }).format(Number(amount) || 0);
  }

  function reservationDeadlineHelpers() {
    var helpers = window.WoodberryReservationDeadline || {};
    return {
      formatDeadline: helpers.formatReservationDeadline || function (value) {
        return value
          ? new Date(value).toLocaleString("en-PH", {
              dateStyle: "medium",
              timeStyle: "short",
              timeZone: "Asia/Manila",
            })
          : "Deadline unavailable";
      },
      formatCountdown: helpers.formatReservationCountdown || function (remainingMs) {
        if (!Number.isFinite(remainingMs)) return "Deadline unavailable";
        var safeMs = Math.max(0, remainingMs);
        var days = Math.floor(safeMs / 86400000);
        var hours = Math.floor((safeMs % 86400000) / 3600000);
        var minutes = Math.floor((safeMs % 3600000) / 60000);
        var seconds = Math.floor((safeMs % 60000) / 1000);
        var time = String(hours).padStart(2, "0") + ":" + String(minutes).padStart(2, "0") + ":" + String(seconds).padStart(2, "0");
        return days > 0 ? days + " " + (days === 1 ? "day" : "days") + " " + time + " remaining" : time + " remaining";
      },
      remainingMs: helpers.getReservationRemainingMs || function (value) {
        return value ? new Date(value).getTime() - Date.now() : null;
      },
    };
  }

  function escapeHtml(value) {
    return String(value ?? "")
      .replace(/&/g, "&amp;")
      .replace(/</g, "&lt;")
      .replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;")
      .replace(/'/g, "&#39;");
  }

  function goToBookingStep(stepIndex, focusHeading) {
    var nextStep = Math.max(0, Math.min(bookingSteps.length - 1, Number(stepIndex) || 0));
    currentBookingStep = nextStep;

    bookingSteps.forEach(function (step, index) {
      var isCurrent = index === currentBookingStep;
      step.hidden = !isCurrent;
      step.setAttribute("aria-hidden", isCurrent ? "false" : "true");
    });

    bookingStepTriggers.forEach(function (trigger, index) {
      var isCurrent = index === currentBookingStep;
      var isComplete = index < currentBookingStep || index < maximumVisitedStep;
      trigger.classList.toggle("is-current", isCurrent);
      trigger.classList.toggle("is-complete", isComplete && !isCurrent);
      trigger.disabled = index > maximumVisitedStep;
      if (isCurrent) trigger.setAttribute("aria-current", "step");
      else trigger.removeAttribute("aria-current");
    });

    if (bookingStepStatus) {
      bookingStepStatus.textContent =
        "Step " + (currentBookingStep + 1) + " of " + bookingSteps.length + " - " + bookingStepLabels[currentBookingStep];
    }
    if (bookingStepProgress) {
      bookingStepProgress.style.width = ((currentBookingStep + 1) / bookingSteps.length) * 100 + "%";
    }
    if (bookingBackBtn) bookingBackBtn.hidden = currentBookingStep === 0;
    if (bookingNextBtn) {
      bookingNextBtn.hidden = currentBookingStep === bookingSteps.length - 1;
      bookingNextBtn.textContent = currentBookingStep < bookingSteps.length - 1
        ? "Next: " + bookingStepLabels[currentBookingStep + 1]
        : "Next";
    }
    if (submitBtn) submitBtn.hidden = currentBookingStep !== bookingSteps.length - 1;
    if (currentBookingStep === bookingSteps.length - 1) calculateNights();

    if (focusHeading) {
      bookingShell?.scrollIntoView({ behavior: "smooth", block: "start" });
      bookingSteps[currentBookingStep]?.querySelector("h3")?.focus({ preventScroll: true });
    }
  }

  function fillAccountDetails() {
    if (!useAccountDetailsInput?.checked) return;
    [
      ["fullName", accountDetails.fullName],
      ["email", accountDetails.email],
