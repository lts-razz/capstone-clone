  async function refreshCustomVenueAvailability(showMessage) {
    if (!isCustomBooking) return true;
    var startDate = getStartDateValue();
    var endDate = getEndDateValue();
    if (!startDate || !endDate) {
      setCustomVenueOptions([], "Choose a booking date to see available venues");
      if (customVenueNotice) customVenueNotice.textContent = "Venue availability updates after you choose a date.";
      return false;
    }

    if (customVenueNotice) customVenueNotice.textContent = "Checking available venues...";
    try {
      var params = new URLSearchParams({
        includeVenues: "1",
        startDate: startDate,
        endDate: endDate,
      });
      var response = await fetch("/api/bookings/availability?" + params.toString());
      var payload = await response.json().catch(function () {
        return {};
      });
      if (!response.ok) throw new Error(payload.error || payload.message || "Could not load available venues.");
      if (payload.minimumBookingDate) applyMinimumBookingDateValue(payload.minimumBookingDate);
      customVenueOptions = payload.venues || customVenueOptions;
      var availableVenues = customVenueOptions.filter(function (venue) {
        return venue.isAvailable !== false;
      });
      setCustomVenueOptions(
        availableVenues,
        availableVenues.length ? "Choose an available venue" : "No venues available for these dates",
      );
      if (customVenueNotice) {
        customVenueNotice.textContent = availableVenues.length
          ? availableVenues.length + " venue" + (availableVenues.length === 1 ? "" : "s") + " available for your selected dates."
          : "No venues are available for your selected dates. Please choose another date or date range.";
      }
      if (!availableVenues.length && showMessage) {
        showNotice("No venues are available for your selected dates. Please choose another date or date range.", "error");
      }
      return availableVenues.length > 0;
    } catch (availabilityError) {
      setCustomVenueOptions([], "Could not load available venues");
      if (customVenueNotice) customVenueNotice.textContent = availabilityError instanceof Error ? availabilityError.message : "Could not load available venues.";
      if (showMessage) showNotice(customVenueNotice?.textContent || "Could not load available venues.", "error");
      return false;
    }
  }

