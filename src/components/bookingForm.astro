  }

  function syncDateTimeMode() {
    var isMultiDay = !!isMultiDayInput?.checked;
    endDateTimeField?.classList.remove("hidden");
    if (endDateTimeInput) {
      endDateTimeInput.required = true;
      endDateTimeInput.disabled = false;
      if (!isMultiDay && endDateTimeInput.value && datePart(endDateTimeInput.value) !== getStartDateValue()) {
        endDateTimeInput.value = "";
      }
    }
    if (startDateTimeLabel) {
      startDateTimeLabel.textContent = isMultiDay
        ? "Stay Start Date and Time *"
        : "Event Start Date and Time *";
    }
    if (endDateTimeLabel) {
      endDateTimeLabel.textContent = isMultiDay
        ? "Stay End Date and Time *"
        : "Event End Date and Time *";
    }
    syncDateInputMinimums();
  }

  function syncCustomEventType() {
    var isOther = eventTypeInput?.value === "other";
