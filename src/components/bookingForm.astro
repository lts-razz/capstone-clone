    box-shadow: var(--wb-shadow-sm);
  }

  .woodberry-package-card:hover,
  .booking-option-card:hover {
    transform: translateY(-1px);
    border-color: rgba(21, 122, 69, 0.35);
  }

  .woodberry-package-card input,
  .booking-option-card input[type="checkbox"] {
    margin-top: 0.25rem;
    accent-color: var(--wb-green);
  }

