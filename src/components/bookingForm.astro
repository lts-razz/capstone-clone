    display: flex;
    min-width: 0;
    align-items: flex-start;
    gap: 0.55rem;
  }

  .booking-option-card__heading strong {
    line-height: 1.25;
  }

  .booking-option-card__description {
    line-height: 1.45;
  }

  .booking-option-card__price {
    color: var(--wb-earth) !important;
    font-weight: 900;
  }

  .booking-option-card--manual {
    cursor: default;
  }

  .booking-option-card--manual:hover {
