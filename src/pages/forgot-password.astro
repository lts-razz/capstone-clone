---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Forgot password">
  <section class="auth-page" aria-labelledby="forgot-password-title">
    <div class="auth-shell">
      <div class="auth-brand-panel auth-brand-panel--logo-free">
        <div class="auth-brand-copy">
          <p class="auth-brand-eyebrow">We're here to help</p>
          <h2 class="auth-brand-title">Woodberry Resorts and Events Place</h2>
          <p class="auth-brand-subtitle">
            Return to planning restful stays and meaningful celebrations in just a few steps.
          </p>
        </div>
      </div>

      <div class="auth-card">
        <header class="auth-card-header">
          <div class="auth-card-topline">
            <p class="auth-card-eyebrow">Account recovery</p>
            <a href="/signin" class="auth-back">Back to sign in</a>
          </div>
          <h1 id="forgot-password-title">Forgot password?</h1>
          <p class="auth-intro">Enter your email address and we'll send you a password reset link.</p>
        </header>

        <form id="forgotPasswordForm" class="auth-form" novalidate>
          <div class="auth-field">
            <label for="email">Email address</label>
            <input
              id="email"
              name="email"
              type="email"
              autocomplete="email"
              inputmode="email"
              required
              class="auth-input"
            />
          </div>

          <button id="forgotPasswordSubmit" type="submit" class="auth-submit">
            Send reset link
          </button>

          <div id="forgotPasswordNotice" class="hidden auth-notice" role="status" aria-live="polite"></div>
        </form>

        <p class="auth-footer">
          Remembered your password?
          <a href="/signin" class="auth-link">Sign in</a>
        </p>
      </div>
    </div>
  </section>
</Layout>

<script>
  const form = document.getElementById('forgotPasswordForm') as HTMLFormElement | null;
  const emailInput = document.getElementById('email') as HTMLInputElement | null;
  const submitButton = document.getElementById('forgotPasswordSubmit') as HTMLButtonElement | null;
  const notice = document.getElementById('forgotPasswordNotice');
  let isSubmitting = false;

  function showNotice(message: string, success: boolean) {
    if (!notice) return;
    notice.textContent = message;
    notice.className = `auth-notice ${success ? 'auth-notice--success' : 'auth-notice--error'}`;
  }

  function restoreSubmitButton() {
    if (!submitButton) return;
    submitButton.disabled = false;
    submitButton.textContent = 'Send reset link';
  }

  function startSubmissionCooldown(seconds = 30) {
    if (!submitButton) return;
    let remaining = seconds;

    const updateButton = () => {
      submitButton.disabled = true;
      submitButton.textContent = `Try again in ${remaining}s`;
    };

    updateButton();
    const timer = window.setInterval(() => {
      remaining -= 1;
      if (remaining <= 0) {
        window.clearInterval(timer);
        restoreSubmitButton();
        return;
      }
      updateButton();
    }, 1000);
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (isSubmitting || submitButton?.disabled || !emailInput) return;

    const email = emailInput.value.trim();
    emailInput.value = email;
    if (!emailInput.checkValidity()) {
      emailInput.reportValidity();
      showNotice('Enter a valid email address.', false);
      return;
    }

    isSubmitting = true;
    if (notice) notice.classList.add('hidden');
    if (submitButton) {
      submitButton.disabled = true;
      submitButton.textContent = 'Sending reset link...';
    }

    let cooldownStarted = false;
    try {
      const response = await fetch('/api/auth/forgot-password', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email }),
      });
      const data = await response.json().catch(() => ({}));

      if (!response.ok) {
        showNotice(data.error ?? 'Unable to request a password reset. Please try again.', false);
        return;
      }

      showNotice(
        data.message ?? 'If an account exists for this email, a password reset link has been sent.',
        true,
      );
      startSubmissionCooldown();
      cooldownStarted = true;
    } catch {
      showNotice('Unable to request a password reset. Please check your connection and try again.', false);
    } finally {
      isSubmitting = false;
      if (!cooldownStarted) restoreSubmitButton();
    }
  });
</script>
