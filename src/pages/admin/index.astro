  .package-default-group > summary::after {
    content: "+";
    order: 3;
    color: var(--wb-green-mid);
    font-size: 1.2rem;
    font-weight: 500;
  }

  .package-default-group[open] > summary::after {
    content: "−";
  }

  .package-default-group > summary span {
    display: grid;
    gap: 0.12rem;
  }

  .package-default-group > summary strong {
    font-size: 0.84rem;
  }

  .package-default-group > summary small {
    color: var(--wb-muted);
    font-size: 0.7rem;
    font-weight: 500;
  }

  .package-default-group > summary em {
    margin-left: auto;
    border-radius: 999px;
    background: var(--wb-green-soft);
    color: var(--wb-green-mid);
    font-size: 0.65rem;
    font-style: normal;
    font-weight: 900;
    padding: 0.25rem 0.5rem;
    white-space: nowrap;
  }

  .package-default-group__content {
    display: grid;
    gap: 0.7rem;
    border-top: 1px solid var(--wb-border);
    padding: 0.8rem;
  }

  .package-default-option,
  .package-default-field {
    display: grid;
    min-width: 0;
    align-content: start;
    gap: 0.6rem;
    border: 1px solid var(--wb-border);
    border-radius: var(--wb-radius-sm);
    background: var(--wb-surface-raised);
    padding: 0.75rem;
    transition: border-color 0.18s ease, background-color 0.18s ease;
  }

  .package-default-option:has(.package-default-option__choice > input:checked) {
    border-color: color-mix(in srgb, var(--wb-green) 54%, var(--wb-border));
    background: var(--wb-green-soft);
    box-shadow: inset 3px 0 0 var(--wb-green);
  }

  .package-default-option__choice {
    display: flex;
    min-width: 0;
    align-items: flex-start;
    gap: 0.62rem;
    cursor: pointer;
  }

  .package-default-option__choice > input,
  .package-default-option__lock input {
    width: 1.05rem !important;
    min-width: 1.05rem;
    height: 1.05rem;
    accent-color: var(--wb-green);
  }

  .package-default-option__choice > input {
    margin-top: 0.15rem;
  }

  .package-default-option__choice span {
    display: grid;
    min-width: 0;
    gap: 0.12rem;
  }

  .package-default-option__choice strong,
  .package-default-field > label:first-child {
    color: var(--wb-green-dark);
    font-size: 0.82rem;
    font-weight: 900;
  }

  .package-default-option__choice small,
  .package-default-field > small {
    color: var(--wb-muted);
    font-size: 0.71rem;
    line-height: 1.4;
  }

  .package-default-option__lock {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    gap: 0.4rem;
    border-radius: 999px;
    color: var(--wb-green-mid);
    cursor: pointer;
    font-size: 0.69rem;
    font-weight: 900;
  }

  .package-default-option__lock--danger {
    color: var(--wb-danger-text);
  }

  .package-section-lock {
    display: inline-flex;
    width: fit-content;
    align-items: center;
    gap: 0.5rem;
    border: 1px solid color-mix(in srgb, var(--wb-danger-text) 18%, var(--wb-border));
    border-radius: 999px;
    background: var(--wb-danger-bg);
    color: var(--wb-danger-text);
    cursor: pointer;
    font-size: 0.72rem;
    font-weight: 900;
    padding: 0.45rem 0.7rem;
  }

  .package-section-lock input {
    width: 1.05rem !important;
    min-width: 1.05rem;
    height: 1.05rem;
    accent-color: var(--wb-danger-text);
  }

  .package-default-option__quantity-wrap {
    display: grid;
    gap: 0.3rem;
    color: var(--wb-muted);
    font-size: 0.68rem;
    font-weight: 800;
  }

  .package-default-field select,
  .package-default-field > input,
  .package-default-option__quantity {
    width: 100%;
    min-height: 2.5rem;
    border: 1px solid var(--wb-border);
    border-radius: var(--wb-radius-sm);
    background: var(--wb-input-bg);
    padding: 0.5rem 0.65rem;
    font-size: 0.82rem;
  }

  .package-default-field--hours {
    max-width: 23rem;
  }

  .package-upload-field {
    display: grid;
    gap: 0.65rem;
    border: 1px dashed color-mix(in srgb, var(--wb-green) 45%, var(--wb-border));
    border-radius: var(--wb-radius-md);
    background: var(--wb-green-soft);
    padding: 1rem;
  }

  .package-upload-field > label {
    display: grid;
    gap: 0.15rem;
  }

  .package-upload-field > label strong {
    color: var(--wb-green-dark);
    font-size: 0.86rem;
  }

  .package-upload-field > label span {
    color: var(--wb-muted);
    font-size: 0.72rem;
  }

  #packageModal .package-upload-field input[type="file"] {
    min-height: 3rem;
    border: 1px solid var(--wb-border) !important;
    border-radius: var(--wb-radius-sm) !important;
    background: var(--wb-input-bg) !important;
    padding: 0.35rem !important;
    color: var(--wb-muted) !important;
    font-size: 0.78rem;
  }

  #packageModal .package-upload-field input[type="file"]::file-selector-button {
    min-height: 2.2rem;
    margin-right: 0.7rem;
    border: 0;
    border-radius: calc(var(--wb-radius-sm) - 2px);
    background: var(--wb-action);
    color: var(--wb-on-action);
    cursor: pointer;
    font-weight: 900;
    padding: 0.5rem 0.8rem;
  }

  .package-thumbnail-preview {
    width: 100%;
    max-height: 15rem;
    border: 1px solid var(--wb-border);
    border-radius: var(--wb-radius-md);
    object-fit: cover;
  }

  .package-form-error {
    margin: 0;
    border: 1px solid var(--wb-danger-border);
    border-radius: var(--wb-radius-sm);
    background: var(--wb-danger-bg);
    color: var(--wb-danger-text);
    font-size: 0.8rem;
    font-weight: 800;
    line-height: 1.45;
    padding: 0.8rem 0.9rem;
  }

  .package-form-end-actions {
    display: grid;
    gap: 0.75rem;
    margin-top: clamp(1.25rem, 4vw, 2rem);
    padding-top: clamp(1.1rem, 3vw, 1.5rem);
    border-top: 1px solid var(--wb-border);
  }

  #packageModal .package-form-submit {
    width: 100%;
    min-height: 3.75rem;
    border: 0 !important;
    border-radius: var(--wb-radius-md) !important;
    background: var(--wb-action) !important;
    color: var(--wb-on-action) !important;
    box-shadow: 0 16px 30px rgba(21, 122, 69, 0.26);
    cursor: pointer;
    font-size: 0.98rem;
    font-weight: 950;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  #packageModal .package-form-submit:hover {
    background: var(--wb-action-hover) !important;
    transform: translateY(-1px);
  }

  .package-modal-actions {
    position: sticky;
    z-index: 3;
    bottom: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border-top: 1px solid var(--wb-border);
    box-shadow: 0 -10px 24px rgba(26, 46, 16, 0.08);
    padding: 0.9rem clamp(1rem, 3vw, 1.5rem);
  }

  .package-modal-status {
    display: grid;
    gap: 0.15rem;
  }

  .package-modal-status > span {
    width: fit-content;
    border: 1px solid var(--wb-success-border);
    border-radius: 999px;
    background: var(--wb-success-bg);
    color: var(--wb-success-text);
    font-size: 0.67rem;
    font-weight: 900;
    padding: 0.25rem 0.55rem;
  }

  .package-modal-status > span.package-modal-status--inactive {
    border-color: var(--wb-border);
    background: var(--wb-surface-soft);
    color: var(--wb-muted);
  }

  .package-modal-status small {
    color: var(--wb-muted);
    font-size: 0.7rem;
  }

  .package-modal-actions__buttons {
    display: flex;
    gap: 0.65rem;
  }

  #packageModal .package-modal-cancel,
  #packageModal .package-modal-save {
    min-width: 8rem;
    min-height: 2.75rem;
    border-radius: var(--wb-radius-sm) !important;
    cursor: pointer;
    font-size: 0.82rem;
    font-weight: 900;
    text-transform: uppercase;
    padding: 0.65rem 1rem;
  }

  #packageModal .package-modal-cancel {
    border: 1px solid var(--wb-border) !important;
    background: var(--wb-surface-raised) !important;
    color: var(--wb-green-mid) !important;
  }

  #packageModal .package-modal-save {
    border: 1px solid var(--wb-green) !important;
    background: var(--wb-action) !important;
    color: var(--wb-on-action) !important;
    box-shadow: 0 8px 18px rgba(21, 122, 69, 0.16);
  }

  #packageModal .package-modal-cancel:hover {
    background: var(--wb-green-soft) !important;
  }

  #packageModal .package-modal-save:hover {
    background: var(--wb-action-hover) !important;
  }

  @media (max-width: 700px) {
    #packageModal {
      padding: 0.5rem !important;
    }

    .package-modal-card {
      max-height: calc(100dvh - 1rem);
      width: 100%;
      border-radius: var(--wb-radius-md);
    }

    .package-form-fields,
    .package-time-options__grid,
    .package-time-fields,
    .package-venue-picker,
    .package-booking-defaults__base,
    .package-default-grid {
      grid-template-columns: 1fr;
    }

    .package-modal-header {
      padding: 1rem;
    }

    .package-modal-header p:last-child,
    .package-modal-status small {
      display: none;
    }

    .package-form-section__heading > span {
      width: 1.8rem;
      min-width: 1.8rem;
      height: 1.8rem;
    }

    .package-default-group > summary {
      align-items: flex-start;
      gap: 0.55rem;
    }

    .package-default-group > summary em {
      display: none;
    }

    .package-modal-actions {
      align-items: stretch;
      flex-direction: column;
    }

    .package-modal-actions__buttons {
      width: 100%;
    }

    #packageModal .package-modal-cancel,
    #packageModal .package-modal-save {
      flex: 1;
      min-width: 0;
    }
  }

  .admin-venues-section {
