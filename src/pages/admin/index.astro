    min-width: 1.05rem;
    height: 1.05rem;
    margin-top: 0.15rem;
    accent-color: var(--wb-green);
  }

  .package-venue-option span,
  .package-venue-option small {
    display: block;
  }

  .package-venue-option strong {
    color: var(--wb-green-dark);
    font-size: 0.85rem;
  }

  .package-venue-option small {
    margin-top: 0.2rem;
    color: var(--wb-muted);
    font-size: 0.73rem;
    font-weight: 500;
    line-height: 1.4;
  }

  .package-form-helper {
    margin-top: 0.55rem;
