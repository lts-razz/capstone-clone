  .package-time-options {
    display: grid;
    gap: 0.65rem;
    margin: 0;
    border: 1px solid var(--wb-border);
    border-radius: var(--wb-radius-sm);
    background: var(--wb-surface-soft);
    padding: 0.85rem;
  }

  .package-time-options__grid {
    display: grid;
    gap: 0.75rem;
    grid-template-columns: minmax(12rem, 0.75fr) minmax(0, 1.25fr);
    align-items: end;
  }

  .package-time-fields {
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .package-venue-picker {
