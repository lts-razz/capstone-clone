        <div class="grid grid-cols-2 gap-x-6 gap-y-3 text-sm">
          <div><span class="text-gray-400">Final Payable Amount</span><p id="bd-final-payable" class="font-semibold mt-0.5"></p></div>
          <div><span class="text-gray-400">Payment Status</span><p id="bd-payment-status" class="font-semibold mt-0.5"></p></div>
          <div><span class="text-gray-400">Amount Paid</span><p id="bd-amount-paid" class="font-semibold mt-0.5"></p></div>
          <div><span class="text-gray-400">Remaining Balance</span><p id="bd-payment-balance" class="font-semibold mt-0.5"></p></div>
          <div><span class="text-gray-400">Method</span><p id="bd-payment-method" class="font-semibold mt-0.5"></p></div>
          <div><span class="text-gray-400">Recorded Date</span><p id="bd-payment-date" class="font-semibold mt-0.5"></p></div>
          <div class="col-span-2"><span class="text-gray-400">Notes</span><p id="bd-payment-notes" class="font-semibold mt-0.5 whitespace-pre-wrap"></p></div>
          <div><span class="text-gray-400">Refund Status</span><p id="bd-refund-status" class="font-semibold mt-0.5"></p></div>
          <div><span class="text-gray-400">Refund Amount</span><p id="bd-refund-amount" class="font-semibold mt-0.5"></p></div>
          <div><span class="text-gray-400">Refund Processed</span><p id="bd-refund-processed" class="font-semibold mt-0.5"></p></div>
          <div class="col-span-2"><span class="text-gray-400">Refund Notes</span><p id="bd-refund-notes" class="font-semibold mt-0.5 whitespace-pre-wrap"></p></div>
