---
import Layout from '../../layouts/Layout.astro';
import { adminGuard, staffOrAdminGuard } from '../../lib/adminGuard';
import { supabase, supabaseAdmin } from '../../lib/supabase';
import {
  BOOKING_STATUS_LABELS,
  BOOKING_STATUS_TRANSITIONS,
  getAllowedNextBookingStatuses,
  isExpiredReservationCancellation,
  normalizeBookingStatus,
  type BookingStatus,
} from '../../lib/bookingStatus';
import { getReservationDeadlineState, normalizeBookingPaymentStatus } from '../../lib/reservationValidity';
import type { Database } from '../../lib/database.types';
import {
  ADD_ON_OPTIONS,
  BOOKING_EVENT_TYPES,
  CORKAGE_OPTIONS,
  EXTENSION_OPTIONS,
  ROOM_EXTENSION_OPTION,
  ROOM_RATE_OPTIONS,
} from '../../lib/bookingOptions';

export const prerender = false;

// Use service role client so RLS never blocks the role check
const adminClient = supabaseAdmin ?? supabase;
// `/staff` rewrites here with this flag so both staff and admins get the same
// booking-operations-only workspace without duplicating the large booking UI.
const staffViewRequested = Astro.url.searchParams.get('staffView') === '1';
const roleInfo = staffViewRequested
  ? await staffOrAdminGuard(Astro.cookies)
  : await adminGuard(Astro.cookies);
if (roleInfo instanceof Response) {
  if (roleInfo.status === 401) return Astro.redirect('/signin');
  return Astro.redirect('/dashboard');
}
const user = roleInfo.user;
const isAdmin = roleInfo.role === 'admin' && !staffViewRequested;
const isStaff = roleInfo.role === 'staff' || staffViewRequested;
const profile = roleInfo.profile;
const initialAdminTab = isAdmin ? 'dashboard' : 'bookings';

const { data: bookings, error: bookingsError } = await adminClient
  .from('bookings')
  .select('id, full_name, phone, address, pax, event_date, start_date, end_date, start_datetime, end_datetime, event_type, status, total_price, created_at, updated_at, confirmed_at, cancelled_at, rescheduled_at, one_week_notice_sent_at, special_requests, venue_id, user_id, package_id, package_type, package_price, package_inclusions, rooms_count, selected_rooms, add_ons, extension_selections, corkage_selections, additionals, caterer, use_woodberry_caterer, estimate_summary, minimum_payment_amount, remaining_balance_amount, terms_accepted_at, reservation_created_at, reservation_expires_at, reservation_expired_at, cancellation_reason, cancellation_source')
  .order('created_at', { ascending: false })
  .limit(200);

const bookingIds = (bookings ?? []).map((booking) => booking.id);
const { data: bookingPayments, error: bookingPaymentsError } = bookingIds.length > 0
  ? await adminClient.from('booking_payments').select('*').in('booking_id', bookingIds)
  : { data: [], error: null };
type BookingPaymentRow = Database['public']['Tables']['booking_payments']['Row'];
const paymentByBookingId: Record<string, BookingPaymentRow> = {};
(bookingPayments ?? []).forEach((payment) => {
  paymentByBookingId[payment.booking_id] = {
    ...payment,
    payment_status: normalizeBookingPaymentStatus(payment.payment_status),
  };
});

const { data: bookingAuditRows, error: bookingAuditError } = bookingIds.length > 0
  ? await adminClient
      .from('booking_audit_log')
      .select('id, booking_id, actor_id, actor_role, action, old_status, new_status, reason, metadata, created_at')
      .in('booking_id', bookingIds)
      .order('created_at', { ascending: false })
  : { data: [], error: null };
const auditByBookingId: Record<string, any[]> = {};
if (bookingAuditError) console.error('[Admin] Could not load booking audit history:', bookingAuditError.message);
(bookingAuditRows ?? []).forEach((entry: any) => {
  if (!entry.booking_id) return;
  (auditByBookingId[entry.booking_id] ??= []).push(entry);
});
const { data: rescheduleRequests, error: rescheduleRequestsError } = bookingIds.length > 0
  ? await adminClient
      .from('booking_reschedule_requests')
      .select('id, booking_id, requested_start_date, requested_end_date, requested_event_date, requested_start_datetime, requested_end_datetime, customer_note, status, created_at')
      .in('booking_id', bookingIds)
      .eq('status', 'pending')
      .order('created_at', { ascending: false })
  : { data: [], error: null };
if (rescheduleRequestsError) console.error('[Admin] Could not load reschedule requests:', rescheduleRequestsError.message);
const pendingRescheduleByBookingId: Record<string, any> = {};
(rescheduleRequests ?? []).forEach((request: any) => {
  if (!pendingRescheduleByBookingId[request.booking_id]) pendingRescheduleByBookingId[request.booking_id] = request;
});

// Separately fetch venue names for each booking
const venueIds = [...new Set((bookings ?? []).map(b => b.venue_id).filter(Boolean))];
const { data: venueMap } = venueIds.length > 0
  ? await adminClient.from('venues').select('id, name').in('id', venueIds)
  : { data: [] };
const venueById: Record<string, string> = {};
(venueMap ?? []).forEach((v: any) => { venueById[v.id] = v.name; });

const packageIds = [...new Set((bookings ?? []).map(b => b.package_id).filter((id): id is string => id !== null && id !== undefined))];
const { data: pkgMap } = packageIds.length > 0
  ? await adminClient.from('packages').select('id, name').in('id', packageIds)
  : { data: [] };
const packageById: Record<string, string> = {};
(pkgMap ?? []).forEach((p: any) => { packageById[p.id] = p.name; });

const woodberryPackageNames: Record<string, string> = {
  'lunch-time': 'Lunch Time Package',
  'dinner-time': 'Dinner Time Package',
  'barkada-staycation': 'Barkada Staycation',
  'pamilya-staycation': 'Pamilya Staycation',
  'room-rates': 'Room Rates',
  'custom-booking': 'Custom Booking',
};
const eventTypeLabels: Record<string, string> = Object.fromEntries(
  BOOKING_EVENT_TYPES.map((eventType) => [eventType.key, eventType.label]),
);

const userIds = [...new Set((bookings ?? []).map(b => b.user_id).filter(Boolean))];
// Booking form email is saved on customers. Fetch it separately so admin modals
// and email notifications use the address the customer typed during booking.
const { data: customerMap, error: customerMapError } = userIds.length > 0
  ? await adminClient.from('customers').select('id, email, first_name, last_name, phone, email_notifications_enabled, sms_notifications_enabled').in('id', userIds)
  : { data: [] };
const customerById: Record<string, any> = {};
(customerMap ?? []).forEach((c: any) => { customerById[c.id] = c; });

// Attach names/contact info to bookings
const enrichedBookings = (bookings ?? []).map(b => {
  const customer = customerById[b.user_id] ?? null;
    const userInfo = customer;
  return {
    ...b,
    payment: paymentByBookingId[b.id] ?? {
      booking_id: b.id,
      total_booking_amount: Number(b.total_price ?? 0),
      minimum_payment_amount: b.minimum_payment_amount == null
        ? Number(b.total_price ?? 0) * 0.5
        : Number(b.minimum_payment_amount),
      amount_paid: 0,
      remaining_balance: Number(b.total_price ?? 0),
      payment_status: 'unpaid',
      payment_method: null,
      payment_notes: null,
      payment_recorded_at: null,
    },
    auditHistory: auditByBookingId[b.id] ?? [],
    pendingRescheduleRequest: pendingRescheduleByBookingId[b.id] ?? null,
    status: normalizeBookingStatus(b.status),
    venueName: venueById[b.venue_id] ?? '—',
    packageName: b.package_type === 'custom-booking'
      ? 'Custom Booking'
      : b.package_type ? (woodberryPackageNames[b.package_type] ?? b.package_type) : b.package_id ? (packageById[b.package_id] ?? '—') : null,
    eventTypeName: b.event_type ? (eventTypeLabels[b.event_type] ?? b.event_type) : null,
    userName: userInfo,
    customer,
    customerEmail: customer?.email ?? userInfo?.email ?? null,
    customerPhone: b.phone ?? customer?.phone ?? null,
  };
});

const statusLabels = BOOKING_STATUS_LABELS;

const { data: venues } = isAdmin
  ? await adminClient.from('venues').select('*').eq('is_active', true).order('name')
  : { data: [] };
const { data: rawPackages } = isAdmin
  ? await adminClient.from('packages').select('*').order('price')
  : { data: [] };
const adminVenueById: Record<string, any> = {};
(venues ?? []).forEach((venue: any) => { adminVenueById[venue.id] = venue; });
const managedPackageIds = (rawPackages ?? []).map((pkg: any) => pkg.id);
const { data: adminPackageAssignments } = isAdmin && managedPackageIds.length > 0
  ? await adminClient
      .from('package_venue_assignments')
      .select('package_id, venue_id, created_at')
      .in('package_id', managedPackageIds)
      .order('created_at', { ascending: true })
  : { data: [] };
const adminVenueIdsByPackage = new Map<string, string[]>();
for (const assignment of adminPackageAssignments ?? []) {
  const ids = adminVenueIdsByPackage.get(assignment.package_id) ?? [];
  ids.push(assignment.venue_id);
  adminVenueIdsByPackage.set(assignment.package_id, ids);
}
const packages = (rawPackages ?? []).map((pkg: any) => ({
  ...pkg,
  venue_ids: adminVenueIdsByPackage.get(pkg.id) ?? [],
}));

function formatAdminPackageTime(timeOptions: any) {
  if (
    timeOptions?.mode === 'range_duration'
    && timeOptions.from_time
    && timeOptions.to_time
    && Number(timeOptions.hours) > 0
  ) {
    const hours = Number(timeOptions.hours);
    return `${timeOptions.from_time}–${timeOptions.to_time}; exactly ${hours.toLocaleString()} ${hours === 1 ? 'hour' : 'hours'}`;
  }
  if (timeOptions?.mode === 'duration' && Number(timeOptions.hours) > 0) {
    return `${Number(timeOptions.hours).toLocaleString()} ${Number(timeOptions.hours) === 1 ? 'hour' : 'hours'}`;
  }
  if (timeOptions?.mode === 'fixed_range' && timeOptions.from_time && timeOptions.to_time) {
    return `${timeOptions.from_time}–${timeOptions.to_time}`;
  }
  return 'Not configured';
}
const { data: rawReviews } = isAdmin
  ? await adminClient
      .from('reviews')
      .select('id, rating, comment, created_at, user_id, booking_id')
      .order('created_at', { ascending: false })
      .limit(100)
  : { data: [] };

const reviewUserIds = [...new Set((rawReviews ?? []).map((r: any) => r.user_id).filter(Boolean))];
const { data: reviewUsers } = reviewUserIds.length > 0
  ? await adminClient.from('customers').select('id, first_name, last_name, email').in('id', reviewUserIds)
  : { data: [] };
const reviewUserById: Record<string, any> = {};
(reviewUsers ?? []).forEach((u: any) => { reviewUserById[u.id] = u; });

const reviewBookingIds = [...new Set((rawReviews ?? []).map((r: any) => r.booking_id).filter(Boolean))];
const { data: reviewBookings } = reviewBookingIds.length > 0
  ? await adminClient.from('bookings').select('id, event_date, venue_id').in('id', reviewBookingIds)
  : { data: [] };
const reviewBookingById: Record<string, any> = {};
(reviewBookings ?? []).forEach((b: any) => { reviewBookingById[b.id] = b; });

const reviews = (rawReviews ?? []).map((r: any) => ({
  ...r,
  reviewUser: reviewUserById[r.user_id] ?? null,
  reviewBooking: reviewBookingById[r.booking_id] ?? null,
  reviewVenueName: reviewBookingById[r.booking_id]?.venue_id ? (venueById[reviewBookingById[r.booking_id].venue_id] ?? '—') : '—',
}));

const { data: allCustomers } = isAdmin
  ? await adminClient
      .from('customers')
      .select('id, email, first_name, last_name, created_at')
      .order('created_at', { ascending: false })
  : { data: [] };

const { data: allAdmins } = isAdmin
  ? await adminClient
      .from('admins')
      .select('id, email, first_name, last_name, created_at')
      .order('created_at', { ascending: false })
  : { data: [] };
const { data: allEmployees } = isAdmin
  ? await adminClient
      .from('employees')
      .select('id, email, first_name, last_name, phone, position, is_active, created_at')
      .order('created_at', { ascending: false })
  : { data: [] };

const stats = {
  total:       enrichedBookings.length,
  pending:    enrichedBookings.filter(b => b.status === 'pending').length,
  booked:     enrichedBookings.filter(b => b.status === 'booked').length,
  cancelled:   enrichedBookings.filter(b => b.status === 'cancelled').length,
  rescheduled: enrichedBookings.filter(b => b.status === 'rescheduled').length,
  completed: enrichedBookings.filter(b => b.status === 'completed').length,
  revenue:     enrichedBookings.reduce((sum, b) => sum + (b.payment?.payment_status === 'refunded' ? 0 : Number(b.payment?.amount_paid ?? 0)), 0),
  avgPax: (() => {
    const w = enrichedBookings.filter(b => b.pax && (b.status === 'booked' || b.status === 'completed'));
    return w.length ? Math.round(w.reduce((s,b) => s + (b.pax ?? 0), 0) / w.length) : 0;
  })(),
};

const adminName = profile?.first_name
  ? `${profile.first_name} ${profile.last_name ?? ''}`.trim()
  : user.email;
const panelLabel = isAdmin ? 'Admin Panel' : 'Staff Panel';
const roleBadge = isAdmin ? 'ADMIN' : 'STAFF';
const adminNavItems = isAdmin
  ? [
      { id:'dashboard', icon:'📊', label:'Dashboard'  },
      { id:'bookings',  icon:'📅', label:'Bookings'   },
      { id:'packages',  icon:'📦', label:'Packages'   },
      { id:'reviews',   icon:'⭐', label:'Reviews'    },
      { id:'users',     icon:'👥', label:'Users'      },
      { id:'staff-management', icon:'ST', label:'Staff' },
      { id:'reports',   icon:'📈', label:'Reports'    },
      { id:'calendar',  icon:'🗓️', label:'Availability'},
    ]
  : [
      { id:'bookings',  icon:'📅', label:'Bookings'   },
    ];

const canTransitionBookingTo = (status: BookingStatus, nextStatus: BookingStatus) =>
  getAllowedNextBookingStatuses(status).includes(nextStatus);

const reservationState = (booking: any) => getReservationDeadlineState(booking);
---

<Layout title={isStaff ? "Staff Booking Management" : "Admin Dashboard"}>
<div id="admin-root" class="admin-shell min-h-screen">

  <!-- SIDEBAR -->
  <aside id="sidebar" class="admin-sidebar fixed top-0 left-0 h-full w-64 z-50 flex flex-col shadow-xl">
    <div class="admin-sidebar__profile px-6 py-5 border-b border-white/10">
      <p class="text-xs font-semibold uppercase tracking-widest mb-1" style="color:rgba(255,255,255,0.55);">{panelLabel}</p>
      <p class="font-bold text-lg truncate" style="color:var(--butterscotch-primary);">{adminName}</p>
      <p class="text-xs truncate" style="color:rgba(255,255,255,0.65);">{user.email}</p>
    </div>
    <nav class="flex-1 px-3 py-4 space-y-1 overflow-y-auto">
      {adminNavItems.map(nav => (/*
        { id:'dashboard', icon:'📊', label:'Dashboard'  },
        { id:'bookings',  icon:'📅', label:'Bookings'   },
        { id:'venues',    icon:'🏖️', label:'Venues'     },
        { id:'packages',  icon:'📦', label:'Packages'   },
        { id:'reviews',   icon:'⭐', label:'Reviews'    },
        { id:'users',     icon:'👥', label:'Users'      },
        { id:'reports',   icon:'📈', label:'Reports'    },
        { id:'calendar',  icon:'🗓️', label:'Availability'},
        */
        <button data-tab={nav.id} class="nav-btn w-full text-left px-4 py-2.5 rounded-lg flex items-center gap-3 text-sm font-medium transition-all hover:bg-white/10">
          <span class="nav-btn__icon">{nav.icon}</span><span>{nav.label}</span>
        </button>
      ))}
    </nav>
    <div class="px-4 py-4 border-t border-white/10">
      <a href="/dashboard" class="block text-center text-sm py-2 px-3 rounded-lg transition hover:bg-white/10 mb-2">← Back to Site</a>
      <form method="POST" action="/api/auth/signout">
        <button type="submit" class="w-full block text-center text-sm py-2 px-3 rounded-lg bg-red-600/80 hover:bg-red-600 transition text-white">Sign out</button>
      </form>
    </div>
  </aside>

  <!-- MAIN -->
  <main class="admin-main ml-64 min-h-screen">
    <header class="admin-header sticky top-0 z-40 flex items-center justify-between px-8 py-4 shadow-sm">
      <h1 id="page-title" class="text-2xl font-bold" style="color:var(--jet-primary);">Dashboard</h1>
      <div class="flex items-center gap-3 text-sm">
        <span class="px-3 py-1 rounded-full font-semibold text-white text-xs" style="background:var(--butterscotch-primary);">{roleBadge}</span>
      </div>
    </header>

    <div class="admin-content p-8">

      <!-- TAB: DASHBOARD -->
      <section id="tab-dashboard" class={`tab-section ${isAdmin ? '' : 'hidden'}`}>
        <div class="admin-section-heading">
          <div>
            <p class="admin-kicker">Operational snapshot</p>
            <h2>Today at a Glance</h2>
          </div>
          <button data-tab="bookings" class="nav-btn admin-link-action">Open bookings</button>
        </div>
        <div class="admin-stats-grid grid grid-cols-2 lg:grid-cols-4 gap-5 mb-8">
          {[
            { label:'All reservations', value:stats.total, color:'#664c2f', icon:'All' },
            { label:'Pending reservations', value:stats.pending, color:'#aa8f66', icon:'PD' },
            { label:'Booked events', value:stats.booked, color:'#176b42', icon:'BK' },
            { label:'Cancelled', value:stats.cancelled, color:'#8f2f20', icon:'CX' },
            { label:'Rescheduled', value:stats.rescheduled, color:'#74552f', icon:'RS' },
            { label:'Completed', value:stats.completed, color:'#5e554a', icon:'OK' },
            { label:'Payments collected', value:`₱${stats.revenue.toLocaleString()}`, color:'#155d39', icon:'₱' },
            { label:'Active packages', value:packages?.filter(p=>p.is_active).length??0, color:'#176b42', icon:'PK' },
            { label:'Avg booked pax', value:stats.avgPax||'—', color:'#74552f', icon:'PX' },
          ].map(c => (
            <div class="admin-stat-card bg-white rounded-xl p-5 shadow-sm border border-gray-100" style={`--stat-color:${c.color}`}>
              <span class="admin-stat-card__icon">{c.icon}</span>
              <div class="admin-stat-card__body">
                <p class="admin-stat-card__label">{c.label}</p>
                <p class="admin-stat-card__value">{c.value}</p>
              </div>
            </div>
          ))}
        </div>
        <div class="admin-panel bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
          <div class="admin-panel-header px-6 py-4 border-b border-gray-100 flex justify-between items-center">
            <div>
              <p class="admin-kicker">Latest activity</p>
              <h2 class="font-bold text-lg" style="color:var(--jet-primary);">Recent Bookings</h2>
            </div>
            <button data-tab="bookings" class="nav-btn admin-link-action">View all</button>
          </div>
          <div class="admin-table-wrap overflow-x-auto">
            <table class="admin-table w-full text-sm">
              <thead><tr class="bg-gray-50 text-gray-500 text-xs uppercase tracking-wide">
                <th class="px-4 py-3 text-left">Guest</th>
                <th class="px-4 py-3 text-left">Venue</th>
                <th class="px-4 py-3 text-left">Event Date</th>
                <th class="px-4 py-3 text-left">Pax</th>
                <th class="px-4 py-3 text-left">Total</th>
                <th class="px-4 py-3 text-left">Status</th>
              </tr></thead>
              <tbody>
                {enrichedBookings.slice(0,8).map(b => (
                  <tr class="border-t border-gray-50 hover:bg-gray-50">
                    <td class="px-4 py-3 font-medium">{b.full_name ?? (b.userName as any)?.email ?? '—'}</td>
                    <td class="px-4 py-3 text-gray-600">{b.venueName ?? '—'}</td>
                    <td class="px-4 py-3 text-gray-600">{b.event_date ? new Date(b.event_date).toLocaleDateString('en-PH') : '—'}</td>
                    <td class="px-4 py-3 text-gray-600">{b.pax ?? '—'}</td>
                    <td class="px-4 py-3 font-semibold" style="color:var(--butterscotch-primary);">{b.package_type === 'custom-booking' && ((b.estimate_summary as any)?.pricingStatus !== 'finalized' || !Number(b.total_price)) ? 'To be confirmed' : b.total_price ? `₱${Number(b.total_price).toLocaleString()}` : '—'}</td>
                    <td class="px-4 py-3">
                      <span class={`wb-badge ${ b.status==='booked'?'wb-badge--success': b.status==='completed'?'wb-badge--neutral': b.status==='cancelled'?'wb-badge--danger': b.status==='rescheduled'?'wb-badge--earth':'wb-badge--neutral'}`}>{b.status === 'pending' && b.package_type === 'custom-booking' && (b.estimate_summary as any)?.pricingStatus !== 'finalized' ? 'Waiting for Quotation' : statusLabels[b.status] ?? b.status}</span>
                    </td>
                  </tr>
                ))}
                {enrichedBookings.length === 0 && (
                  <tr><td colspan="6" class="admin-empty-cell">No recent bookings to show.</td></tr>
                )}
              </tbody>
            </table>
          </div>
        </div>
      </section>

      <!-- TAB: BOOKINGS -->
      <section id="tab-bookings" class={`tab-section ${isStaff ? '' : 'hidden'}`}>

        <!-- Filters + Search bar -->
        <div class="admin-toolbar bg-white rounded-2xl shadow-sm border border-gray-100 px-5 py-4 mb-5 flex flex-wrap gap-3 items-center justify-between">
          <div class="admin-toolbar__filters flex gap-2 flex-wrap items-center">
            <span class="admin-toolbar__label text-xs font-bold text-gray-400 uppercase tracking-wider mr-1">Show</span>
            {[
              { v:'all',         label:'All',          color:'#7c6246' },
              { v:'pending',     label:'Pending',      color:'#aa8f66' },
              { v:'booked',   label:'Booked',  color:'#157a45' },
              { v:'cancelled',   label:'Cancelled',  color:'#9a4a36' },
              { v:'rescheduled', label:'Rescheduled',color:'#aa8f66' },
              { v:'completed', label:'Completed', color:'#5e5c60' },
            ].map(s => (
              <button data-filter={s.v}
                class="filter-btn px-4 py-1.5 rounded-full text-xs font-bold border-2 transition-all"
                style="border-color:#e5e7eb;color:#6b7280;">
                {s.label}
              </button>
            ))}
          </div>
          <div class="admin-toolbar__controls flex flex-wrap gap-3 items-center">
            <select id="bookingSort" class="px-3 py-2 rounded-xl border border-gray-200 text-sm focus:outline-none">
              <option value="newest">Newest first</option>
              <option value="oldest">Oldest first</option>
              <option value="event_asc">Event date ascending</option>
              <option value="event_desc">Event date descending</option>
              <option value="status">Status</option>
            </select>
            <div class="relative">
              <svg class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-300" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
              <input id="bookingSearch" type="text" placeholder="Search guest, venue, email, phone…"
                class="pl-9 pr-4 py-2 rounded-xl border border-gray-200 text-sm focus:outline-none focus:ring-2 w-64"
                style="focus-ring-color:var(--butterscotch-primary);" />
            </div>
          </div>
        </div>

        {bookingsError && (
          <div class="admin-notice admin-notice--danger mb-3 rounded-xl border border-red-100 bg-red-50 px-4 py-3 text-sm font-semibold text-red-700">Bookings could not be loaded. Please refresh or check the admin connection.</div>
        )}
        {customerMapError && (
          <div class="admin-notice admin-notice--warning mb-3 rounded-xl border border-amber-100 bg-amber-50 px-4 py-3 text-sm font-semibold text-amber-700">Customer contact details could not be loaded.</div>
        )}
        {bookingPaymentsError && (
          <div class="admin-notice admin-notice--warning mb-3 rounded-xl border border-amber-100 bg-amber-50 px-4 py-3 text-sm font-semibold text-amber-700">Payment records could not be loaded. Apply the booking payments migration.</div>
        )}

        <div class="admin-panel bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
          <div class="admin-table-wrap overflow-x-auto">
            <table class="admin-table admin-bookings-table w-full text-sm">
              <thead>
                <tr style="background:#f8f9fa;border-bottom:2px solid #f3f4f6;">
                  <th class="px-4 py-3 text-left text-xs font-bold text-gray-400 uppercase tracking-wider">Guest</th>
                  <th class="px-4 py-3 text-left text-xs font-bold text-gray-400 uppercase tracking-wider">Venue</th>
                  <th class="px-4 py-3 text-left text-xs font-bold text-gray-400 uppercase tracking-wider">Package</th>
                  <th class="px-4 py-3 text-left text-xs font-bold text-gray-400 uppercase tracking-wider">Event Date</th>
                  <th class="px-4 py-3 text-left text-xs font-bold text-gray-400 uppercase tracking-wider">Hold Period</th>
                  <th class="px-4 py-3 text-left text-xs font-bold text-gray-400 uppercase tracking-wider">Pax</th>
                  <th class="px-4 py-3 text-left text-xs font-bold text-gray-400 uppercase tracking-wider">Total</th>
                  <th class="px-4 py-3 text-left text-xs font-bold text-gray-400 uppercase tracking-wider">Reservation</th>
                  <th class="px-4 py-3 text-left text-xs font-bold text-gray-400 uppercase tracking-wider">Payment</th>
                  <th class="px-4 py-3 text-left text-xs font-bold text-gray-400 uppercase tracking-wider">Status</th>
                  <th class="px-4 py-3 text-left text-xs font-bold text-gray-400 uppercase tracking-wider">Booked On</th>
                  <th class="px-4 py-3 text-left text-xs font-bold text-gray-400 uppercase tracking-wider">Actions</th>
                </tr>
              </thead>
              <tbody id="bookingsTableBody">
                {enrichedBookings.map((b) => {
                    const reservation = reservationState(b);
                    const statusColors = {
                      pending:'wb-badge--earth',
                      booked:'wb-badge--success',
                      completed:'wb-badge--neutral',
                      cancelled:'wb-badge--danger',
                      rescheduled:'wb-badge--earth',
                    };
                    return (
                      <tr
                        data-status={b.status}
                        data-created={b.created_at}
                        data-event-date={b.event_date ?? b.start_date}
                        data-status-label={statusLabels[b.status] ?? b.status}
                        data-search={`${b.full_name??''} ${b.venueName??''} ${b.customerEmail??''} ${b.customerPhone??b.phone??''} ${b.event_type??''}`}
                        class={`booking-row border-t border-gray-50 hover:bg-amber-50 transition-colors ${b.status==='cancelled'?'booking-row--cancelled':''}`}
                      >
                        {/* Guest */}
                        <td class="px-4 py-3">
                          <p class="admin-table-primary">{b.full_name??'—'}</p>
                          <p class="admin-table-meta mt-0.5">{b.customerEmail ?? 'No email saved'}</p>
                          <p class="admin-table-meta mt-0.5">{b.customerPhone ?? 'No phone saved'}</p>
                        </td>

                        {/* Venue */}
                        <td class="px-4 py-3">
                          <span class="admin-table-strong">{b.venueName??'—'}</span>
                        </td>

                        {/* Package */}
                        <td class="px-4 py-3 admin-table-muted">{b.packageName??b.event_type??'—'}</td>

                        {/* Event date */}
                        <td class="px-4 py-3 admin-table-strong">
                          {b.event_date ? new Date(b.event_date).toLocaleDateString('en-PH',{month:'short',day:'numeric',year:'numeric'}) : '—'}
                        </td>

                        {/* Hold period */}
                        <td class="px-4 py-3">
                          <div class="admin-table-meta whitespace-nowrap">
                            {new Date(b.start_date).toLocaleDateString('en-PH',{month:'short',day:'numeric'})}
                            <span class="text-gray-300 mx-1">→</span>
                            {new Date(b.end_date).toLocaleDateString('en-PH',{month:'short',day:'numeric'})}
                          </div>
                          {b.pendingRescheduleRequest && (
                            <div class="admin-table-meta mt-1 font-semibold" style="color:var(--wb-link);">
                              Reschedule requested
                            </div>
                          )}
                        </td>

                        {/* Pax */}
                        <td class="px-4 py-3 admin-table-strong text-center">{b.pax??'—'}</td>

                        {/* Total */}
                        <td class="px-4 py-3 font-bold" style="color:var(--butterscotch-primary);">
                          {b.package_type === 'custom-booking' && ((b.estimate_summary as any)?.pricingStatus !== 'finalized' || !Number(b.total_price)) ? 'To be confirmed' : b.total_price?`₱${Number(b.total_price).toLocaleString()}`:'—'}
                        </td>

                        <td class={`px-4 py-3 min-w-[190px] ${reservation.warning ? 'reservation-warning-cell' : ''}`}>
                          <span class={`reservation-badge ${reservation.className}`}>{reservation.label}</span>
                          <div class="admin-table-meta mt-1.5">
                            Deadline {b.reservation_expires_at
                              ? new Date(b.reservation_expires_at).toLocaleString('en-PH',{dateStyle:'medium',timeStyle:'short'})
                              : '—'}
                          </div>
                          <div
                            class={`reservation-countdown mt-1 text-xs font-bold ${reservation.warning ? 'text-amber-700' : 'text-gray-500'}`}
                            data-reservation-expires={b.reservation_expires_at ?? ''}
                            data-reservation-state={reservation.kind}
                          ></div>
                        </td>

                        <td class="px-4 py-3 whitespace-nowrap">
                          <span class={`payment-badge ${b.payment.payment_status === 'paid' ? 'payment-badge--paid' : b.payment.payment_status === 'partial' ? 'payment-badge--partial' : b.payment.payment_status === 'refunded' ? 'payment-badge--refunded' : 'payment-badge--unpaid'}`}>
                            {b.payment.payment_status[0].toUpperCase() + b.payment.payment_status.slice(1)}
                          </span>
                          <div class="admin-table-meta mt-1">Paid ₱{Number(b.payment.amount_paid).toLocaleString()}</div>
                        </td>

                        {/* Status */}
                        <td class="px-4 py-3">
                          <span class={`wb-badge ${statusColors[b.status]??'wb-badge--neutral'}`}>
                            {b.status === 'pending' && b.package_type === 'custom-booking' && (b.estimate_summary as any)?.pricingStatus !== 'finalized' ? 'Waiting for Quotation' : statusLabels[b.status] ?? b.status}
                          </span>
                          {b.status === 'cancelled' && (
                            <div class="mt-2 max-w-48 rounded-lg border border-red-200 bg-red-50 px-2.5 py-2 text-xs font-semibold text-red-800">
                              {isExpiredReservationCancellation(b)
                                ? 'Expired unpaid reservation. Reopening requires an admin override.'
                                : 'Cancelled reservation. Normal status actions are locked.'}
                            </div>
                          )}
                        </td>

                        {/* Booked on */}
                        <td class="px-4 py-3 admin-table-meta whitespace-nowrap">
                          {new Date(b.created_at).toLocaleDateString('en-PH',{month:'short',day:'numeric',year:'numeric'})}
                          <div class="text-gray-300">{new Date(b.created_at).toLocaleTimeString('en-PH',{hour:'2-digit',minute:'2-digit'})}</div>
                        </td>

                        {/* Actions */}
                        <td class="px-4 py-3">
                          <div class="admin-action-group flex gap-1.5 flex-wrap">
                            <button onclick={`openPaymentModal(${JSON.stringify(JSON.stringify(b))})`}
                              class="admin-action-btn admin-action-btn--primary px-2.5 py-1.5 rounded-lg text-xs font-bold text-white transition hover:opacity-80"
                              style="background:#1f6b43;">Payment</button>
                            {b.status !== 'pending' && canTransitionBookingTo(b.status, 'booked')&&(
                              <button onclick={`confirmBooking('${b.id}')`}
                                class="admin-action-btn admin-action-btn--success px-2.5 py-1.5 rounded-lg text-xs font-bold text-white transition hover:opacity-80 hover:-translate-y-0.5"
                                style="background:#157a45;">Book</button>
                            )}
                            {canTransitionBookingTo(b.status, 'rescheduled')&&(
                              <button onclick={`openReschedule('${b.id}')`}
                                class="admin-action-btn admin-action-btn--warm px-2.5 py-1.5 rounded-lg text-xs font-bold text-white transition hover:opacity-80"
                                style="background:#aa8f66;">Reschedule</button>
                            )}
                            {b.pendingRescheduleRequest && (
                              <>
                                <button onclick={`approveRescheduleRequest('${b.id}')`}
                                  class="admin-action-btn admin-action-btn--success px-2.5 py-1.5 rounded-lg text-xs font-bold text-white transition hover:opacity-80"
                                  style="background:#157a45;">Approve Request</button>
                                <button onclick={`rejectRescheduleRequest('${b.id}')`}
                                  class="admin-action-btn admin-action-btn--danger px-2.5 py-1.5 rounded-lg text-xs font-bold text-white transition hover:opacity-80"
                                  style="background:#9a4a36;">Reject Request</button>
                              </>
                            )}
                            {canTransitionBookingTo(b.status, 'cancelled')&&(
                              <button onclick={`cancelBooking('${b.id}')`}
                                class="admin-action-btn admin-action-btn--danger px-2.5 py-1.5 rounded-lg text-xs font-bold text-white transition hover:opacity-80"
                                style="background:#9a4a36;">Cancel</button>
                            )}
                            {canTransitionBookingTo(b.status, 'completed')&&(
                              <button onclick={`setBookingCompleted('${b.id}')`}
                                class="admin-action-btn admin-action-btn--neutral px-2.5 py-1.5 rounded-lg text-xs font-bold text-white transition hover:opacity-80"
                                style="background:#5e5c60;">Complete</button>
                            )}
                            {isAdmin && b.status === 'cancelled' && (
                              <div class="mt-1 w-full border-t border-red-200 pt-2">
                                <div class="mb-1 text-[10px] font-bold uppercase tracking-wider text-red-700">Manual override</div>
                                <button onclick={`manuallyReopenCancelledBooking('${b.id}', ${isExpiredReservationCancellation(b) ? 'true' : 'false'})`}
                                  class="admin-action-btn admin-action-btn--danger px-2.5 py-1.5 rounded-lg text-xs font-bold text-white transition hover:opacity-80"
                                  style="background:#9a4a36;">Reopen as booked</button>
                              </div>
                            )}
                            <button onclick={`openBookingDetail(${JSON.stringify(JSON.stringify(b))})`}
                              class="admin-action-btn admin-action-btn--outline px-2.5 py-1.5 rounded-lg text-xs font-bold border-2 transition hover:bg-gray-50"
                              style="border-color:#ddd2c1;color:#5e5c60;">View</button>
                          </div>
                        </td>
                      </tr>
                    );
                })}
              </tbody>
            </table>
          </div>
          <p id="bookingsEmptyState" class="admin-empty-state hidden px-5 py-8 text-center text-sm text-gray-400">No bookings match the current filters.</p>
        </div>
      </section>


      <!-- TAB: PACKAGES -->
      <section id="tab-packages" class="tab-section hidden">
        <div class="flex justify-between items-center mb-6">
          <h2 class="text-xl font-bold" style="color:var(--jet-primary);">Manage Packages</h2>
          <button onclick="openPackageModal()" class="px-5 py-2 rounded-lg text-white font-semibold transition hover:opacity-90" style="background:var(--butterscotch-primary);">+ Add Package</button>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
          {packages?.map((p: any) => {
            const assignedVenues = (p.venue_ids ?? []).map((venueId: string) => adminVenueById[venueId]).filter(Boolean);
            return (
            <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
              {p.thumbnail_url && <img src={p.thumbnail_url} alt="" class="package-admin-thumbnail" loading="lazy" />}
              <div class="flex justify-between items-start mb-3">
                <h3 class="font-bold text-xl" style="color:var(--jet-primary);">{p.name}</h3>
                <span class={`text-xs px-2 py-0.5 rounded-full font-bold ${p.is_active?'bg-green-100 text-green-700':'bg-gray-100 text-gray-500'}`}>{p.is_active?'Active':'Inactive'}</span>
              </div>
              <div class="mb-3">
                <p class="text-xs font-semibold uppercase tracking-wide text-gray-400">Base price</p>
                <p class="text-3xl font-black" style="color:var(--butterscotch-primary);">₱{Number(p.price).toLocaleString()}</p>
              </div>
              {p.description&&<p class="text-sm text-gray-500 mb-3">{p.description}</p>}
              {p.inclusions&&<div class="mb-3"><p class="text-xs font-semibold uppercase tracking-wide text-gray-400 mb-1">Inclusions</p><p class="text-sm text-gray-600">{p.inclusions}</p></div>}
              {(p.min_pax || p.max_pax)&&<p class="text-sm text-gray-500 mb-4">Guests: <strong>{p.min_pax ?? 1}{p.max_pax ? `-${p.max_pax}` : '+'}</strong></p>}
              <p class="package-time-summary"><strong>Time option:</strong> {formatAdminPackageTime(p.time_options)}</p>
              <div class="package-assigned-venue">
                <p>Assigned venues</p>
                {assignedVenues.length > 0 ? (
                  <span>{assignedVenues.map((venue: any) => venue.name).join(', ')}</span>
                ) : (
                  <span class="package-assigned-venue__missing">No venues selected</span>
                )}
              </div>
              <div class="flex gap-2">
                <button onclick={`openPackageModal(${JSON.stringify(JSON.stringify(p))})`} class="flex-1 py-1.5 rounded-lg text-sm font-semibold border-2 transition hover:bg-gray-50" style="border-color:var(--butterscotch-primary);color:var(--butterscotch-primary);">Edit</button>
                <button onclick={`togglePackage('${p.id}',${p.is_active})`} class={`flex-1 py-1.5 rounded-lg text-sm font-semibold text-white transition hover:opacity-80 ${p.is_active?'bg-red-400':'bg-green-500'}`}>{p.is_active?'Deactivate':'Activate'}</button>
                <button onclick={`deletePackage(${JSON.stringify(p.id)}, ${JSON.stringify(p.name)})`} class="flex-1 py-1.5 rounded-lg text-sm font-semibold border-2 transition hover:bg-red-50" style="border-color:#9a4a36;color:#9a4a36;">Delete</button>
              </div>
            </div>
          )})}
          {(!packages || packages.length === 0) && (
            <div class="col-span-full bg-white rounded-xl border border-gray-100 px-6 py-10 text-center text-sm text-gray-400">No packages found.</div>
          )}
        </div>
        <section class="admin-venues-section mt-10" aria-labelledby="admin-venues-title">
          <div class="admin-venues-section__header">
            <div>
              <h2 id="admin-venues-title">Venues</h2>
              <p>Manage the venues that can be assigned to packages.</p>
            </div>
            <button type="button" onclick="openVenueModal()">Add Venue</button>
          </div>
          {
            venues && venues.length > 0 ? (
              <div class="admin-venues-grid">
                {venues.map((venue: any) => (
                  <article class="admin-venue-card">
                    {venue.image_url ? (
                      <img src={venue.image_url} alt={`${venue.name} venue`} loading="lazy" decoding="async" />
                    ) : (
                      <div class="admin-venue-card__placeholder" aria-hidden="true">Venue</div>
                    )}
                    <div class="admin-venue-card__body">
                      <h3>{venue.name}</h3>
                      <p>{venue.description || 'No description provided.'}</p>
                      <button
                        type="button"
                        class="admin-venue-card__delete"
                        data-venue-delete={venue.id}
                        onclick={`deleteVenue(${JSON.stringify(venue.id)})`}
                      >Delete</button>
                    </div>
                  </article>
                ))}
              </div>
            ) : (
              <div class="admin-venues-empty">No venues added yet.</div>
            )
          }
        </section>
      </section>

      <!-- TAB: REVIEWS -->
      <section id="tab-reviews" class="tab-section hidden">
        <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
          <div class="px-6 py-4 border-b border-gray-100"><h2 class="font-bold text-lg" style="color:var(--jet-primary);">All Reviews</h2></div>
          <div class="divide-y divide-gray-50">
            {reviews?.map(r => (
              <div class="px-6 py-5">
                <div class="flex justify-between items-start mb-2">
                  <div>
                    <p class="font-semibold">{(r.reviewUser as any)?.first_name} {(r.reviewUser as any)?.last_name}</p>
                    <p class="text-xs text-gray-400">{(r.reviewUser as any)?.email}</p>
                  </div>
                  <div class="text-right">
                    <div class="flex gap-0.5 mb-1">{Array.from({length:5}).map((_,i)=>(<span class={i<r.rating?'text-yellow-400':'text-gray-200'}>★</span>))}</div>
                    <p class="text-xs text-gray-400">{new Date(r.created_at).toLocaleDateString('en-PH')}</p>
                  </div>
                </div>
                <p class="text-sm text-gray-500">Venue: <strong>{r.reviewVenueName}</strong></p>
                {r.comment&&<p class="text-sm text-gray-700 mt-2 bg-gray-50 rounded-lg px-4 py-3 italic">"{r.comment}"</p>}
              </div>
            ))}
            {(!reviews||reviews.length===0)&&<p class="px-6 py-12 text-center text-gray-400">No reviews yet.</p>}
          </div>
        </div>
      </section>

      <!-- TAB: USERS -->
      <section id="tab-users" class="tab-section hidden">
        <!-- Admins -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden mb-6">
          <div class="px-6 py-4 border-b border-gray-100 flex items-center gap-3">
            <h2 class="font-bold text-lg" style="color:var(--jet-primary);">Admins</h2>
            <span class="px-2 py-0.5 rounded-full text-xs font-bold bg-purple-100 text-purple-700">{allAdmins?.length ?? 0}</span>
          </div>
          <div class="overflow-x-auto">
            <table class="w-full text-sm">
              <thead><tr class="bg-gray-50 text-gray-500 text-xs uppercase tracking-wide">
                <th class="px-5 py-3 text-left">Name</th>
                <th class="px-5 py-3 text-left">Email</th>
                <th class="px-5 py-3 text-left">Joined</th>
                <th class="px-5 py-3 text-left">Actions</th>
              </tr></thead>
              <tbody>
                {allAdmins?.map(a => (
                  <tr class="border-t border-gray-50 hover:bg-gray-50">
                    <td class="px-5 py-3 font-medium">{a.first_name??''} {a.last_name??''}</td>
                    <td class="px-5 py-3 text-gray-600">{a.email??'—'}</td>
                    <td class="px-5 py-3 text-gray-400 text-xs">{new Date(a.created_at).toLocaleDateString('en-PH')}</td>
                    <td class="px-5 py-3">
                      <button onclick={`demoteUser('${a.id}')`}
                        class="px-3 py-1 rounded text-xs font-bold border-2 transition hover:bg-gray-50"
                        style="border-color:#9a4a36;color:#9a4a36;">
                        Demote to Customer
                      </button>
                    </td>
                  </tr>
                ))}
                {(!allAdmins||allAdmins.length===0)&&<tr><td colspan="4" class="px-5 py-8 text-center text-gray-400">No admins found.</td></tr>}
              </tbody>
            </table>
          </div>
        </div>

        <!-- Customers -->
        <div class="bg-white rounded-xl shadow-sm border border-gray-100 overflow-hidden">
          <div class="px-6 py-4 border-b border-gray-100 flex items-center gap-3">
            <h2 class="font-bold text-lg" style="color:var(--jet-primary);">Customers</h2>
            <span class="px-2 py-0.5 rounded-full text-xs font-bold bg-blue-100 text-blue-700">{allCustomers?.length ?? 0}</span>
          </div>
          <div class="overflow-x-auto">
            <table class="w-full text-sm">
              <thead><tr class="bg-gray-50 text-gray-500 text-xs uppercase tracking-wide">
                <th class="px-5 py-3 text-left">Name</th>
                <th class="px-5 py-3 text-left">Email</th>
                <th class="px-5 py-3 text-left">Joined</th>
                <th class="px-5 py-3 text-left">Actions</th>
              </tr></thead>
              <tbody>
                {allCustomers?.map(c => (
                  <tr class="border-t border-gray-50 hover:bg-gray-50">
                    <td class="px-5 py-3 font-medium">{c.first_name??''} {c.last_name??''}</td>
                    <td class="px-5 py-3 text-gray-600">{c.email??'—'}</td>
                    <td class="px-5 py-3 text-gray-400 text-xs">{new Date(c.created_at).toLocaleDateString('en-PH')}</td>
                    <td class="px-5 py-3">
                      <div class="flex flex-wrap gap-2">
                        <button onclick={`promoteStaff('${c.id}')`}
                          class="px-3 py-1 rounded text-xs font-bold border-2 transition hover:bg-gray-50"
                          style="border-color:#157a45;color:#157a45;">
                          Promote to Staff
                        </button>
                        <button onclick={`promoteUser('${c.id}')`}
                          class="px-3 py-1 rounded text-xs font-bold border-2 transition hover:bg-gray-50"
                          style="border-color:var(--butterscotch-primary);color:var(--butterscotch-primary);">
                          Promote to Admin
                        </button>
                      </div>
                    </td>
                  </tr>
                ))}
                {(!allCustomers||allCustomers.length===0)&&<tr><td colspan="4" class="px-5 py-8 text-center text-gray-400">No customers yet.</td></tr>}
              </tbody>
            </table>
          </div>
        </div>
      </section>

      {isAdmin && (
        <section id="tab-staff-management" class="tab-section hidden">
          <div class="staff-heading">
            <div>
              <p class="staff-eyebrow">Account administration</p>
              <h2>Staff Management</h2>
              <p>Create staff sign-ins, update basic details, and control access without changing customer accounts.</p>
            </div>
            <button type="button" class="staff-primary-btn" onclick="openStaffModal()">Add staff account</button>
          </div>
          <div class="staff-summary">
            <div><strong>{allEmployees?.length ?? 0}</strong><span>Total staff</span></div>
            <div><strong>{allEmployees?.filter((employee) => employee.is_active).length ?? 0}</strong><span>Active</span></div>
            <div><strong>{allEmployees?.filter((employee) => !employee.is_active).length ?? 0}</strong><span>Inactive</span></div>
          </div>
          <div class="staff-table-card">
            <div class="overflow-x-auto">
              <table class="w-full text-sm staff-table">
                <thead><tr><th>Name</th><th>Contact</th><th>Position</th><th>Status</th><th>Added</th><th>Actions</th></tr></thead>
                <tbody>
                  {allEmployees?.map((employee) => (
                    <tr>
                      <td class="font-semibold">{employee.first_name} {employee.last_name}</td>
                      <td><span>{employee.email ?? '—'}</span><small>{employee.phone || 'No phone provided'}</small></td>
                      <td>{employee.position || 'Staff'}</td>
                      <td><span class={`staff-status ${employee.is_active ? 'active' : 'inactive'}`}>{employee.is_active ? 'Active' : 'Inactive'}</span></td>
                      <td>{new Date(employee.created_at).toLocaleDateString('en-PH')}</td>
                      <td><div class="staff-actions">
                        <button type="button" onclick={`openStaffModal(${JSON.stringify(employee)})`}>Edit</button>
                        <button type="button" class={employee.is_active ? 'danger' : 'activate'} onclick={`setStaffStatus('${employee.id}', '${employee.is_active ? 'deactivate' : 'activate'}')`}>{employee.is_active ? 'Deactivate' : 'Activate'}</button>
                      </div></td>
                    </tr>
                  ))}
                  {(!allEmployees || allEmployees.length === 0) && <tr><td colspan="6" class="staff-empty">No staff accounts yet.</td></tr>}
                </tbody>
              </table>
            </div>
          </div>
        </section>
      )}

      <!-- TAB: REPORTS -->
      <section id="tab-reports" class="tab-section hidden">

        <div class="reports-intro mb-6">
          <p class="reports-eyebrow">Financial overview</p>
          <h2>Sales Reports</h2>
          <p>Review bookings, collections, outstanding balances, and package performance for a selected week or month.</p>
        </div>

        <!-- Period selector -->
        <div class="flex flex-wrap gap-3 items-center mb-6">
          <div class="flex rounded-xl overflow-hidden border-2 border-gray-200">
            <button id="rpt-btn-weekly"  onclick="switchReport('weekly')"  class="rpt-mode-btn px-5 py-2 text-sm font-semibold transition-all">Weekly</button>
            <button id="rpt-btn-monthly" onclick="switchReport('monthly')" class="rpt-mode-btn px-5 py-2 text-sm font-semibold transition-all">Monthly</button>
          </div>

          <!-- Week picker -->
          <div id="rpt-week-picker" class="flex items-center gap-2">
            <label class="text-sm font-semibold text-gray-500">Week containing:</label>
            <input type="date" id="rpt-week-input" class="px-3 py-1.5 rounded-lg border border-gray-200 text-sm focus:outline-none" />
          </div>

          <!-- Month picker -->
          <div id="rpt-month-picker" class="hidden flex items-center gap-2">
            <label class="text-sm font-semibold text-gray-500">Month:</label>
            <input type="month" id="rpt-month-input" class="px-3 py-1.5 rounded-lg border border-gray-200 text-sm focus:outline-none" />
          </div>

          <button id="generate-report-button" onclick="generateReport()" class="px-5 py-2 rounded-xl text-white text-sm font-bold transition hover:opacity-90" style="background:var(--butterscotch-primary);">Generate Report</button>
          <button onclick="printReport()" class="px-5 py-2 rounded-xl text-sm font-bold border-2 transition hover:bg-gray-50" style="border-color:var(--butterscotch-primary);color:var(--butterscotch-primary);">🖨 Print / Save PDF</button>
        </div>

        <!-- Report output (printable area) -->
        <div id="report-output" class="bg-white rounded-xl shadow-sm border border-gray-100 p-8 hidden">

          <!-- Report header -->
          <div class="flex justify-between items-start mb-6 pb-5 border-b border-gray-100">
            <div>
              <h2 id="rpt-title" class="text-2xl font-black" style="color:var(--jet-primary);"></h2>
              <p id="rpt-period" class="text-sm text-gray-400 mt-0.5"></p>
            </div>
            <p class="text-xs text-gray-400">Generated: <span id="rpt-generated"></span></p>
          </div>

          <!-- Metric cards -->
          <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4 mb-8">
            {[
              { id:'rpt-total', label:'Total Reservations', color:'#7c6246', icon:'BK' },
              { id:'rpt-pending', label:'Pending Reservations', color:'#aa8f66', icon:'PD' },
              { id:'rpt-cancelled', label:'Cancellations', color:'#9a4a36', icon:'CX' },
              { id:'rpt-gross', label:'Gross Revenue', color:'#1f6b43', icon:'GR' },
              { id:'rpt-paid', label:'Paid Revenue', color:'#157a45', icon:'PR' },
              { id:'rpt-unpaid', label:'Unpaid Balance', color:'#9a4a36', icon:'UB' },
              { id:'rpt-top-package', label:'Top Package', color:'#aa8f66', icon:'TP' },
            ].map(c => (
              <div class="rounded-xl p-4 border border-gray-100 bg-gray-50 flex flex-col items-center text-center">
                <span class="text-2xl mb-1">{c.icon}</span>
                <p class="text-xs uppercase tracking-wide text-gray-400 font-semibold mb-1">{c.label}</p>
                <p id={c.id} class="text-2xl font-black" style={`color:${c.color}`}>—</p>
              </div>
            ))}
          </div>

          <!-- Distribution by date -->
          <div class="mb-8">
            <h3 class="text-sm font-bold uppercase tracking-wide text-gray-400 mb-3">Booking Distribution by Date</h3>
            <div id="rpt-distribution" class="space-y-2 text-sm"></div>
          </div>

          <!-- Breakdown by event type/package -->
          <div class="mb-8">
            <h3 class="text-sm font-bold uppercase tracking-wide text-gray-400 mb-3">Revenue by Package</h3>
            <div id="rpt-breakdown" class="overflow-x-auto">
              <table class="w-full text-sm">
                <thead><tr class="bg-gray-50 text-gray-500 text-xs uppercase tracking-wide">
                  <th class="px-4 py-2 text-left">Event / Package</th>
                  <th class="px-4 py-2 text-left">Bookings</th>
                  <th class="px-4 py-2 text-left">Gross Revenue</th>
                </tr></thead>
                <tbody id="rpt-breakdown-body"></tbody>
              </table>
            </div>
          </div>

          <!-- Bookings table -->
          <div>
            <h3 class="text-sm font-bold uppercase tracking-wide text-gray-400 mb-3">All Bookings in Period</h3>
            <div class="overflow-x-auto">
              <table class="w-full text-sm">
                <thead><tr class="bg-gray-50 text-gray-500 text-xs uppercase tracking-wide">
                  <th class="px-3 py-2 text-left">Guest</th>
                  <th class="px-3 py-2 text-left">Venue</th>
                  <th class="px-3 py-2 text-left">Package</th>
                  <th class="px-3 py-2 text-left">Event Date</th>
                  <th class="px-3 py-2 text-left">Pax</th>
                  <th class="px-3 py-2 text-left">Total</th>
                  <th class="px-3 py-2 text-left">Status</th>
                </tr></thead>
                <tbody id="rpt-bookings-body"></tbody>
              </table>
            </div>
          </div>

          <div class="forecast-panel mb-8">
            <div class="flex flex-wrap items-start justify-between gap-3 mb-4">
              <div>
                <p class="reports-eyebrow">Estimate</p>
                <h3 class="text-lg font-bold" style="color:var(--jet-primary);">Next Month Sales Forecast</h3>
                <p id="rpt-forecast-period" class="text-sm text-gray-500"></p>
              </div>
              <span class="forecast-badge">Estimate only</span>
            </div>
            <p id="rpt-forecast-unavailable" class="report-period-note hidden"></p>
            <div id="rpt-forecast-results" class="grid grid-cols-1 sm:grid-cols-3 gap-4 hidden">
              <div><p>Expected bookings</p><strong id="rpt-forecast-bookings">—</strong></div>
              <div><p>Expected revenue</p><strong id="rpt-forecast-revenue">—</strong></div>
              <div><p>Likely top package</p><strong id="rpt-forecast-package">—</strong></div>
            </div>
            <p id="rpt-forecast-method" class="forecast-method hidden"></p>
          </div>

          <div class="mt-8">
            <h3 class="text-sm font-bold uppercase tracking-wide text-gray-400 mb-3">Cancellation Statistics</h3>
            <div class="overflow-x-auto">
              <table class="w-full text-sm">
                <thead><tr class="bg-gray-50 text-gray-500 text-xs uppercase tracking-wide">
                  <th class="px-4 py-2 text-left">Measure</th>
                  <th class="px-4 py-2 text-left">Result</th>
                  <th class="px-4 py-2 text-left">Context</th>
                </tr></thead>
                <tbody>
                  <tr class="border-t border-gray-50"><td class="px-4 py-2 font-medium">Cancelled bookings</td><td id="rpt-cancel-count" class="px-4 py-2 font-bold">—</td><td class="px-4 py-2 text-gray-500">Bookings created in this period</td></tr>
                  <tr class="border-t border-gray-50"><td class="px-4 py-2 font-medium">Cancellation rate</td><td id="rpt-cancel-rate" class="px-4 py-2 font-bold">—</td><td class="px-4 py-2 text-gray-500">Cancellations as a share of bookings</td></tr>
                  <tr class="border-t border-gray-50"><td class="px-4 py-2 font-medium">Cancelled booking value</td><td id="rpt-cancel-value" class="px-4 py-2 font-bold">—</td><td class="px-4 py-2 text-gray-500">Gross value attached to cancellations</td></tr>
                  <tr class="border-t border-gray-50"><td class="px-4 py-2 font-medium">Retained payments</td><td id="rpt-cancel-retained" class="px-4 py-2 font-bold">—</td><td class="px-4 py-2 text-gray-500">Payments not marked as refunded</td></tr>
                </tbody>
              </table>
            </div>
          </div>

        </div><!-- /report-output -->

        <div id="report-empty" class="text-center py-16 text-gray-400">
          <p class="text-4xl mb-3">📈</p>
          <p class="font-semibold">Select a period and click <strong>Generate Report</strong></p>
        </div>

      </section>

      <!-- TAB: AVAILABILITY CALENDAR -->
      <section id="tab-calendar" class="tab-section hidden">
        <div class="flex flex-wrap gap-4 items-start justify-between mb-6">
          <div>
            <h2 class="text-xl font-bold" style="color:var(--jet-primary);">Availability Calendar</h2>
            <p class="text-sm text-gray-500 mt-0.5">Click any date to view bookings. Book, cancel, complete, or reschedule from here.</p>
          </div>
          <div class="flex gap-2 flex-wrap items-center">
            <button id="adm-prev-month" class="w-9 h-9 rounded-lg border-2 border-gray-200 flex items-center justify-center hover:bg-gray-50 transition text-gray-600">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"/></svg>
            </button>
            <span id="adm-month-label" class="font-bold text-lg px-3" style="color:var(--jet-primary);min-width:160px;text-align:center;"></span>
            <button id="adm-next-month" class="w-9 h-9 rounded-lg border-2 border-gray-200 flex items-center justify-center hover:bg-gray-50 transition text-gray-600">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
            </button>
          </div>
        </div>

        <div class="blocked-date-manager mb-6">
          <form id="blockedDateForm" class="blocked-date-form">
            <div>
              <label for="blockedVenue">Venue</label>
              <select id="blockedVenue" required>
                <option value="">Select venue</option>
                {(venues ?? []).map((venue: any) => (
                  <option value={venue.id}>{venue.name}</option>
                ))}
              </select>
            </div>
            <div>
              <label for="blockedStartDate">Start date</label>
              <input id="blockedStartDate" type="date" required />
            </div>
            <div>
              <label for="blockedEndDate">End date</label>
              <input id="blockedEndDate" type="date" required />
            </div>
            <div class="blocked-date-form__reason">
              <label for="blockedReason">Reason</label>
              <textarea id="blockedReason" rows="2" maxlength="500" required placeholder="Maintenance, private event, venue closure..."></textarea>
            </div>
            <button type="submit">Block Dates</button>
          </form>
          <div class="blocked-date-list-wrap">
            <div class="blocked-date-list-wrap__header">
              <h3>Active blocked dates</h3>
              <button id="refreshBlockedDates" type="button">Refresh</button>
            </div>
            <div id="blockedDateList" class="blocked-date-list">
              <p class="blocked-date-empty">Loading blocked dates...</p>
            </div>
          </div>
        </div>

        <div class="flex gap-4 flex-wrap mb-5">
          {[
            { bg:'#e7efe8', ring:'#157a45', label:'Available' },
            { bg:'#fbe7df', ring:'#9a4a36', label:'Reserved / booked' },
            { bg:'#f7f2ea', ring:'#aa8f66', label:'Admin blocked' },
          ].map(l => (
            <div class="flex items-center gap-2">
              <div class="w-5 h-5 rounded-md" style={`background:${l.bg};outline:1.5px solid ${l.ring};`}></div>
              <span class="text-sm font-medium text-gray-600">{l.label}</span>
            </div>
          ))}
        </div>

        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden">
          <div style="display:grid;grid-template-columns:repeat(7,1fr);background:#f9fafb;border-bottom:1px solid #f3f4f6;">
            {['Mon','Tue','Wed','Thu','Fri','Sat','Sun'].map(d => (
              <div style="text-align:center;font-size:0.78rem;font-weight:700;color:#6b7280;padding:10px 0;">{d}</div>
            ))}
          </div>
          <div id="adm-cal-grid" style="display:grid;grid-template-columns:repeat(7,1fr);"></div>
          <div id="adm-cal-loading" style="display:none;text-align:center;padding:20px;color:#888;font-size:0.875rem;">Loading bookings…</div>
        </div>

        <div id="adm-day-detail" class="hidden mt-6 bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
          <div class="flex justify-between items-center mb-4">
            <h3 id="adm-detail-date" class="text-lg font-bold" style="color:var(--jet-primary);"></h3>
            <button id="adm-detail-close" class="text-gray-400 hover:text-gray-600 text-xl leading-none">&times;</button>
          </div>
          <div id="adm-detail-content" class="space-y-3 text-sm"></div>
        </div>
      </section>

    </div>
  </main>
</div>

