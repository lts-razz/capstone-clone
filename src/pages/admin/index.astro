      <div>
        <p class="text-xs font-bold uppercase tracking-widest text-gray-400 mb-3">Selections &amp; Optionals</p>
        <div class="grid grid-cols-2 gap-x-6 gap-y-3 text-sm">
          <div class="col-span-2"><span class="text-gray-400">Package Inclusions</span><div id="bd-inclusions" class="mt-1"></div></div>
          <div><span class="text-gray-400">Selected Rooms</span><div id="bd-rooms" class="mt-1"></div></div>
          <div><span class="text-gray-400">Optionals / Add-ons</span><div id="bd-addons" class="mt-1"></div></div>
          <div><span class="text-gray-400">Extensions</span><div id="bd-extensions" class="mt-1"></div></div>
          <div><span class="text-gray-400">Corkage</span><div id="bd-corkage" class="mt-1"></div></div>
          <div class="col-span-2"><span class="text-gray-400">Caterer</span><p id="bd-caterer" class="font-semibold mt-0.5"></p></div>
        </div>
      </div>

      <!-- Special requests -->
