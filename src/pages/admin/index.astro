    border: 1px dashed color-mix(in srgb, var(--wb-earth) 40%, var(--wb-border));
    border-radius: var(--wb-radius-sm);
    background: var(--wb-warm-soft);
    padding: 1rem;
    text-align: center;
  }

  .package-form-empty strong {
    color: var(--wb-earth);
    font-size: 0.85rem;
  }

  .package-form-empty p {
    margin: 0.25rem 0 0;
    color: var(--wb-muted);
    font-size: 0.76rem;
  }

  .package-booking-defaults {
    display: grid;
    gap: 0.9rem;
    margin: 0;
    border: 1px solid var(--wb-border);
    border-radius: var(--wb-radius-md);
    background: var(--wb-surface-soft);
    padding: 1rem;
  }

  .package-booking-defaults > legend {
    padding: 0 0.35rem;
    color: var(--wb-green-dark);
    font-family: Georgia, "Times New Roman", serif;
    font-size: 1rem;
    font-weight: 900;
  }

  .package-booking-defaults__intro {
    margin: 0;
    border-left: 3px solid var(--wb-green);
    color: var(--wb-muted);
    font-size: 0.77rem;
