    </div>
    <div id="customPricingNotice" class="hidden mb-4 rounded-xl border px-4 py-3 text-sm" style="border-color:var(--wb-green-pale);background:var(--wb-green-soft);color:var(--wb-link);">
      <strong class="block">Custom booking price review</strong>
      <p id="customPricingEstimate" class="mt-1"></p>
      <p class="mt-1">Enter the final payable amount below. Saving it separately enables customer checkout; the submitted rough estimate remains unchanged.</p>
    </div>
    <div id="paymentReservationNotice" class="reservation-detail-panel mb-4 text-sm">
      <div class="flex flex-wrap items-center justify-between gap-2">
        <span id="paymentReservationBadge" class="reservation-badge"></span>
        <strong id="paymentReservationRemaining"></strong>
      </div>
      <p id="paymentReservationExpiration" class="mt-2 text-xs text-gray-500"></p>
    </div>
    <input id="paymentBookingId" type="hidden" />
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div><label id="paymentTotalLabel" class="block text-sm font-semibold mb-1">Total Booking Amount *</label><input id="paymentTotal" type="number" min="0" step="0.01" class="w-full p-2.5 rounded-xl border border-gray-200" /></div>
      <div><label class="block text-sm font-semibold mb-1">Required 50% Minimum</label><input id="paymentMinimum" type="text" readonly class="w-full p-2.5 rounded-xl border border-gray-200 bg-gray-50" /></div>
      <div><label class="block text-sm font-semibold mb-1">Amount Paid *</label><input id="paymentAmountPaid" type="number" min="0" step="0.01" class="w-full p-2.5 rounded-xl border border-gray-200" /></div>
      <div><label class="block text-sm font-semibold mb-1">Remaining Balance</label><input id="paymentBalance" type="text" readonly class="w-full p-2.5 rounded-xl border border-gray-200 bg-gray-50" /></div>
      <div><label class="block text-sm font-semibold mb-1">Payment Status *</label><select id="paymentStatus" class="w-full p-2.5 rounded-xl border border-gray-200"><option value="unpaid">Unpaid</option><option value="partial">Partial</option><option value="paid">Paid</option><option value="refunded">Refunded</option></select></div>
      <div><label class="block text-sm font-semibold mb-1">Payment Method</label><input id="paymentMethod" type="text" maxlength="100" placeholder="Cash, bank transfer, etc." class="w-full p-2.5 rounded-xl border border-gray-200" /></div>
      <div class="sm:col-span-2"><label class="block text-sm font-semibold mb-1">Payment Recorded Date</label><input id="paymentRecordedAt" type="datetime-local" class="w-full p-2.5 rounded-xl border border-gray-200" /></div>
      <div class="sm:col-span-2"><label class="block text-sm font-semibold mb-1">Payment Notes</label><textarea id="paymentNotes" rows="3" maxlength="2000" class="w-full p-2.5 rounded-xl border border-gray-200 resize-y"></textarea></div>
    </div>
    <div class="flex flex-col-reverse sm:flex-row justify-end gap-3 mt-6">
      <button onclick="closePaymentModal()" class="px-5 py-2.5 rounded-xl border-2 font-semibold">Cancel</button>
      <button id="savePaymentButton" onclick="submitPayment()" class="px-5 py-2.5 rounded-xl text-white font-semibold" style="background:#157a45;">Save Payment</button>
    </div>
  </div>
</div>

<!-- CUSTOM CONFIRM DIALOG (replaces all browser confirm() popups) -->
<div id="confirmDialog" class="hidden fixed inset-0 z-[60] flex items-center justify-center" style="background:rgba(0,0,0,0.55);">
  <div class="bg-white rounded-2xl shadow-2xl w-full max-w-sm mx-4 overflow-hidden">
    <!-- Icon + header -->
    <div id="confirmDialogHeader" class="px-6 pt-6 pb-4 flex flex-col items-center text-center">
      <div id="confirmDialogIcon" class="w-14 h-14 rounded-full flex items-center justify-center text-2xl mb-3"></div>
      <h3 id="confirmDialogTitle" class="text-lg font-black" style="color:var(--jet-primary);"></h3>
      <p id="confirmDialogMessage" class="text-sm text-gray-500 mt-1"></p>
      <div id="confirmDialogReasonWrap" class="hidden w-full mt-4 text-left">
        <label id="confirmDialogReasonLabel" for="confirmDialogReason" class="block text-xs font-black uppercase tracking-wide text-gray-500 mb-1">Reason</label>
        <textarea id="confirmDialogReason" rows="3" maxlength="500" class="w-full rounded-xl border border-gray-200 p-3 text-sm focus:outline-none focus:ring-2 focus:ring-green-200" placeholder="Enter reason"></textarea>
      </div>
    </div>
    <!-- Buttons -->
    <div class="px-6 pb-6 flex gap-3">
      <button id="confirmDialogCancel" class="flex-1 py-2.5 rounded-xl border-2 font-semibold text-sm transition hover:bg-gray-50" style="border-color:#d1d5db;color:#374151;">
        Cancel
      </button>
      <button id="confirmDialogOk" class="flex-1 py-2.5 rounded-xl text-white font-semibold text-sm transition hover:opacity-90">
        Confirm
      </button>
    </div>
  </div>
</div>

<!-- RESCHEDULE MODAL -->
<div id="rescheduleModal" class="hidden fixed inset-0 z-50 flex items-center justify-center" style="background:rgba(0,0,0,0.5);">
  <div class="bg-white rounded-xl shadow-2xl w-full max-w-md mx-4 p-6">
    <h3 class="text-xl font-bold mb-5" style="color:var(--jet-primary);">Reschedule Booking</h3>
    <input id="rescheduleBookingId" type="hidden" />
    <div class="space-y-4">
      <div><label class="block text-sm font-semibold mb-1">New Event Date</label><input type="date" id="rescheduleEventDate" class="w-full p-2 rounded-lg border border-gray-200 focus:outline-none" /></div>
      <div><label class="block text-sm font-semibold mb-1">New Check-in *</label><input type="date" id="rescheduleStart" class="w-full p-2 rounded-lg border border-gray-200 focus:outline-none" required /></div>
      <div><label class="block text-sm font-semibold mb-1">New Check-out *</label><input type="date" id="rescheduleEnd" class="w-full p-2 rounded-lg border border-gray-200 focus:outline-none" required /></div>
      <p id="rescheduleOverrideWarning" class="hidden rounded-lg border px-3 py-2 text-sm font-semibold"></p>
    </div>
    <div class="flex gap-3 mt-6">
      <button onclick="closeReschedule()" class="flex-1 py-2 rounded-lg border-2 font-semibold" style="border-color:var(--lion-light);">Cancel</button>
      <button onclick="submitReschedule()" class="flex-1 py-2 rounded-lg text-white font-semibold" style="background:var(--butterscotch-primary);">Reschedule</button>
    </div>
  </div>
</div>

<!-- VENUE MODAL -->
<div id="venueModal" class="hidden fixed inset-0 z-50 flex items-center justify-center" style="background:rgba(0,0,0,0.5);">
  <div class="bg-white rounded-xl shadow-2xl w-full max-w-lg mx-4 p-6 max-h-[90vh] overflow-y-auto">
    <h3 id="venueModalTitle" class="text-xl font-bold mb-2" style="color:var(--jet-primary);">Add Venue</h3>
    <p class="text-sm text-gray-500 mb-5">Create a venue that can be assigned to packages.</p>
    <form id="venueForm" method="post" enctype="multipart/form-data" class="space-y-4">
      <div>
        <label class="block text-sm font-semibold mb-1" for="venueName">Name *</label>
        <input type="text" id="venueName" name="name" maxlength="200" required class="w-full p-2 rounded-lg border border-gray-200 focus:outline-none" />
      </div>
      <div>
        <label class="block text-sm font-semibold mb-1" for="venueDesc">Description *</label>
        <textarea id="venueDesc" name="description" rows="3" maxlength="2000" required class="w-full p-2 rounded-lg border border-gray-200 focus:outline-none resize-none"></textarea>
      </div>
      <div>
        <label class="block text-sm font-semibold mb-1" for="venueImage">Image upload *</label>
        <input type="file" id="venueImage" name="image" accept="image/jpeg,image/png,image/webp,image/gif" required class="w-full p-2 rounded-lg border border-gray-200 focus:outline-none" />
        <p class="text-xs text-gray-400 mt-1">JPEG, PNG, WebP, or GIF only, up to 5 MB.</p>
      </div>
      <p id="venueError" class="hidden rounded-lg border border-red-100 bg-red-50 px-3 py-2 text-sm font-semibold text-red-700"></p>
      <div class="flex gap-3 pt-2">
        <button type="button" onclick="closeVenueModal()" class="flex-1 py-2 rounded-lg border-2 font-semibold" style="border-color:var(--lion-light);">Cancel</button>
        <button type="submit" id="venueSubmit" class="flex-1 py-2 rounded-lg text-white font-semibold" style="background:var(--wb-green);">Save</button>
      </div>
    </form>
  </div>
</div>

<!-- PACKAGE MODAL -->
<div id="packageModal" class="hidden fixed inset-0 z-50 flex items-center justify-center" role="dialog" aria-modal="true" aria-labelledby="packageModalTitle" style="background:rgba(0,0,0,0.5);">
  <div class="package-modal-card">
    <header class="package-modal-header">
      <div>
        <p class="package-modal-eyebrow">Package configuration</p>
        <h3 id="packageModalTitle">Add Package</h3>
        <p>Set the package basics, included venues, booking presets, and public thumbnail.</p>
      </div>
      <button type="button" class="package-modal-close" onclick="closePackageModal()" aria-label="Close package form">×</button>
    </header>
    <input id="packageId" type="hidden" />
    <input id="packageThumbnailUrl" type="hidden" />
    <div class="package-modal-body">
      <section class="package-form-section" aria-labelledby="package-basic-title">
        <div class="package-form-section__heading">
          <span>01</span>
          <div><h4 id="package-basic-title">Basic package details</h4><p>Name and describe the package customers will browse.</p></div>
        </div>
        <div class="package-form-fields">
          <label class="package-form-field package-form-field--full" for="packageName">
            <span>Package name <b aria-hidden="true">*</b></span>
            <input type="text" id="packageName" aria-required="true" />
          </label>
          <label class="package-form-field package-form-field--full" for="packageDesc">
            <span>Description</span>
            <textarea id="packageDesc" rows="3" placeholder="Describe the experience, ideal occasion, or standout features."></textarea>
            <small>Keep this concise and useful for customers comparing packages.</small>
          </label>
        </div>
      </section>

      <section class="package-form-section" aria-labelledby="package-pricing-title">
        <div class="package-form-section__heading">
          <span>02</span>
          <div><h4 id="package-pricing-title">Time and pricing</h4><p>Set the base rate, capacity, and package schedule.</p></div>
        </div>
        <div class="package-form-fields">
          <label class="package-form-field" for="packagePrice">
            <span>Base price (₱) <b aria-hidden="true">*</b></span>
            <input type="number" id="packagePrice" min="0" inputmode="decimal" aria-required="true" />
            <small>Saved exactly as entered. Presets and inclusions do not change it.</small>
          </label>
          <label class="package-form-field" for="packageMaxPax">
            <span>Maximum guests</span>
            <input type="number" id="packageMaxPax" min="1" inputmode="numeric" placeholder="e.g. 200" />
            <small>The customer form uses this as the package guest limit.</small>
          </label>
          <label class="package-form-field" for="packageMinPax">
            <span>Minimum guests</span>
            <input type="number" id="packageMinPax" min="1" inputmode="numeric" placeholder="e.g. 80" />
            <small>The customer form uses this as the lower guest limit.</small>
          </label>
          <fieldset class="package-time-options package-form-field--full">
            <legend>Package time option <b aria-hidden="true">*</b></legend>
            <div class="package-time-options__grid">
              <label class="package-form-field" for="packageTimeMode">
                <span>Time rule</span>
                <select id="packageTimeMode">
                  <option value="fixed_range">Time range only</option>
                  <option value="duration">Specific duration only</option>
                  <option value="range_duration">Time range + specific duration</option>
                </select>
              </label>
              <div id="packageFixedTimeFields" class="package-time-fields">
                <label class="package-form-field" for="packageFromTime"><span>Starts at</span><input type="time" id="packageFromTime" /></label>
                <label class="package-form-field" for="packageToTime"><span>Ends at</span><input type="time" id="packageToTime" /></label>
              </div>
              <div id="packageDurationFields" class="package-time-fields hidden">
                <label class="package-form-field" for="packageDurationHours"><span>Duration in hours</span><input type="number" id="packageDurationHours" min="0.5" max="168" step="0.5" /></label>
              </div>
            </div>
            <p class="package-form-helper">A time range lets customers choose any interval inside it. A duration requires an exact interval. When both are selected, both rules apply.</p>
          </fieldset>
        </div>
      </section>

      <section class="package-form-section" aria-labelledby="package-venues-title">
        <div class="package-form-section__heading">
          <span>03</span>
          <div><h4 id="package-venues-title">Venue assignment</h4><p>Choose every active space included with this package.</p></div>
        </div>
        <fieldset class="package-form-fieldset">
          <legend class="sr-only">Assigned venues</legend>
          <div id="packageVenuePicker" class="package-venue-picker">
            {(venues ?? []).map((venue: any) => (
              <label class="package-venue-option">
                <input type="checkbox" name="packageVenueIds" value={venue.id} />
                <span><strong>{venue.name}</strong>{venue.description && <small>{venue.description}</small>}</span>
              </label>
            ))}
            {(venues ?? []).length === 0 && (
              <div class="package-form-empty">
                <strong>No active venues available</strong>
                <p>Add or activate a venue before assigning one to this package.</p>
              </div>
            )}
          </div>
          <p class="package-form-helper">A package can be saved without a venue, but public booking remains unavailable until an active venue is assigned.</p>
        </fieldset>
      </section>

      <section class="package-form-section" aria-labelledby="package-options-title">
        <div class="package-form-section__heading">
          <span>04</span>
          <div><h4 id="package-options-title">Inclusions, presets, and optionals</h4><p>Use the same optionals customers see in the booking form. These settings prepare defaults only; they do not change the manual base price.</p></div>
        </div>
        <label class="package-form-field" for="packageInclusions">
          <span>Package inclusions</span>
          <textarea id="packageInclusions" rows="3" placeholder="e.g. Tables, chairs, basic sound setup, selected room inclusions"></textarea>
          <small>Separate inclusions with commas or new lines so they are easy to scan.</small>
        </label>

        <fieldset class="package-form-fieldset">
          <legend>Available celebration types</legend>
          <div class="package-default-grid">
            {BOOKING_EVENT_TYPES.map((eventType) => (
              <label class="package-default-option__choice">
                <input type="checkbox" name="packageAllowedEventTypes" value={eventType.key} />
                <span><strong>{eventType.label}</strong><small>Allow this event type in the customer booking form.</small></span>
              </label>
            ))}
          </div>
          <p class="package-form-helper">Leave all unchecked to allow every celebration type. Event type still starts blank for customers.</p>
        </fieldset>

        <fieldset class="package-booking-defaults">
          <legend>Booking form presets</legend>
          <p class="package-booking-defaults__intro">Selected options appear pre-selected for customers. Use "Require selected" only when the package requires that choice. Use "Disable" for choices or sections customers cannot add. Mark included items when they are already covered by the manually entered base price.</p>

          <div class="package-booking-defaults__base">
            <div class="package-default-option">
              <label class="package-default-option__choice">
                <input type="checkbox" id="packageDefaultMultiDay" />
                <span><strong>Multi-day stay</strong><small>Pre-select the booking form's multi-day option.</small></span>
              </label>
              <label class="package-default-option__lock"><input type="checkbox" id="packageLockMultiDay" /> Require selected</label>
            </div>
          </div>

          <details class="package-default-group" open>
            <summary><span><strong>Rooms</strong><small>Room selections and additional room hours</small></span><em>{ROOM_RATE_OPTIONS.length + 1} choices</em></summary>
            <div class="package-default-group__content">
              <label class="package-section-lock"><input type="checkbox" name="packageLockedSections" value="rooms" /> Disable the Rooms section for this package</label>
              <div class="package-default-grid">
                {ROOM_RATE_OPTIONS.map((item) => (
                  <div class="package-default-option">
                    <label class="package-default-option__choice">
                      <input type="checkbox" name="packageDefaultRooms" value={item.key} />
                      <span><strong>{item.label}</strong><small>{item.detail} - &#8369;{item.price.toLocaleString()}</small></span>
                    </label>
                    <label class="package-default-option__lock"><input type="checkbox" name="packageLockedRooms" value={item.key} /> Require selected</label>
                    <label class="package-default-option__lock"><input type="checkbox" name="packageIncludedRooms" value={item.key} /> Included in base price</label>
                    <label class="package-default-option__lock package-default-option__lock--danger"><input type="checkbox" name="packageDisabledRooms" value={item.key} /> Disable choice</label>
                  </div>
                ))}
              </div>
              <div class="package-default-field package-default-field--hours">
                <label for="packageDefaultRoomExtensionHours">{ROOM_EXTENSION_OPTION.label}</label>
                <input id="packageDefaultRoomExtensionHours" type="number" min="0" max="168" step="1" value="0" />
                <small>{ROOM_EXTENSION_OPTION.detail} - &#8369;{ROOM_EXTENSION_OPTION.price.toLocaleString()} per extra hour</small>
                <label class="package-default-option__lock"><input type="checkbox" id="packageLockRoomExtensionHours" /> Require selected</label>
                <label class="package-default-option__lock"><input type="checkbox" id="packageIncludeRoomExtensionHours" /> Included in base price</label>
                <label class="package-default-option__lock package-default-option__lock--danger"><input type="checkbox" id="packageDisableRoomExtensionHours" /> Disable choice</label>
              </div>
            </div>
          </details>

          <details class="package-default-group" open>
            <summary><span><strong>Equipment and Entertainment Add-ons</strong><small>Woodberry equipment and entertainment</small></span><em>{ADD_ON_OPTIONS.length} choices</em></summary>
            <div class="package-default-group__content">
              <label class="package-section-lock"><input type="checkbox" name="packageLockedSections" value="addOns" /> Disable the Add-ons section for this package</label>
              <div class="package-default-grid">
                {ADD_ON_OPTIONS.map((item) => (
                  <div class="package-default-option">
                    <label class="package-default-option__choice">
                      <input type="checkbox" name="packageDefaultAddOns" value={item.key} />
                      <span><strong>{item.label}</strong><small>&#8369;{item.price.toLocaleString()}</small></span>
                    </label>
                    <label class="package-default-option__lock"><input type="checkbox" name="packageLockedAddOns" value={item.key} /> Require selected</label>
                    <label class="package-default-option__lock"><input type="checkbox" name="packageIncludedAddOns" value={item.key} /> Included in base price</label>
                    <label class="package-default-option__lock package-default-option__lock--danger"><input type="checkbox" name="packageDisabledAddOns" value={item.key} /> Disable choice</label>
                  </div>
                ))}
              </div>
            </div>
          </details>

          <details class="package-default-group" open>
            <summary><span><strong>Extra Time and Guest Capacity</strong><small>Hourly extensions and capacity blocks</small></span><em>{EXTENSION_OPTIONS.length} choices</em></summary>
            <div class="package-default-group__content">
              <label class="package-section-lock"><input type="checkbox" name="packageLockedSections" value="extensions" /> Disable the Extra Time section for this package</label>
              <div class="package-default-grid">
                {EXTENSION_OPTIONS.map((item) => (
                  <div class="package-default-option">
                    <label class="package-default-option__choice">
                      <input type="checkbox" name="packageDefaultExtensions" value={item.key} />
                      <span><strong>{item.label}</strong><small>&#8369;{item.price.toLocaleString()} per {item.unit === 'block' ? '50-guest block' : 'extra hour'}</small></span>
                    </label>
                    <label class="package-default-option__quantity-wrap">
                      <span>Default quantity</span>
                      <input class="package-default-option__quantity" type="number" name="packageDefaultExtensionQuantity" data-key={item.key} min="1" max="168" step="1" value="1" aria-label={`Default quantity for ${item.label}`} />
                    </label>
                    <label class="package-default-option__lock"><input type="checkbox" name="packageLockedExtensions" value={item.key} /> Require selected</label>
                    <label class="package-default-option__lock"><input type="checkbox" name="packageIncludedExtensions" value={item.key} /> Included in base price</label>
                    <label class="package-default-option__lock package-default-option__lock--danger"><input type="checkbox" name="packageDisabledExtensions" value={item.key} /> Disable choice</label>
                  </div>
                ))}
              </div>
            </div>
          </details>

          <details class="package-default-group" open>
            <summary><span><strong>Outside Equipment Corkage Charges</strong><small>Charges for customer-supplied equipment</small></span><em>{CORKAGE_OPTIONS.length} choices</em></summary>
            <div class="package-default-group__content">
              <label class="package-section-lock"><input type="checkbox" name="packageLockedSections" value="corkage" /> Disable the Corkage section for this package</label>
              <div class="package-default-grid">
                {CORKAGE_OPTIONS.map((item) => (
                  <div class="package-default-option">
                    <label class="package-default-option__choice">
                      <input type="checkbox" name="packageDefaultCorkage" value={item.key} />
                      <span><strong>{item.label}</strong><small>&#8369;{item.price.toLocaleString()}</small></span>
                    </label>
                    <label class="package-default-option__lock"><input type="checkbox" name="packageLockedCorkage" value={item.key} /> Require selected</label>
                    <label class="package-default-option__lock"><input type="checkbox" name="packageIncludedCorkage" value={item.key} /> Included in base price</label>
                    <label class="package-default-option__lock package-default-option__lock--danger"><input type="checkbox" name="packageDisabledCorkage" value={item.key} /> Disable choice</label>
                  </div>
                ))}
              </div>
            </div>
          </details>
        </fieldset>
      </section>

      <section class="package-form-section" aria-labelledby="package-thumbnail-title">
        <div class="package-form-section__heading">
          <span>05</span>
          <div><h4 id="package-thumbnail-title">Thumbnail and image</h4><p>Add the image customers see while browsing packages.</p></div>
        </div>
        <div class="package-upload-field">
          <label for="packageThumbnail"><strong>Choose a package thumbnail</strong><span>JPEG, PNG, WebP, or GIF · up to 5 MB</span></label>
          <input type="file" id="packageThumbnail" accept="image/jpeg,image/png,image/webp,image/gif" />
          <p>When editing, leave this empty to keep the current image.</p>
          <img id="packageThumbnailPreview" class="package-thumbnail-preview hidden" alt="Current package thumbnail" />
        </div>
      </section>

      <p id="packageError" class="package-form-error hidden" role="alert"></p>
      <div class="package-form-end-actions">
        <button type="button" id="packageSubmitEnd" class="package-form-submit" onclick="submitPackage()">SAVE PACKAGE</button>
      </div>
    </div>
    <footer class="package-modal-actions" aria-label="Package status and actions">
      <div class="package-modal-status">
        <span id="packageModalStatus">New package</span>
        <small>Activation is managed from the package card after saving.</small>
      </div>
      <div class="package-modal-actions__buttons">
        <button type="button" class="package-modal-cancel" onclick="closePackageModal()">Cancel</button>
        <button type="button" id="packageSubmit" class="package-modal-save" onclick="submitPackage()">SAVE PACKAGE</button>
      </div>
    </footer>
  </div>
</div>

{isAdmin && (
  <div id="staffModal" class="hidden staff-modal" role="dialog" aria-modal="true" aria-labelledby="staffModalTitle">
    <form id="staffForm" class="staff-modal-card">
      <div class="staff-modal-header">
        <div><p class="staff-eyebrow">Admin only</p><h3 id="staffModalTitle">Add staff account</h3></div>
        <button type="button" aria-label="Close" onclick="closeStaffModal()">×</button>
      </div>
      <input id="staffId" type="hidden" />
      <div class="staff-form-grid">
        <label><span>First name</span><input id="staffFirstName" required maxlength="100" /></label>
        <label><span>Last name</span><input id="staffLastName" required maxlength="100" /></label>
        <label class="full"><span>Email</span><input id="staffEmail" type="email" required /></label>
        <label id="staffPasswordField" class="full"><span>Temporary password</span><input id="staffPassword" type="password" minlength="8" maxlength="128" autocomplete="new-password" required /><small>Share this securely and ask the staff member to change it.</small></label>
