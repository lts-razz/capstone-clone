      <div>
        <div class="mb-3">
          <p class="text-xs font-bold uppercase tracking-widest text-gray-400">Estimate Summary</p>
          <p id="bd-estimate-note" class="mt-1 text-xs text-gray-500"></p>
        </div>
        <div class="booking-detail-estimate-grid text-sm">
          <div><span>Package base</span><strong id="bd-package-price"></strong></div>
          <div><span>Rooms</span><strong id="bd-estimate-rooms"></strong></div>
          <div><span>Add-ons</span><strong id="bd-estimate-addons"></strong></div>
          <div><span>Extensions</span><strong id="bd-estimate-extensions"></strong></div>
          <div><span>Corkage</span><strong id="bd-estimate-corkage"></strong></div>
          <div class="booking-detail-estimate-grid__total"><span id="bd-price-label">Estimated total</span><strong id="bd-price"></strong></div>
          <div><span>Minimum payment</span><strong id="bd-minimum"></strong></div>
          <div><span>Remaining estimate</span><strong id="bd-balance"></strong></div>
