      </div>
    </div>

    <div class="px-7 pb-7 flex justify-end gap-3 flex-wrap">
      <button id="ubd-pay-button" data-email-verified={String(emailVerified)} onclick="payCurrentBooking()" class="hidden px-5 py-2 rounded-xl text-white font-bold text-sm disabled:opacity-60 disabled:cursor-not-allowed" style="background:var(--wb-green);">Pay Now</button>
      <button id="ubd-reschedule-button" onclick="openCurrentRescheduleRequestModal()" class="hidden px-5 py-2 rounded-xl border-2 font-bold text-sm disabled:opacity-60 disabled:cursor-not-allowed" style="border-color:var(--wb-green-pale);color:var(--wb-link);background:var(--wb-green-soft);">Request Reschedule</button>
      <button id="ubd-cancel-button" onclick="openCancelCurrentBooking()" class="hidden px-5 py-2 rounded-xl border-2 font-bold text-sm disabled:opacity-60 disabled:cursor-not-allowed" style="border-color:var(--wb-danger-border);color:var(--wb-danger-text);background:var(--wb-danger-bg);">Cancel Booking</button>
<button onclick="closeUserBookingDetail()" class="px-5 py-2 rounded-xl border-2 font-bold text-sm" style="border-color:var(--wb-border);color:var(--wb-link);">Close</button>
    </div>
  </div>
</div>

