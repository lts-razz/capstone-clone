            <span>Reserved until</span>
            <strong id="ubd-reservation-deadline">—</strong>
          </div>
          <div>
            <span>Time left</span>
            <strong id="ubd-reservation-countdown" data-reservation-countdown></strong>
          </div>
          <p id="ubd-reservation-payment"></p>
        </div>
        <p id="ubd-reservation-message" class="hidden mt-4 rounded-xl px-4 py-3 text-sm font-semibold" style="background:var(--wb-success-bg);color:var(--wb-success-text);border:1px solid var(--wb-success-border);"></p>
        <p id="ubd-pricing-note" class="mt-3 text-sm leading-6 text-gray-500">A minimum 50% down payment is required to secure the reservation. The remaining balance is paid later according to Woodberry's process.</p>
      </div>

      <div>
        <h4 class="text-sm font-black tracking-widest uppercase mb-4" style="color:var(--jet-primary);">Estimate Summary</h4>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
