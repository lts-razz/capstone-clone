          <div><p class="text-xs text-gray-400 font-semibold">Rooms</p><div id="ubd-rooms"></div></div>
          <div><p class="text-xs text-gray-400 font-semibold">Optionals / Add-ons</p><div id="ubd-addons"></div></div>
          <div><p class="text-xs text-gray-400 font-semibold">Extensions</p><div id="ubd-extensions"></div></div>
          <div><p class="text-xs text-gray-400 font-semibold">Corkage</p><div id="ubd-corkage"></div></div>
          <div id="ubd-rough-estimate-wrap" class="hidden md:col-span-2"><p class="text-xs text-gray-400 font-semibold">Rough Additions Estimate</p><p id="ubd-rough-estimate" class="font-bold mt-1" style="color:var(--butterscotch-primary);">—</p></div>
        </div>
      </div>

      <div id="ubd-requests-wrap" class="hidden">
        <h4 class="text-sm font-black tracking-widest uppercase mb-3" style="color:var(--jet-primary);">Special Requests</h4>
        <div class="rounded-xl p-4 bg-gray-50 text-sm text-gray-700" id="ubd-requests"></div>
      </div>

