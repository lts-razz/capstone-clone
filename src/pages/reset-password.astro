---
import Layout from '../layouts/Layout.astro';

export const prerender = false;

// Only the public project URL and anon key are rendered into this page.
// The service role key must remain server-only and is never referenced here.
const supabaseUrl = import.meta.env.SUPABASE_URL;
const supabaseAnonKey = import.meta.env.SUPABASE_ANON_KEY;
---

<Layout title="Reset password">
  <section class="auth-page" aria-labelledby="reset-password-title">
    <div class="auth-shell">
      <div class="auth-brand-panel auth-brand-panel--logo-free auth-brand-panel--reset">
        <div class="auth-brand-copy">
          <p class="auth-brand-eyebrow">A fresh start</p>
          <h2 class="auth-brand-title">Woodberry Resorts and Events Place</h2>
          <p class="auth-brand-subtitle">
            Secure your account, then return to planning your next Woodberry experience.
          </p>
        </div>
      </div>

      <div class="auth-card">
        <header class="auth-card-header">
          <div class="auth-card-topline">
            <p class="auth-card-eyebrow">Account recovery</p>
            <a href="/signin" class="auth-back">Back to sign in</a>
          </div>
          <h1 id="reset-password-title">Reset password</h1>
          <p class="auth-intro">Choose a new password for your Woodberry account.</p>
        </header>

      <div
        id="resetPasswordNotice"
        class="auth-notice auth-notice--pending"
        role="status"
        aria-live="polite"
      >
        Checking your password reset link…
      </div>

      <form
        id="resetPasswordForm"
        class="auth-form"
        data-supabase-url={supabaseUrl}
        data-supabase-anon-key={supabaseAnonKey}
        novalidate
      >
        <fieldset id="resetPasswordFields" class="auth-form" disabled>
          <div class="auth-field">
            <label for="password">New password</label>
            <div class="auth-password-field">
              <input
                id="password"
                name="password"
                type="password"
                autocomplete="new-password"
                minlength="6"
                maxlength="128"
                required
                class="auth-input"
              />
              <button type="button" class="password-toggle" data-password-toggle="password" aria-label="Show new password">
                Show
              </button>
            </div>
            <p class="auth-field-help">Use at least 6 characters.</p>
          </div>

          <div class="auth-field">
            <label for="confirmPassword">Confirm new password</label>
            <div class="auth-password-field">
              <input
                id="confirmPassword"
                name="confirmPassword"
                type="password"
                autocomplete="new-password"
                minlength="6"
                maxlength="128"
                required
                class="auth-input"
              />
              <button type="button" class="password-toggle" data-password-toggle="confirmPassword" aria-label="Show confirmed password">
                Show
              </button>
            </div>
          </div>

          <button
            id="resetPasswordSubmit"
            type="submit"
            class="auth-submit"
          >
            Update password
          </button>
        </fieldset>
      </form>

      <div id="requestNewLink" class="hidden auth-footer">
        <a href="/forgot-password" class="auth-link">Request a new reset link</a>
      </div>
    </div>
    </div>
  </section>
</Layout>

<script>
  import { createClient, type Session } from '@supabase/supabase-js';
  import { resetPasswordSchema } from '../validation/user';

  const form = document.getElementById('resetPasswordForm') as HTMLFormElement | null;
  const fields = document.getElementById('resetPasswordFields') as HTMLFieldSetElement | null;
  const passwordInput = document.getElementById('password') as HTMLInputElement | null;
  const confirmPasswordInput = document.getElementById('confirmPassword') as HTMLInputElement | null;
  const submitButton = document.getElementById('resetPasswordSubmit') as HTMLButtonElement | null;
  const notice = document.getElementById('resetPasswordNotice');
  const requestNewLink = document.getElementById('requestNewLink');
  const RECOVERY_CHECK_TIMEOUT_MS = 12_000;
  const RECOVERY_EVENT_GRACE_MS = 1_500;
  let recoverySessionReady = false;
  let isSubmitting = false;

  function cleanRecoveryUrl() {
    window.history.replaceState({}, document.title, window.location.pathname);
  }

  function showNotice(message: string, type: 'pending' | 'success' | 'error') {
    if (!notice) return;
    notice.textContent = message;
    notice.className = `auth-notice auth-notice--${type}`;
  }

  function showInvalidLink() {
    recoverySessionReady = false;
    if (fields) fields.disabled = true;
    requestNewLink?.classList.remove('hidden');
    showNotice('This password reset link is invalid or has expired. Please request a new one.', 'error');
    cleanRecoveryUrl();
  }

  function enableForm(session: Session) {
    if (!session.access_token || recoverySessionReady) return;
    recoverySessionReady = true;
    if (fields) fields.disabled = false;
    requestNewLink?.classList.add('hidden');
    showNotice('Reset link verified. Enter and confirm your new password.', 'success');

    // Remove recovery credentials from the address bar after Supabase stores the session.
    cleanRecoveryUrl();
    passwordInput?.focus();
  }

  async function waitForSession(
    sessionPromise: Promise<Session>,
    timeoutMs: number,
  ): Promise<Session | null> {
    let timeoutId: number | undefined;
    const timeoutPromise = new Promise<null>((resolve) => {
      timeoutId = window.setTimeout(() => resolve(null), timeoutMs);
    });

    try {
      return await Promise.race([sessionPromise, timeoutPromise]);
    } finally {
      if (timeoutId !== undefined) window.clearTimeout(timeoutId);
    }
  }

  function setSubmitting(submitting: boolean) {
    isSubmitting = submitting;
    if (!submitButton) return;
    submitButton.disabled = submitting;
    submitButton.textContent = submitting ? 'Updating password…' : 'Update password';
  }

  function getUpdateErrorMessage(message: string) {
    const normalized = message.toLowerCase();
    if (normalized.includes('same password') || normalized.includes('different from the old')) {
      return 'Choose a password that is different from your current password.';
    }
    if (
      normalized.includes('password') &&
      (normalized.includes('weak') || normalized.includes('characters') || normalized.includes('strength'))
    ) {
      return `This password does not meet the account requirements. ${message}`;
    }
    if (normalized.includes('session') || normalized.includes('jwt') || normalized.includes('expired')) {
      return 'This password reset link is invalid or has expired. Please request a new one.';
    }
    return 'We could not update your password. Please try again or request a new reset link.';
  }

  document.querySelectorAll<HTMLButtonElement>('[data-password-toggle]').forEach((button) => {
    button.addEventListener('click', () => {
      const inputId = button.dataset.passwordToggle;
      const input = inputId ? document.getElementById(inputId) as HTMLInputElement | null : null;
      if (!input) return;
      const shouldShow = input.type === 'password';
      input.type = shouldShow ? 'text' : 'password';
      button.textContent = shouldShow ? 'Hide' : 'Show';
      button.setAttribute('aria-label', `${shouldShow ? 'Hide' : 'Show'} ${inputId === 'password' ? 'new' : 'confirmed'} password`);
    });
  });

  async function initializeRecoverySession() {
    if (!form) return;

    const hashParams = new URLSearchParams(window.location.hash.replace(/^#/, ''));
    const queryParams = new URLSearchParams(window.location.search);
    const linkError = hashParams.get('error') || queryParams.get('error');
    const linkErrorCode = hashParams.get('error_code') || queryParams.get('error_code');
    if (linkError || linkErrorCode) {
      showInvalidLink();
      return;
    }

    const url = form.dataset.supabaseUrl;
    const anonKey = form.dataset.supabaseAnonKey;
    if (!url || !anonKey) {
      if (fields) fields.disabled = true;
      showNotice('Password recovery is not configured. Please contact support.', 'error');
      return;
    }

    const recoveryCode = queryParams.get('code');
    const recoveryAccessToken = hashParams.get('type') === 'recovery'
      ? hashParams.get('access_token')
      : null;
    const recoveryRefreshToken = hashParams.get('type') === 'recovery'
      ? hashParams.get('refresh_token')
      : null;

    try {
      const supabase = createClient(url, anonKey, {
        auth: {
          autoRefreshToken: true,
          // Code callbacks are exchanged explicitly below. Hash-token callbacks
          // continue to use Supabase's built-in URL session detection.
          detectSessionInUrl: !recoveryCode,
          persistSession: true,
        },
      });

      let resolveRecoveryEvent: (session: Session) => void = () => {};
      const recoveryEventPromise = new Promise<Session>((resolve) => {
        resolveRecoveryEvent = resolve;
      });

      const { data: authListener } = supabase.auth.onAuthStateChange((event, session) => {
        if (event === 'PASSWORD_RECOVERY' && session) resolveRecoveryEvent(session);
      });

      let recoverySession: Session | null = null;

      try {
        if (recoveryCode) {
          const codeExchangePromise = supabase.auth.exchangeCodeForSession(recoveryCode)
            .then(({ data, error }) => {
              if (error || !data.session) throw error ?? new Error('No recovery session returned');
              return data.session;
            });
          recoverySession = await waitForSession(codeExchangePromise, RECOVERY_CHECK_TIMEOUT_MS);
        } else {
          const detectedSessionPromise = supabase.auth.getSession()
            .then(({ data, error }) => {
              if (error) throw error;

              // Never accept an unrelated persisted browser session as proof that
              // this page was opened from a password recovery link.
              if (
                recoveryAccessToken &&
                data.session?.access_token === recoveryAccessToken
              ) {
                return data.session;
              }

              // If URL detection completed without an observable recovery event,
              // validate and establish the hash-token session explicitly.
              if (recoveryAccessToken && recoveryRefreshToken) {
                return supabase.auth.setSession({
                  access_token: recoveryAccessToken,
                  refresh_token: recoveryRefreshToken,
                }).then(({ data: sessionData, error: sessionError }) => {
                  if (sessionError || !sessionData.session) {
                    throw sessionError ?? new Error('No recovery session returned');
                  }
                  return sessionData.session;
                });
              }

              return recoveryEventPromise;
            });
          recoverySession = await waitForSession(
            detectedSessionPromise,
            recoveryAccessToken ? RECOVERY_CHECK_TIMEOUT_MS : RECOVERY_EVENT_GRACE_MS,
          );
        }
      } catch {
        authListener.subscription.unsubscribe();
        void supabase.auth.signOut({ scope: 'local' }).catch(() => {});
        showInvalidLink();
        return;
      }

      if (!recoverySession) {
        authListener.subscription.unsubscribe();
        // If a slow SDK operation establishes a session after the timeout, clear
        // it rather than leaving a recovery session persisted in the browser.
        void supabase.auth.signOut({ scope: 'local' }).catch(() => {});
        showInvalidLink();
        return;
      }

      enableForm(recoverySession);

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (isSubmitting || !recoverySessionReady || !passwordInput || !confirmPasswordInput) return;

        passwordInput.removeAttribute('aria-invalid');
        confirmPasswordInput.removeAttribute('aria-invalid');
        const parsed = resetPasswordSchema.safeParse({
          password: passwordInput.value,
          confirmPassword: confirmPasswordInput.value,
        });

        if (!parsed.success) {
          const issue = parsed.error.issues[0];
          const invalidInput = issue.path[0] === 'confirmPassword' ? confirmPasswordInput : passwordInput;
          invalidInput.setAttribute('aria-invalid', 'true');
          invalidInput.focus();
          showNotice(issue.message, 'error');
          return;
        }

        setSubmitting(true);
        const { error: updateError } = await supabase.auth.updateUser({
          password: parsed.data.password,
        });

        if (updateError) {
          const message = getUpdateErrorMessage(updateError.message);
          if (message.startsWith('This password reset link')) {
            authListener.subscription.unsubscribe();
            showInvalidLink();
          } else {
            showNotice(message, 'error');
          }
          setSubmitting(false);
          return;
        }

        recoverySessionReady = false;
        if (fields) fields.disabled = true;
        showNotice('Password updated. Redirecting you to sign in…', 'success');
        authListener.subscription.unsubscribe();
        await supabase.auth.signOut({ scope: 'local' }).catch(() => {});
        window.location.assign('/signin?message=Your%20password%20has%20been%20updated.%20Please%20sign%20in.');
      });
    } catch {
      showInvalidLink();
    }
  }

  void initializeRecoverySession();
</script>
