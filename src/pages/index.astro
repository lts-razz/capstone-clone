  }

  .photo-carousel-section {
    width: 100vw;
    margin-left: calc(50% - 50vw);
    overflow: hidden;
    border-block: 1px solid var(--wb-border);
    background:
      linear-gradient(180deg, var(--wb-surface-soft) 0%, var(--wb-surface) 100%);
  }

  .photo-carousel-section__heading {
    max-width: 46rem;
    margin-bottom: clamp(1.75rem, 4vw, 2.6rem);
    text-align: center;
  }

  .photo-carousel-section__heading > p:last-child {
    margin: 1rem 0 0;
    color: var(--wb-muted);
    line-height: 1.7;
  }

  .photo-carousel {
    width: 100vw;
    margin-left: calc(50% - 50vw);
    overflow: hidden;
    touch-action: pan-y;
  }

  .photo-carousel__track {
    display: flex;
    width: max-content;
    gap: clamp(0.85rem, 2vw, 1.25rem);
    will-change: transform;
  }

  .photo-carousel.is-dragging,
  .photo-carousel.is-dragging .photo-carousel__card {
    cursor: grabbing;
    user-select: none;
  }

  .photo-carousel__card {
    position: relative;
    flex: 0 0 clamp(17rem, 29vw, 26rem);
    aspect-ratio: 4 / 3;
    margin: 0;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--wb-border) 82%, transparent);
    border-radius: var(--wb-radius-md);
    background: var(--wb-green-soft);
    box-shadow: var(--wb-shadow-sm);
    cursor: zoom-in;
    outline: none;
    transition:
      border-color 0.25s ease,
      box-shadow 0.25s ease,
      transform 0.25s ease;
  }

  .photo-carousel__card::after {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(18, 60, 36, 0.58), rgba(18, 60, 36, 0.28)),
      color-mix(in srgb, var(--wb-green-mid) 30%, var(--wb-warm-soft));
    content: '';
    mix-blend-mode: multiply;
    opacity: 0.68;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  .photo-carousel__card img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.82) sepia(0.08);
    transition:
      filter 0.3s ease,
      transform 0.45s ease;
  }

  .photo-carousel__card figcaption {
    position: absolute;
    z-index: 1;
    right: 0.9rem;
    bottom: 0.85rem;
    left: 0.9rem;
    margin: 0;
    color: #ffffff;
    font-size: 0.78rem;
    font-weight: 900;
    letter-spacing: 0.08em;
    line-height: 1.25;
    text-shadow: 0 2px 10px rgba(6, 12, 5, 0.5);
    text-transform: uppercase;
  }

  .photo-carousel__card:is(:hover, :focus-visible) {
    border-color: rgba(21, 122, 69, 0.42);
    box-shadow: var(--wb-shadow-md);
    transform: translateY(-3px);
  }

  .photo-carousel__card:is(:hover, :focus-visible)::after {
    opacity: 0.08;
  }

  .photo-carousel__card:is(:hover, :focus-visible) img {
    filter: saturate(1) sepia(0);
    transform: scale(1.035);
  }

  .photo-carousel__card:focus-visible {
    box-shadow:
      0 0 0 3px color-mix(in srgb, var(--wb-green) 26%, transparent),
      var(--wb-shadow-md);
  }

  .photo-lightbox {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: none;
    min-height: 100dvh;
    place-items: center;
    background:
      linear-gradient(180deg, rgba(8, 20, 6, 0.86), rgba(8, 20, 6, 0.92)),
