  .photo-lightbox__close svg {
    width: 1.15rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 2.3;
  }

  .photo-lightbox__figure {
    display: grid;
    max-height: inherit;
    margin: 0;
    grid-template-rows: minmax(0, 1fr) auto;
  }

  .photo-lightbox__figure img {
    display: block;
