    max-height: min(72vh, 46rem);
    object-fit: contain;
    background: var(--wb-green-dark);
  }

  .photo-lightbox__caption {
    border-top: 1px solid var(--wb-border);
    background:
      linear-gradient(180deg, rgba(250, 247, 239, 0.96), rgba(244, 241, 232, 0.96)),
      var(--wb-surface);
    padding: clamp(1rem, 3vw, 1.35rem);
