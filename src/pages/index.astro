  .photo-lightbox__panel {
    position: relative;
    width: min(100%, 68rem);
    max-height: calc(100dvh - clamp(2rem, 8vw, 5rem));
    overflow: hidden;
    border: 1px solid rgba(216, 201, 178, 0.48);
