---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import LocationMap from '../components/LocationMap.astro';
import { homepageGalleryPhotos, woodberryPhotos } from '../data/woodberryPhotos';

const features = [
  {
    label: 'Private Resort Venue',
    icon: 'home',
  },
  {
    label: 'Pool Access',
    icon: 'waves',
  },
  {
    label: 'Event Pavilion',
    icon: 'pavilion',
  },
  {
    label: 'Staycation Packages',
    icon: 'bed',
  },
  {
    label: 'Sound System / Videoke',
    icon: 'music',
  },
];

const reasons = [
  {
    title: 'Pool and pavilion access',
    description: 'Enjoy spaces for both relaxing and celebrating in one venue.',
  },
  {
    title: 'A private place for your event',
    description: 'Gather with the people who matter in a more personal setting.',
  },
  {
    title: 'Flexible staycation options',
    description: 'Choose a quick escape with friends or quality time with family.',
  },
  {
    title: 'Parking and security support',
    description: 'Welcome your guests with practical on-site support for the occasion.',
  },
  {
    title: 'Caterer-friendly preparation time',
    description: 'Give your chosen caterer time to prepare the celebration with care.',
  },
  {
    title: 'Made for families and groups',
    description: 'A warm setting for birthdays, reunions, weddings, and shared milestones.',
  },
];

const bookingSteps = [
  {
    number: '01',
    title: 'Choose a package',
    description: 'Find the event or staycation option that suits your plans.',
  },
  {
    number: '02',
    title: 'Create your reservation',
    description: 'Sign in with a verified email, then share your date, package, guests, and contact details.',
  },
  {
    number: '03',
    title: 'Review payment and terms',
    description: 'Check the 50% down payment, 48-hour unpaid reservation hold, and cancellation terms before you submit.',
  },
];

const carouselPhotos = homepageGalleryPhotos;
const carouselTrackPhotos = [...carouselPhotos, ...carouselPhotos];

---

<Layout>
  <div class="home-page">
    <section class="home-hero" aria-labelledby="home-hero-title">
      <div class="home-hero__image" aria-hidden="true">
        <img
          src={woodberryPhotos.homeHero}
          alt=""
          width="905"
          height="1280"
          fetchpriority="high"
          data-photo-fallback={woodberryPhotos.fallback}
        />
      </div>

      <div class="home-hero__shade" aria-hidden="true"></div>

      <div class="home-hero__inner">
        <div class="home-hero__content">
          <h1 id="home-hero-title">
            Celebrate Your Special Moments at Woodberry Resorts and Events Place
          </h1>

          <p class="home-hero__lead">
            A private resort and events venue for gatherings, celebrations,
            staycations, and special occasions.
          </p>

          <div class="home-hero__actions" aria-label="Explore Woodberry">
            <a href="#packages" class="hero-button hero-button--glass">
              View Packages
            </a>
            <a
              href="/events_and_booking/events"
              class="hero-button hero-button--primary"
            >
              Book an Event
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M5 12h14M13 6l6 6-6 6"></path>
              </svg>
            </a>
            <a href="/events_and_booking/events" class="hero-button hero-button--text" data-home-availability>
              Check Availability
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M5 12h14M13 6l6 6-6 6"></path>
              </svg>
            </a>
          </div>
        </div>

        <div class="home-hero__features" aria-label="Venue features">
          <p class="home-hero__features-title">Everything for your gathering</p>
          <ul>
            {
              features.map((feature) => (
                <li>
                  <span class="feature-icon" aria-hidden="true">
                    {feature.icon === 'home' && (
                      <svg viewBox="0 0 24 24">
                        <path d="M3 11.5 12 4l9 7.5"></path>
                        <path d="M5.5 10v10h13V10M9.5 20v-6h5v6"></path>
                      </svg>
                    )}
                    {feature.icon === 'waves' && (
                      <svg viewBox="0 0 24 24">
                        <path d="M2 9c2.5 0 2.5 2 5 2s2.5-2 5-2 2.5 2 5 2 2.5-2 5-2"></path>
                        <path d="M2 15c2.5 0 2.5 2 5 2s2.5-2 5-2 2.5 2 5 2 2.5-2 5-2"></path>
                      </svg>
                    )}
                    {feature.icon === 'pavilion' && (
                      <svg viewBox="0 0 24 24">
                        <path d="M3 10h18M5 10v10M19 10v10M9 10v10M15 10v10"></path>
                        <path d="m2 10 10-6 10 6M3 20h18"></path>
                      </svg>
                    )}
                    {feature.icon === 'bed' && (
                      <svg viewBox="0 0 24 24">
                        <path d="M3 19v-9M21 19v-6a3 3 0 0 0-3-3H9v6h12"></path>
                        <path d="M3 16h18M9 10a3 3 0 1 0-6 0v6"></path>
                      </svg>
                    )}
                    {feature.icon === 'music' && (
                      <svg viewBox="0 0 24 24">
                        <path d="M9 18V5l11-2v13"></path>
                        <ellipse cx="6" cy="18" rx="3" ry="2"></ellipse>
                        <ellipse cx="17" cy="16" rx="3" ry="2"></ellipse>
                      </svg>
                    )}
                  </span>
                  <span>{feature.label}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <a class="home-hero__scroll" href="#packages" aria-label="Explore packages">
        <span>Discover more</span>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="m6 9 6 6 6-6"></path>
        </svg>
      </a>
    </section>

    <section class="photo-carousel-section" aria-labelledby="photo-carousel-title">
      <div class="photo-carousel-section__heading">
        <p class="section-eyebrow">A glimpse of Woodberry</p>
        <h2 id="photo-carousel-title">Picture your celebration here</h2>
        <p>
          Move through poolside evenings, prepared event spaces, and cozy resort
          rooms that help every gathering feel settled in.
        </p>
      </div>

      <div class="photo-carousel" aria-label="Woodberry resort photo carousel">
        <div class="photo-carousel__track">
          {
            carouselTrackPhotos.map((image, index) => (
              <figure
                class="photo-carousel__card"
                tabindex={index < carouselPhotos.length ? '0' : undefined}
                role={index < carouselPhotos.length ? 'button' : undefined}
                aria-label={index < carouselPhotos.length ? `Enlarge ${image.caption}` : undefined}
                aria-hidden={index >= carouselPhotos.length ? 'true' : undefined}
                data-carousel-clone={index >= carouselPhotos.length ? 'true' : undefined}
                data-enlarge-photo
                data-photo-src={image.src}
                data-photo-alt={image.alt}
                data-photo-caption={image.caption}
              >
                <img
                  src={image.src}
                  alt={index < carouselPhotos.length ? image.alt : ''}
                  width="640"
                  height="480"
                  loading="lazy"
                  draggable="false"
                  data-photo-fallback={woodberryPhotos.fallback}
                />
                <figcaption>{image.caption}</figcaption>
              </figure>
            ))
          }
        </div>
      </div>
    </section>

    <section id="packages" class="packages-preview" aria-labelledby="packages-title">
      <div class="packages-preview__cta">
        <p class="section-eyebrow">Woodberry packages</p>
        <h2 id="packages-title">Explore Woodberry Packages</h2>
        <p>
          View available event, pool, staycation, and room packages, then
          choose the option that fits your group.
        </p>

      <div class="packages-preview__actions">
        <a href="/events_and_booking/events" class="packages-link">
          View Packages
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M5 12h14M13 6l6 6-6 6"></path>
          </svg>
        </a>
      </div>
      </div>
    </section>

    <section class="why-section" aria-labelledby="why-title">
      <div class="section-heading section-heading--center">
        <p class="section-eyebrow">Why choose Woodberry</p>
        <h2 id="why-title">One welcoming place, thoughtfully prepared</h2>
        <p>
          Bring everyone together with the resort spaces and practical support
          that help your celebration feel easier.
        </p>
      </div>

      <div class="reasons-grid">
        {
          reasons.map((reason) => (
            <article class="reason-card">
              <span class="reason-card__check" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                  <path d="m6 12 4 4 8-9"></path>
                </svg>
              </span>
              <div>
                <h3>{reason.title}</h3>
                <p>{reason.description}</p>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section class="booking-process" aria-labelledby="booking-process-title">
      <div class="booking-process__inner">
        <div class="booking-process__intro">
          <p class="section-eyebrow">Simple booking process</p>
          <h2 id="booking-process-title">From your plans to a reserved date</h2>
          <p>
            Start with the experience you want, choose your preferred details,
            and complete the required down payment when your payment step opens.
          </p>
          <div class="reservation-note">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="12" cy="12" r="9"></circle>
              <path d="M12 7v5l3 2"></path>
            </svg>
            <p>
              <strong>Please remember:</strong> unpaid reservations are held
              for 48 hours. Pay the minimum 50% down payment within that period
              to secure your reservation.
            </p>
          </div>
        </div>

        <ol class="booking-steps">
          {
            bookingSteps.map((step) => (
              <li>
                <span class="booking-step__number">{step.number}</span>
                <div>
                  <h3>{step.title}</h3>
                  <p>{step.description}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <LocationMap />
  </div>

  <Footer slot="footer" />

  <div id="photoLightbox" class="photo-lightbox" aria-hidden="true">
    <div class="photo-lightbox__panel" role="dialog" aria-modal="true" aria-labelledby="photoLightboxTitle">
      <button id="photoLightboxClose" class="photo-lightbox__close" type="button" aria-label="Close enlarged photo">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="m6 6 12 12M18 6 6 18"></path>
        </svg>
      </button>

      <figure class="photo-lightbox__figure">
        <img id="photoLightboxImage" src="" alt="" />
        <figcaption class="photo-lightbox__caption">
          <p class="section-eyebrow">Woodberry photo</p>
          <h3 id="photoLightboxTitle"></h3>
          <p id="photoLightboxDescription"></p>
        </figcaption>
      </figure>
    </div>
  </div>
</Layout>

<script>
  document.querySelectorAll<HTMLImageElement>('img[data-photo-fallback]').forEach((image) => {
    image.addEventListener('error', () => {
      const fallback = image.dataset.photoFallback;
      if (!fallback) return;
      const fallbackUrl = new URL(fallback, window.location.href).href;
      if (image.src !== fallbackUrl) image.src = fallback;
    });
  });

  document.querySelector<HTMLElement>('[data-home-availability]')?.addEventListener('click', (event) => {
    const availabilityButton = document.getElementById('preview');
    if (!availabilityButton) return;
    event.preventDefault();
    availabilityButton.click();
  });

  const photoLightbox = document.getElementById('photoLightbox');
  const photoLightboxImage = document.getElementById('photoLightboxImage') as HTMLImageElement | null;
  const photoLightboxTitle = document.getElementById('photoLightboxTitle');
  const photoLightboxDescription = document.getElementById('photoLightboxDescription');
  const photoLightboxClose = document.getElementById('photoLightboxClose') as HTMLButtonElement | null;
  let lastFocusedPhotoCard: HTMLElement | null = null;

  const photoCarousel = document.querySelector<HTMLElement>('.photo-carousel');
  const photoCarouselTrack = photoCarousel?.querySelector<HTMLElement>('.photo-carousel__track');
  const firstCarouselCard = photoCarouselTrack?.querySelector<HTMLElement>('.photo-carousel__card');
  const firstCarouselClone = photoCarouselTrack?.querySelector<HTMLElement>('[data-carousel-clone]');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const carouselLoopDuration = 34_000;
  let carouselCycleWidth = 0;
  let carouselPosition = 0;
  let previousFrameTime: number | null = null;
  let pointerInsideCarousel = false;
  let carouselHasFocus = false;
  let draggingCarousel = false;
  let lightboxIsOpen = false;
  let dragStartX = 0;
  let dragStartPosition = 0;
  let dragMoved = false;
  let suppressClickUntil = 0;
  let resumeCarouselAt = 0;

  function normalizeCarouselPosition(position: number) {
    if (!carouselCycleWidth) return position;
    const distance = ((-position % carouselCycleWidth) + carouselCycleWidth) % carouselCycleWidth;
    return -distance;
  }

  function renderCarouselPosition() {
    if (!photoCarouselTrack) return;
    photoCarouselTrack.style.transform = reducedMotion.matches
      ? 'none'
      : `translate3d(${carouselPosition}px, 0, 0)`;
  }

  function measureCarousel() {
    if (!firstCarouselCard || !firstCarouselClone) return;

    const previousCycleWidth = carouselCycleWidth;
    const nextCycleWidth = firstCarouselClone.offsetLeft - firstCarouselCard.offsetLeft;
    if (nextCycleWidth <= 0) return;

    if (previousCycleWidth > 0) {
      const progress = -normalizeCarouselPosition(carouselPosition) / previousCycleWidth;
      carouselPosition = -(progress * nextCycleWidth);
    }

    carouselCycleWidth = nextCycleWidth;
    carouselPosition = normalizeCarouselPosition(carouselPosition);
    renderCarouselPosition();
  }

  function carouselIsPaused(timestamp: number) {
    return reducedMotion.matches
      || document.hidden
      || pointerInsideCarousel
      || carouselHasFocus
      || draggingCarousel
      || lightboxIsOpen
      || timestamp < resumeCarouselAt;
  }

  function animateCarousel(timestamp: number) {
    if (previousFrameTime === null) previousFrameTime = timestamp;
    const elapsed = Math.min(timestamp - previousFrameTime, 100);
    previousFrameTime = timestamp;

    if (!carouselIsPaused(timestamp) && carouselCycleWidth > 0) {
      carouselPosition -= (carouselCycleWidth / carouselLoopDuration) * elapsed;
      carouselPosition = normalizeCarouselPosition(carouselPosition);
      renderCarouselPosition();
    }

    window.requestAnimationFrame(animateCarousel);
  }

  function resumeCarouselAfterInteraction() {
    resumeCarouselAt = performance.now() + 700;
  }

  if (photoCarousel && photoCarouselTrack) {
    measureCarousel();
    new ResizeObserver(measureCarousel).observe(photoCarousel);

    photoCarousel.addEventListener('mouseenter', () => {
      pointerInsideCarousel = true;
    });
    photoCarousel.addEventListener('mouseleave', () => {
      pointerInsideCarousel = false;
      resumeCarouselAfterInteraction();
    });
    photoCarousel.addEventListener('focusin', () => {
      carouselHasFocus = true;
    });
    photoCarousel.addEventListener('focusout', (event) => {
      if (photoCarousel.contains(event.relatedTarget as Node | null)) return;
      carouselHasFocus = false;
      resumeCarouselAfterInteraction();
    });
    photoCarousel.addEventListener('pointerdown', (event) => {
      if (!event.isPrimary || event.button !== 0 || reducedMotion.matches) return;
      draggingCarousel = true;
      dragMoved = false;
      dragStartX = event.clientX;
      dragStartPosition = carouselPosition;
      photoCarousel.setPointerCapture(event.pointerId);
      photoCarousel.classList.add('is-dragging');
    });
    photoCarousel.addEventListener('pointermove', (event) => {
      if (!draggingCarousel || !event.isPrimary) return;
      const distance = event.clientX - dragStartX;
      if (Math.abs(distance) > 5) dragMoved = true;
      if (!dragMoved) return;
      if (event.cancelable) event.preventDefault();
      carouselPosition = normalizeCarouselPosition(dragStartPosition + distance);
      renderCarouselPosition();
    });

    const finishCarouselDrag = (event: PointerEvent) => {
      if (!draggingCarousel || !event.isPrimary) return;
      draggingCarousel = false;
      photoCarousel.classList.remove('is-dragging');
      if (photoCarousel.hasPointerCapture(event.pointerId)) {
        photoCarousel.releasePointerCapture(event.pointerId);
      }
      if (dragMoved) suppressClickUntil = performance.now() + 300;
      resumeCarouselAfterInteraction();
    };

    photoCarousel.addEventListener('pointerup', finishCarouselDrag);
    photoCarousel.addEventListener('pointercancel', finishCarouselDrag);
    photoCarousel.addEventListener('dragstart', (event) => event.preventDefault());
    reducedMotion.addEventListener('change', () => {
      previousFrameTime = null;
      renderCarouselPosition();
    });
    window.requestAnimationFrame(animateCarousel);
  }

  function closePhotoLightbox() {
    if (!photoLightbox) return;
    photoLightbox.classList.remove('is-open');
    photoLightbox.setAttribute('aria-hidden', 'true');
    document.body.classList.remove('photo-lightbox-open');
    lightboxIsOpen = false;
    resumeCarouselAfterInteraction();
    lastFocusedPhotoCard?.focus();
  }

  function openPhotoLightbox(card: HTMLElement) {
    if (!photoLightbox || !photoLightboxImage || !photoLightboxTitle || !photoLightboxDescription) return;

    lastFocusedPhotoCard = card.matches('[tabindex]') ? card : null;
    photoLightboxImage.src = card.dataset.photoSrc ?? '';
    photoLightboxImage.alt = card.dataset.photoAlt ?? '';
    photoLightboxTitle.textContent = card.dataset.photoCaption ?? 'Woodberry photo';
    photoLightboxDescription.textContent = card.dataset.photoAlt ?? '';
    photoLightbox.classList.add('is-open');
    photoLightbox.setAttribute('aria-hidden', 'false');
    document.body.classList.add('photo-lightbox-open');
    lightboxIsOpen = true;
    photoLightboxClose?.focus();
  }

  document.querySelectorAll<HTMLElement>('[data-enlarge-photo]').forEach((card) => {
    card.addEventListener('click', () => {
      if (performance.now() < suppressClickUntil) return;
      openPhotoLightbox(card);
    });
    card.addEventListener('keydown', (event) => {
      if (event.key !== 'Enter' && event.key !== ' ') return;
      event.preventDefault();
      openPhotoLightbox(card);
    });
  });

  photoLightboxClose?.addEventListener('click', closePhotoLightbox);
  photoLightbox?.addEventListener('click', (event) => {
    if (event.target === photoLightbox) closePhotoLightbox();
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && photoLightbox?.classList.contains('is-open')) {
      closePhotoLightbox();
    }
  });
</script>

<style>
  .home-page {
    background: var(--wb-surface);
    color: var(--wb-text);
  }

  .home-hero {
    position: relative;
    display: flex;
    min-height: max(50rem, calc(100svh - 70px));
    align-items: center;
    isolation: isolate;
    overflow: hidden;
    padding: clamp(4.75rem, 8vw, 7rem) clamp(1rem, 6vw, 5.5rem) 5rem;
    color: #ffffff;
  }

  .home-hero__image,
  .home-hero__shade {
    position: absolute;
    inset: 0;
  }

  .home-hero__image {
    z-index: -3;
    background: var(--wb-green-dark);
  }

  .home-hero__image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 58%;
    transform: scale(1.01);
  }

  .home-hero__shade {
    z-index: -2;
    background:
      linear-gradient(
        180deg,
        rgba(8, 20, 6, 0.64) 0%,
        rgba(8, 20, 6, 0.78) 52%,
        rgba(7, 17, 5, 0.9) 100%
      ),
      radial-gradient(circle at center, rgba(27, 55, 20, 0.18), rgba(7, 17, 5, 0.48));
  }

  .home-hero::before {
    position: absolute;
    z-index: -1;
    top: -10rem;
    left: -8rem;
    width: 30rem;
    height: 30rem;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 999px;
    content: '';
  }

  .home-hero::after {
    position: absolute;
    z-index: -1;
    top: 0;
    right: 0;
    left: 0;
    height: clamp(7rem, 16vw, 12rem);
    background:
      linear-gradient(
        180deg,
        rgba(250, 247, 239, 0.34) 0%,
        rgba(238, 229, 215, 0.18) 34%,
        rgba(238, 229, 215, 0) 100%
      );
    content: '';
    pointer-events: none;
  }

  .home-hero__inner {
    display: flex;
    width: min(100%, 76rem);
    align-items: center;
    flex-direction: column;
    gap: clamp(1.75rem, 4vw, 2.75rem);
    margin: 0 auto;
  }

  .home-hero__content {
    display: flex;
    width: 100%;
    max-width: 64rem;
    align-items: center;
    flex-direction: column;
    text-align: center;
  }

  .section-eyebrow {
    margin: 0 0 1rem;
    color: var(--wb-warm);
    font-size: clamp(0.7rem, 1.3vw, 0.8rem);
    font-weight: 800;
    letter-spacing: 0.19em;
    text-transform: uppercase;
  }

  .home-hero h1 {
    max-width: 62rem;
    margin: 0;
    color: #ffffff;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(2.45rem, 5.3vw, 4.85rem);
    font-weight: 700;
    letter-spacing: -0.045em;
    line-height: 1.02;
    text-wrap: balance;
  }

  .home-hero__lead {
    max-width: 44rem;
    margin: clamp(1.25rem, 3vw, 1.75rem) 0 0;
    color: rgba(255, 255, 255, 0.86);
    font-size: clamp(1rem, 1.8vw, 1.18rem);
    line-height: 1.7;
  }

  .home-hero__actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    justify-content: center;
    margin-top: clamp(1.75rem, 4vw, 2.4rem);
    flex-wrap: wrap;
  }

  .hero-button {
    display: inline-flex;
    min-height: 3rem;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    border: 1px solid transparent;
    border-radius: 999px;
    padding: 0.78rem 1.25rem;
    color: #ffffff;
    font-size: 0.84rem;
    font-weight: 800;
    letter-spacing: 0.035em;
    text-decoration: none;
    transition:
      background-color 0.2s ease,
      border-color 0.2s ease,
      transform 0.2s ease;
  }

  .hero-button:hover {
    transform: translateY(-2px);
  }

  .hero-button svg,
  .packages-link svg {
    width: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 2;
  }

  .hero-button--primary {
    background: var(--wb-action);
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.2);
    color: var(--wb-on-action);
  }

  .hero-button--primary:hover {
    background: var(--wb-action-hover);
  }

  .hero-button--glass {
    border-color: rgba(255, 255, 255, 0.48);
    background: rgba(255, 255, 255, 0.12);
    backdrop-filter: blur(12px);
  }

  .hero-button--glass:hover {
    background: rgba(255, 255, 255, 0.2);
    border-color: rgba(255, 255, 255, 0.72);
  }

  .hero-button--text {
    padding-inline: 0.65rem;
  }

  .hero-button--text:hover {
    color: var(--wb-warm);
  }

  .home-hero__features {
    width: min(100%, 68rem);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: var(--wb-radius-lg);
    background: rgba(12, 27, 9, 0.6);
    box-shadow: 0 18px 45px rgba(0, 0, 0, 0.2);
    padding: 1.4rem;
    backdrop-filter: blur(14px);
  }

  .home-hero__features-title {
    margin: 0 0 0.85rem;
    color: rgba(255, 255, 255, 0.6);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    text-align: center;
  }

  .home-hero__features ul {
    display: flex;
    justify-content: center;
    gap: 0;
    margin: 0;
    padding: 0;
    flex-wrap: wrap;
    list-style: none;
  }

  .home-hero__features li {
    display: flex;
